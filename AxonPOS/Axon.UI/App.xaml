<Application x:Class="Axon.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Axon.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" BaseTheme="Dark" PrimaryColor="Red" SecondaryColor="Red" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                
                <!-- Localization Resources -->
                <ResourceDictionary Source="Resources/Locales/StringResources.ar.xaml" />

                <!-- Axon POS Premium 3D Design System -->
                <ResourceDictionary Source="Resources/Styles/AxonColors.xaml" />
                <ResourceDictionary Source="Resources/Styles/AxonShadows.xaml" />
                <ResourceDictionary Source="Resources/Styles/Axon3DStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AxonSharedViewStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AnimationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

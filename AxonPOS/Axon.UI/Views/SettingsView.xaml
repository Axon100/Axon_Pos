<UserControl x:Class="Axon.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AxonBackgroundBrush}" Foreground="White"
             FontFamily="{DynamicResource AppFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- Main Container -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource SettingsDesc}" FontSize="14" Foreground="{DynamicResource AxonSecondaryTextBrush}" />
                </StackPanel>

                <!-- Tabbed Interface -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="{DynamicResource AxonPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,0,4,12" Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource StoreProfileTab}" Foreground="{DynamicResource AxonPrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                        </Border>
                        <TextBlock Text="{DynamicResource PaymentGatewaysTab}" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,24,0" Cursor="Hand" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaxRulesTab}" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,24,0" Cursor="Hand" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource IntegrationSettingsTab}" Foreground="{DynamicResource AxonSecondaryTextBrush}" Cursor="Hand" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Form Layout Grid -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Main Form Column -->
                    <StackPanel Grid.Column="0">
                        <!-- General Information Card -->
                        <Border Style="{StaticResource Axon3DCardStyle}" Margin="0,0,0,24">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Storefront" Width="22" Height="22" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource GeneralInformationLabel}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Legal Store Name -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="{DynamicResource LegalStoreNameLabel}" FontSize="13" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <TextBox Text="{Binding LegalStoreName}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Display Name -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="{DynamicResource DisplayNameLabel}" FontSize="13" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <TextBox Text="{Binding DisplayName}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Registration Number -->
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="{DynamicResource RegistrationNumberLabel}" FontSize="13" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <TextBox Text="{Binding RegistrationNumber}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Contact & Location Card -->
                        <Border Style="{StaticResource Axon3DCardStyle}" Margin="0,0,0,24">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MapMarkerOutline" Width="22" Height="22" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource LocationContactLabel}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Phone Number -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="{DynamicResource PhoneLabel}" FontSize="13" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <TextBox Text="{Binding Phone}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Email Address -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="{DynamicResource EmailLabel}" FontSize="13" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <TextBox Text="{Binding Email}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Address -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="{DynamicResource AddressLabel}" FontSize="13" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <TextBox Text="{Binding Address}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Users & Roles Management Card -->
                        <Border Style="{StaticResource Axon3DCardStyle}" Margin="0,0,0,24">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource UsersAndRolesLabel}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding OpenAddUserDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Padding="16,8" Height="40">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                                <TextBlock Text="{DynamicResource AddUserLabel}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Enhanced Users DataGrid -->
                                <Border Background="#141414" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                              Background="#141414" RowBackground="#1A1A1A" AlternatingRowBackground="#141414"
                                              Foreground="White" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="46">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#222222"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AxonBorderBrush}"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="1.5*"/>
                                            <DataGridTemplateColumn Header="الدور / الصلاحية" Width="1.5*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#2A1015" BorderBrush="#D90429" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RoleName}" Foreground="#FF4D6D" FontWeight="Bold" FontSize="12"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="الحالة" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#1C3829" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="8,4" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="نشط" Foreground="#22C55E" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Unified Dynamic Granular RBAC Permission Manager Card -->
                        <Border Style="{StaticResource Axon3DCardStyle}" Margin="0,0,0,24">
                            <StackPanel>
                                <!-- Card Header -->
                                <Border BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ShieldAccount" Width="24" Height="24" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="إدارة وديناميكية الصلاحيات الفردية (Granular RBAC Manager)" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Command="{Binding SelectAllPermissionsCommand}" Content="تحديد الكل" Style="{StaticResource Axon3DSecondaryButtonStyle}" Padding="12,4" FontSize="11" Margin="0,0,8,0" Height="34"/>
                                            <Button Command="{Binding DeselectAllPermissionsCommand}" Content="إلغاء الكل" Style="{StaticResource Axon3DSecondaryButtonStyle}" Padding="12,4" FontSize="11" Height="34"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Combined & Organized Target Selection Control -->
                                <Border Background="#141414" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: Mode Switcher (Role vs User) -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="تخصيص الصلاحيات حسب:" Foreground="#B3B3B3" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            
                                            <RadioButton Content="👤 الرتبة / الدور (Role)" 
                                                         IsChecked="{Binding IsManagingRolePermissions, Mode=TwoWay}" 
                                                         Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                                         Background="#222222" Foreground="White" FontSize="13" Margin="0,0,12,0"/>
                                            
                                            <RadioButton Content="👨‍💻 مستخدم معين (User Override)" 
                                                         IsChecked="{Binding IsManagingRolePermissions, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, ConverterParameter=Inverse}" 
                                                         Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                                         Background="#222222" Foreground="White" FontSize="13"/>
                                        </StackPanel>

                                        <!-- Row 2: Single Dynamic Dropdown for Selected Target -->
                                        <Grid Grid.Row="2">
                                            <!-- Role Selector (Visible when IsManagingRolePermissions == True) -->
                                            <StackPanel Visibility="{Binding IsManagingRolePermissions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="اختر الدور / الرتبة للتعديل على صلاحياتها:" Foreground="#B3B3B3" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Command="{Binding OpenAddRoleDialogCommand}" Background="#2B0005" BorderBrush="#D90429" BorderThickness="1" Height="28" Padding="10,0" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="PlusCircle" Width="14" Height="14" Foreground="#D90429" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="إضافة دور / رتبة جديدة" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                                <Border Background="#1E1E1E" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,2" Height="44">
                                                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRoleForPermissions, Mode=TwoWay}" 
                                                              Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Background" Value="#1E1E1E"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="Padding" Value="10,8"/>
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="AccountKey" Foreground="#D90429" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Border>
                                            </StackPanel>

                                            <!-- User Selector (Visible when IsManagingRolePermissions == False) -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsManagingRolePermissions}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="اختر المستخدم المخصص لتحديد استثناءاته:" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6"/>
                                                <Border Background="#1E1E1E" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,2" Height="44">
                                                    <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUserForPermissions}" 
                                                              Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Account" Foreground="#22C55E" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Username}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding RoleName, StringFormat=' ({0})'}" Foreground="#B3B3B3" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Hierarchical Permissions Matrix -->
                                <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" MaxHeight="450">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding PermissionModuleGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A1A1A" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                <materialDesign:PackIcon Kind="FolderKey" Foreground="{DynamicResource AxonPrimaryBrush}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ModuleName}" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Separator Background="{DynamicResource AxonBorderBrush}" Margin="0,0,0,12"/>

                                                            <ItemsControl ItemsSource="{Binding Permissions}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!-- Interactive Permission Pill Card -->
                                                                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,10,10" Width="240" BorderThickness="1">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#222222"/>
                                                                                    <Setter Property="BorderBrush" Value="#2C2C2C"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsGranted}" Value="True">
                                                                                            <Setter Property="Background" Value="#2A1015"/>
                                                                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsGranted, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#B3B3B3" Margin="0,2,0,0"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Save Permissions Action Bar -->
                                <Grid Margin="0,16,0,0">
                                    <Button Command="{Binding SaveRbacPermissionsCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Padding="24,10" Height="44">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ShieldCheck" Margin="0,0,8,0" VerticalAlignment="Center" Width="20" Height="20"/>
                                            <TextBlock Text="حفظ وتطبيق الصلاحيات الفوري" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Visibility="{Binding IsRbacStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="8" Padding="12" Margin="0,12,0,0" Background="#22104ae1" BorderBrush="#4d104ae1" BorderThickness="1">
                                    <TextBlock Text="{Binding RbacStatusMessage}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Local SQLite Database Configuration Card -->
                        <Border Style="{StaticResource Axon3DCardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseCheck" Width="22" Height="22" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="قاعدة البيانات والتخزين المحلي (SQLite Engine)" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <Border Background="#1b2a1e" BorderBrush="#22c55e" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="#22c55e" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="متصل ومحفوظ محلياً" Foreground="#22c55e" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Engine Info -->
                                    <Border Grid.Column="0" Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="محيط المحرك (Database Engine)" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="SQLite 3 (Embeddable High-Performance)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DB Location -->
                                    <Border Grid.Column="1" Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="ملف التخزين المحلي (Local Storage File)" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="AxonPOS.db (محفوظ ومُفرس تلقائياً)" Foreground="#22c55e" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Command="{Binding CreateAndMigrateDbCommand}" Content="إعادة مزامنة وهيكلة الجداول" Style="{StaticResource Axon3DPrimaryButtonStyle}" Padding="16,6" Height="38"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Change Password Card -->
                        <Border Style="{StaticResource Axon3DCardStyle}" Margin="0,24,0,0">
                            <StackPanel>
                                <!-- Card Header -->
                                <Border BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LockReset" Width="22" Height="22" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="تغيير كلمة المرور" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <Border Background="#2b0005" BorderBrush="#d90429" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="حسابك الحالي" Foreground="#d90429" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Form Fields -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Old Password -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="كلمة المرور الحالية" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <PasswordBox x:Name="PbOldPassword" BorderThickness="0" Background="Transparent"
                                                         Foreground="White" FontSize="14" VerticalAlignment="Center"
                                                         materialDesign:HintAssist.Hint="أدخل كلمة المرور الحالية"
                                                         PasswordChanged="OldPassword_PasswordChanged"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- New Password -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="كلمة المرور الجديدة" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44">
                                            <PasswordBox x:Name="PbNewPassword" BorderThickness="0" Background="Transparent"
                                                         Foreground="White" FontSize="14" VerticalAlignment="Center"
                                                         materialDesign:HintAssist.Hint="أدخل كلمة المرور الجديدة"
                                                         PasswordChanged="NewPassword_PasswordChanged"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Confirm Password -->
                                <TextBlock Text="تأكيد كلمة المرور الجديدة" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44" Margin="0,0,0,20">
                                    <PasswordBox x:Name="PbConfirmPassword" BorderThickness="0" Background="Transparent"
                                                 Foreground="White" FontSize="14" VerticalAlignment="Center"
                                                 materialDesign:HintAssist.Hint="أعد إدخال كلمة المرور الجديدة"
                                                 PasswordChanged="ConfirmPassword_PasswordChanged"/>
                                </Border>

                                <!-- Status Message -->
                                <Border Visibility="{Binding IsChangePasswordMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#22104ae1"/>
                                            <Setter Property="BorderBrush" Value="#4d104ae1"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChangePasswordSuccess}" Value="True">
                                                    <Setter Property="Background" Value="#1a22C55E"/>
                                                    <Setter Property="BorderBrush" Value="#22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChangePasswordSuccess}" Value="False">
                                                    <Setter Property="Background" Value="#1ad90429"/>
                                                    <Setter Property="BorderBrush" Value="#d90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="AlertCircle"/>
                                                    <Setter Property="Foreground" Value="#d90429"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChangePasswordSuccess}" Value="True">
                                                            <Setter Property="Kind" Value="CheckCircle"/>
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding ChangePasswordMessage}" Foreground="White" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Action Button -->
                                <Button Command="{Binding ChangePasswordCommand}"
                                        Style="{StaticResource Axon3DPrimaryButtonStyle}"
                                        HorizontalAlignment="Right" Padding="24,10" Height="44">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LockReset" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="تغيير كلمة المرور" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Sticky Action Bar (Bottom) -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16" Effect="{DynamicResource Axon3DCardShadow}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource DiscardChangesLabel}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Margin="0,0,16,0" Padding="24,8" Height="42"/>
                <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Padding="24,8" Height="42">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SaveChangesLabel}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Modal Overlay for Add New User -->
        <Grid Visibility="{Binding IsAddUserDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#90000000" Grid.RowSpan="2" Panel.ZIndex="1000">
            <Border Style="{StaticResource Axon3DCardStyle}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Effect="{DynamicResource Axon3DDialogShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="إضافة مستخدم جديد وتحديد الصلاحية" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <Button Command="{Binding CloseAddUserDialogCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource AxonSecondaryTextBrush}" Padding="0" Height="28" Width="28" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="اسم المستخدم (Username)" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44" Margin="0,0,0,16">
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="كلمة المرور (Password)" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44" Margin="0,0,0,16">
                        <TextBox Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="حدد الدور / الصلاحية (Role)" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,0,0,24">
                        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRole}" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" Height="38"/>
                    </Border>

                    <Grid>
                        <Button Command="{Binding CloseAddUserDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="110" Height="40"/>
                        <Button Command="{Binding SaveUserCommand}" Content="حفظ المستخدم" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="140" Height="40"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal Overlay for Add New Role -->
        <Grid Visibility="{Binding IsAddRoleDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#90000000" Grid.RowSpan="2" Panel.ZIndex="1001">
            <Border Style="{StaticResource Axon3DCardStyle}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Effect="{DynamicResource Axon3DDialogShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="إضافة مسمى وظيفي / دور جديد" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <Button Command="{Binding CloseAddRoleDialogCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource AxonSecondaryTextBrush}" Padding="0" Height="28" Width="28" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="اسم الرتبة أو المسمى الوظيفي (مثال: كاشير مسائي، مشرف صالة، محاسب)" Foreground="{DynamicResource AxonSecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#111111" BorderBrush="{DynamicResource AxonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="44" Margin="0,0,0,24">
                        <TextBox Text="{Binding NewCustomRoleName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </Border>

                    <Grid>
                        <Button Command="{Binding CloseAddRoleDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="110" Height="40"/>
                        <Button Command="{Binding SaveNewRoleCommand}" Content="إنشاء الدور" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="140" Height="40"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

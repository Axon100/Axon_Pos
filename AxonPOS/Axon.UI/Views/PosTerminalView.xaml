<UserControl x:Class="Axon.UI.Views.PosTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#111111" Foreground="White"
             FontFamily="Segoe UI">

    <!-- ScrollBar Style for the items controls -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Product Item Template -->
        <DataTemplate x:Key="ProductCardTemplate">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Margin="8" Padding="12" Cursor="Hand" Effect="{StaticResource Axon3DCardShadow}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#222222" />
                                <Setter Property="BorderBrush" Value="#383838" />
                                <Setter Property="Effect" Value="{StaticResource Axon3DCardHoverShadow}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Out of stock overlay logic could go here -->
                    
                    <Border Grid.Row="0" Background="#111111" CornerRadius="8" Height="140" Margin="0,0,0,12" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <materialDesign:PackIcon Kind="ImageOutline" Width="48" Height="48" Foreground="#353534" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>

                            <!-- In Stock Badge (Green) when Stock > 0 -->
                            <Border Background="#104ae176" BorderBrush="#4d4ae176" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StockDisplay}" Foreground="#4ae176" FontSize="10" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Out of Stock Badge (Red) ONLY when IsOutOfStock is True (Stock <= 0) -->
                            <Border Background="#B3690005" BorderBrush="#ffb4ab" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,4" CornerRadius="6" Visibility="{Binding IsOutOfStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource OutOfStock}" Foreground="#ffb4ab" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                    
                    <Grid Grid.Row="3">
                        <TextBlock Text="{Binding Price, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#2b0005" Foreground="#d90429" HorizontalAlignment="Right" Padding="8,4" Height="32">
                            <materialDesign:PackIcon Kind="CartPlus" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- Cart Item Template -->
        <DataTemplate x:Key="CartItemTemplate">
            <Border Background="#111111" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="16,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#b4b5b5" Padding="4" Height="24">
                            <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                        </Button>
                        <TextBlock Text="{Binding Quantity}" Foreground="White" FontSize="14" Margin="8,0" VerticalAlignment="Center"/>
                        <Button Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#b4b5b5" Padding="4" Height="24">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="14" Foreground="White" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Products & Category Browser -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Search & Barcode Scan Bar -->
            <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16" Effect="{DynamicResource Axon3DCardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="BarcodeScan" Width="22" Height="22" Foreground="#d90429" 
                                             VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="امسح الباركود أو اكتب اسم / كود المنتج للبحث المباشر..."
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             Background="Transparent" Foreground="White" BorderThickness="0"
                             CaretBrush="White" Padding="8,12" FontSize="13">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ProcessBarcodeInputCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Command="{Binding ProcessBarcodeInputCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Background="#2b0005" Foreground="#d90429" Margin="8,4" Padding="12,4" Height="36"
                            ToolTip="إضافة للسلة">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartPlus" Width="20" Height="20" Margin="0,0,6,0"/>
                            <TextBlock Text="إضافة" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area: Split into Categories Side Panel and Products Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1) Categories Side Panel (لوحة الأقسام الجانبية) -->
                <Border Grid.Column="0" Background="#161616" BorderBrush="#282828" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0" Padding="10" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <!-- Vertical Categories List -->
                        <ListBox ItemsSource="{Binding CategoryList}"
                                 SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="CatBorder"
                                                        Background="#1A1A1A"
                                                        BorderBrush="#2C2C2C"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10"
                                                        Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon x:Name="CatIcon" Grid.Column="0" Kind="{Binding IconKind}" Width="18" Height="18" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock x:Name="CatText" Grid.Column="1" Text="{Binding Name}" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Border x:Name="CountBadge" Grid.Column="2" Background="#242424" CornerRadius="8" Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock x:Name="CountText" Text="{Binding ProductCount}" FontSize="11" FontWeight="Bold" Foreground="#8E8E93"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="#2b0005"/>
                                                        <Setter TargetName="CatBorder" Property="BorderBrush" Value="#d90429"/>
                                                        <Setter TargetName="CatIcon" Property="Foreground" Value="#d90429"/>
                                                        <Setter TargetName="CatText" Property="Foreground" Value="#ffb3af"/>
                                                        <Setter TargetName="CatText" Property="FontWeight" Value="Bold"/>
                                                        <Setter TargetName="CountBadge" Property="Background" Value="#4d000a"/>
                                                        <Setter TargetName="CountText" Property="Foreground" Value="#ff897d"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="#222222"/>
                                                        <Setter TargetName="CatText" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="CatIcon" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 2) Products Grid Area -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Grid Grid.Row="0" Margin="4,0,4,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCategoryItem.Name, FallbackValue='جميع الأصناف'}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="#242424" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Products.Count, StringFormat='{}{0} صنف'}" FontSize="11" FontWeight="SemiBold" Foreground="#b4b5b5"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Products Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="productsControl" ItemsSource="{Binding Products}" ItemTemplate="{StaticResource ProductCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,48">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=productsControl}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="64" Height="64" Foreground="#353534" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="لا توجد منتجات في هذا القسم" Foreground="#b4b5b5" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Right Pane: Cart & Checkout -->
        <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Customer Header -->
                <Border Grid.Row="0" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#353534" BorderBrush="#2C2C2C" BorderThickness="1" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="PersonAdd" Foreground="#b4b5b5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource WalkInCustomer}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="{DynamicResource AssignProfile}" FontSize="12" Foreground="#d90429" Cursor="Hand"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- Return / Refund Button -->
                            <Button Command="{Binding OpenReturnDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#d90429" Foreground="#ffb3af" Background="#1a2b0005" Padding="10,4" Height="34" Margin="0,0,8,0" ToolTip="طلب مرتجع / استرجاع مبيعات">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashRefund" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#d90429"/>
                                    <TextBlock Text="مرتجع" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" Padding="8" Margin="0,0,8,0" ToolTip="تعليق الطلب">
                                <materialDesign:PackIcon Kind="Pause" />
                            </Button>
                            <Button Command="{Binding ClearCartCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" Padding="8" ToolTip="مسح السلة">
                                <materialDesign:PackIcon Kind="DeleteSweep" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cart Items List -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header -->
                    <Grid Grid.Row="0" Background="#1A1A1A" Margin="16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource HeaderItem}" FontSize="11" Foreground="#b4b5b5" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource HeaderQty}" FontSize="11" Foreground="#b4b5b5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource HeaderPrice}" FontSize="11" Foreground="#b4b5b5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="cartControl" ItemsSource="{Binding Cart}" ItemTemplate="{StaticResource CartItemTemplate}"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,32">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=cartControl}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="CartOutline" Width="48" Height="48" Foreground="#353534" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="عربة التسوق فارغة" Foreground="#b4b5b5" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Order Summary & Pay -->
                <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" Padding="24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Button Command="{Binding OpenDiscountDialogCommand}" Content="{DynamicResource BtnDiscount}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" Height="38"/>
                        </Grid>

                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Subtotal}" Foreground="#b4b5b5"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:#,##0.##} ج.م'}" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8" Visibility="{Binding IsTaxVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource TaxLabel}" Foreground="#b4b5b5"/>
                                <TextBlock Text="{Binding Tax, StringFormat='{}{0:#,##0.##} ج.م'}" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="{DynamicResource BtnDiscount}" Foreground="#d90429"/>
                                <TextBlock Text="{Binding Discount, StringFormat='-{0:#,##0.##} ج.م'}" Foreground="#d90429" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="{DynamicResource Total}" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding Total, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        </Grid>

                        <Button Command="{Binding CheckoutCommand}" Background="#d90429" Foreground="White" BorderThickness="0" Height="64" FontSize="20" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource PayNow}" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon Kind="ArrowRight" Width="24" Height="24" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <ScaleTransform ScaleX="{DynamicResource DirectionalIconScale}" />
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Discount Modal Overlay -->
        <Grid Visibility="{Binding IsDiscountDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#80000000" Grid.ColumnSpan="2" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="تطبيق خصم على الفاتورة" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <Button Command="{Binding CloseDiscountDialogCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#b4b5b5" Padding="4" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="قيمة الخصم (بالجنيه / ج.م) *" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DiscountInput, Converter={StaticResource ZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="12,8" Margin="0,0,0,4" FontSize="16" FontWeight="Bold"/>

                    <!-- Red Validation Error Text -->
                    <TextBlock Text="{Binding DiscountValidationError}" Foreground="#EF4444" FontSize="12" FontWeight="Bold" Margin="0,4,0,16" Visibility="{Binding HasDiscountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Grid Margin="0,12,0,0">
                        <Button Command="{Binding CloseDiscountDialogCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" HorizontalAlignment="Left" Width="100"/>
                        <Button Command="{Binding ApplyDiscountCommand}" Content="تطبيق الخصم" Background="#d90429" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" Width="130"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Printable Thermal Receipt Invoice Overlay (1:1 Match with Physical Ticket) -->
        <Grid Visibility="{Binding IsReceiptDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#90000000" Grid.ColumnSpan="2" Panel.ZIndex="2000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
                <!-- Thermal Paper Ticket Card -->
                <Border Background="White" CornerRadius="8" Width="340" Padding="16" SnapsToDevicePixels="True" Effect="{StaticResource Axon3DDialogShadow}">
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel TextElement.Foreground="Black">
                            <!-- 1. CIRCULAR LOGO BRANDING (VELOURA + BUTTERFLY + CONTACTS) -->
                            <Border Width="160" Height="160" CornerRadius="80" BorderBrush="Black" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,8" Padding="8">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="VELOURA" FontSize="18" FontWeight="Bold" FontFamily="Georgia, Times New Roman, Segoe UI" Foreground="Black" VerticalAlignment="Center"/>
                                        <!-- Butterfly Vector Path 🦋 -->
                                        <Path Data="M 12,2 C 10,2 8,4 8,7 C 6,4 4,4 2,6 C 0,8 1,12 4,13 C 1,15 0,18 2,20 C 4,22 8,20 10,17 C 10,19 11,21 12,21 C 13,21 14,19 14,17 C 16,20 20,22 22,20 C 24,18 23,15 20,13 C 23,12 24,8 22,6 C 20,4 18,4 16,7 C 16,4 14,2 12,2 Z"
                                              Fill="Black" Width="18" Height="18" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="📞 01509922025   💬 01509922025" FontSize="9" Foreground="Black" HorizontalAlignment="Center" Margin="0,2"/>
                                    <TextBlock Text="🎵 Veloura.clothing" FontSize="9" Foreground="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Address below circle -->
                            <TextBlock Text="العاشر من رمضان - مجاورة الخامسة" FontSize="11" FontWeight="Bold" Foreground="Black" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="مول أبو الوفا، البدروم" FontSize="11" FontWeight="Bold" Foreground="Black" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,8"/>

                            <!-- Dotted Divider 1 -->
                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 2. BON NR BLOCK -->
                            <Grid Margin="0,4">
                                <TextBlock Text="Bon Nr:" FontSize="18" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ReceiptSaleId}" FontSize="26" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Dotted Divider 2 -->
                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 3. RECEIPT METADATA BLOCK -->
                            <Grid Margin="0,2"><TextBlock Text="Receipt:" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptSaleId}" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Date:" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptDate, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Terminal:" FontSize="11" Foreground="Black"/><TextBlock Text="Cash-PC" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Served by:" FontSize="11" Foreground="Black"/><TextBlock Text="Manager" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>

                            <!-- Dotted Divider 3 -->
                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 4. ITEMS TABLE -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Item" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Grid.Column="1" Text="Price" FontWeight="Bold" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Qty" FontWeight="Bold" FontSize="11" Foreground="Black" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Value" FontWeight="Bold" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <ItemsControl ItemsSource="{Binding ReceiptItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="35"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="Black" FlowDirection="RightToLeft" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="11" Foreground="Black" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Dotted Divider 4 -->
                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 5. TOTALS & SUMMARY BLOCK -->
                            <TextBlock Text="{Binding ReceiptItems.Count, StringFormat='Items count: {0}'}" FontSize="11" Foreground="Black" Margin="0,4,0,6"/>

                            <Grid Margin="0,4,0,8">
                                <TextBlock Text="Total" FontSize="16" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text="{Binding ReceiptTotal, StringFormat='{}{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,2"><TextBlock Text="Cash" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Tendered:" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Change:" FontSize="11" Foreground="Black"/><TextBlock Text="0.00" FontSize="11" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Footer Control Buttons Bar -->
                <Grid Margin="0,16,0,0" Width="340">
                    <Button Command="{Binding CloseReceiptDialogCommand}" Content="إغلاق" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="40"/>
                    <Button Command="{Binding PrintCurrentReceiptCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Padding="16,8" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="طباعة الفاتورة" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ==================== RETURN / REFUND MODAL DIALOG ==================== -->
        <Grid Grid.ColumnSpan="2" Background="#B3000000" Visibility="{Binding IsReturnDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="920" MaxHeight="660" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource Axon3DDialogShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- 2-Column Body: Invoices List & Details -->
                    </Grid.RowDefinitions>

                    <!-- 1. Modal Top Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRefund" Width="26" Height="26" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="إرجاع مبيعات / استرجاع فاتورة" FontSize="19" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="ابحث برقم الفاتورة، أو اسم المنتج، أو الباركود، أو اختر مباشرة من قائمة الفواتير المسجلة." FontSize="12" Foreground="#8E8E93" Margin="36,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseReturnDialogCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#8E8E93" Padding="4" Height="32" Width="32">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- 2. Two-Column Layout -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Right Column: Vertical Invoices List (تحت بعض) -->
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="16"/>
                            <!-- Left Column: Search & Selected Invoice Details -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RIGHT COLUMN: Vertical Invoices List -->
                        <Border Grid.Column="0" Background="#111111" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title of Invoices List -->
                                <Grid Grid.Row="0" Margin="4,0,4,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="18" Height="18" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="سجل الفواتير" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#242424" CornerRadius="8" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding RecentSalesForReturn.Count, StringFormat='{}{0} فاتورة'}" FontSize="11" FontWeight="Bold" Foreground="#8E8E93"/>
                                    </Border>
                                </Grid>

                                <!-- Vertical ListBox of Invoices -->
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding RecentSalesForReturn}"
                                         SelectedItem="{Binding SelectedRecentSaleItem, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SaleCardBorder"
                                                                Background="#181818"
                                                                BorderBrush="#2A2A2A"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="12,10"
                                                                Cursor="Hand">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding ReceiptNumber}" Foreground="White" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                    <Border Background="#104ae176" BorderBrush="#4d4ae176" BorderThickness="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding Status}" Foreground="#4ae176" FontSize="10" FontWeight="Bold"/>
                                                                    </Border>
                                                                </Grid>
                                                                <Grid Grid.Row="1">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="ClockOutline" Width="12" Height="12" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:MM/dd HH:mm}'}" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} ج.م'}" Foreground="#ffb3af" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SaleCardBorder" Property="Background" Value="#2b0005"/>
                                                                <Setter TargetName="SaleCardBorder" Property="BorderBrush" Value="#d90429"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SaleCardBorder" Property="Background" Value="#242424"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- LEFT COLUMN: Search & Selected Invoice Details -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Search bar -->
                                <RowDefinition Height="*"/>    <!-- Found Items Table -->
                                <RowDefinition Height="Auto"/> <!-- Reason, Totals & Action Buttons -->
                            </Grid.RowDefinitions>

                            <!-- Search Bar with Multi-criteria Hint -->
                            <Border Grid.Row="0" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="BarcodeScan" Width="20" Height="20" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ReturnInvoiceSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="White" BorderThickness="0"
                                             VerticalAlignment="Center" FontSize="12"
                                             materialDesign:HintAssist.Hint="ابحث بـ: رقم الفاتورة / اسم المنتج / كود SKU / الباركود / المبلغ...">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SearchSaleForReturnCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="2" Command="{Binding SearchSaleForReturnCommand}" Background="#d90429" Foreground="White" BorderThickness="0" Padding="12,4" Height="30">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Magnify" Margin="0,0,4,0" VerticalAlignment="Center" Width="14" Height="14"/>
                                            <TextBlock Text="بحث" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Items Table Area -->
                            <Border Grid.Row="1" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <!-- When Sale is Selected -->
                                    <Grid Visibility="{Binding IsSaleFoundForReturn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Invoice Summary Ribbon -->
                                        <Border Grid.Row="0" Background="#181818" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="الفاتورة: " Foreground="#8E8E93" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedSaleForReturn.ReceiptNumber}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,14,0"/>
                                                    <TextBlock Text="التاريخ: " Foreground="#8E8E93" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedSaleForReturn.Date, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Foreground="White" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="القيمة الأصلية: " Foreground="#8E8E93" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedSaleForReturn.Total, StringFormat='{}{0:N2} ج.م'}" Foreground="#ffb3af" FontWeight="Bold" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Line Items List -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ReturnLineItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#161616" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                    <ColumnDefinition Width="1.8*"/>
                                                                    <ColumnDefinition Width="1.2*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Product Name & SKU -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProductName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                                    <TextBlock Text="{Binding Sku}" Foreground="#8E8E93" FontSize="10"/>
                                                                </StackPanel>

                                                                <!-- Unit Price -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="السعر:" Foreground="#8E8E93" FontSize="9"/>
                                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2} ج.م'}" Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold"/>
                                                                </StackPanel>

                                                                <!-- Sold Qty -->
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="المباع:" Foreground="#8E8E93" FontSize="9"/>
                                                                    <TextBlock Text="{Binding MaxQuantity, StringFormat='x{0}'}" Foreground="#E0E0E0" FontSize="11" FontWeight="Bold"/>
                                                                </StackPanel>

                                                                <!-- Return Qty Interactive Controls -->
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                    <TextBlock Text="الكمية المرتجعة:" Foreground="#ffb3af" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Command="{Binding DataContext.DecreaseReturnQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="-" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="White" Width="24" Height="24" Padding="0" Margin="0,0,4,0"/>
                                                                        <Border Background="#111111" BorderBrush="#d90429" BorderThickness="1" CornerRadius="4" Padding="4,1" Width="40">
                                                                            <TextBox Text="{Binding QuantityToReturn, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                                                                        </Border>
                                                                        <Button Command="{Binding DataContext.IncreaseReturnQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="+" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="White" Width="24" Height="24" Padding="0" Margin="4,0,4,0"/>
                                                                        <Button Command="{Binding DataContext.SetFullReturnQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="الكل" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#8E8E93" FontSize="9" Width="30" Height="24" Padding="0"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Line Refund Total -->
                                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                    <TextBlock Text="المسترد:" Foreground="#8E8E93" FontSize="9"/>
                                                                    <TextBlock Text="{Binding LineRefundTotal, StringFormat='{}{0:N2} ج.م'}" Foreground="#d90429" FontWeight="Black" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Empty Placeholder when no sale is selected -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,32">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSaleFoundForReturn}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="ReceiptTextCheckOutline" Width="44" Height="44" Foreground="#353534" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="اختر فاتورة من القائمة على اليمين أو ابحث لعرض الأصناف" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Summary & Actions -->
                            <StackPanel Grid.Row="2">
                                <!-- Return Reason & Restock Option -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="سبب المرتجع:" Foreground="#8E8E93" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="6,4" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding ReturnRestockToInventory, Mode=TwoWay}" Content="إعادة الأصناف للمخزون (+ المخزون)" Foreground="#4ae176" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="11"/>
                                </Grid>

                                <!-- Total Refund Banner (No text overlap) -->
                                <Border Background="#2b0005" BorderBrush="#d90429" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="إجمالي المبلغ المسترد للعميل:" FontSize="13" FontWeight="Bold" Foreground="#ffb3af" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalRefundAmount, StringFormat='{}{0:N2} ج.م'}" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Button Content="إلغاء" Command="{Binding CloseReturnDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" HorizontalAlignment="Right" Width="90" Height="36"/>
                                    <Button Command="{Binding ProcessReturnCommand}" Background="#d90429" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Padding="16,6" Height="36">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashRefund" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="تأكيد المرتجع وإعادة المخزون" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


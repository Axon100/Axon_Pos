<UserControl x:Class="Axon.UI.Views.PosTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource AppFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Product Card Template -->
        <DataTemplate x:Key="ProductCardTemplate">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="6" Padding="10" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChartTrackBgBrush}" />
                                <Setter Property="BorderBrush" Value="#d90429" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Product Image Container -->
                    <Border Grid.Row="0" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Height="130" Margin="0,0,0,10" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <materialDesign:PackIcon Kind="ImageOutline" Width="42" Height="42" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>

                            <!-- In Stock Badge (Green) -->
                            <Border Background="#104ae176" BorderBrush="#4d4ae176" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#4ae176" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StockDisplay}" Foreground="#4ae176" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Out of Stock Badge (Red) -->
                            <Border Background="#B3690005" BorderBrush="#ffb4ab" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,4" CornerRadius="6" Visibility="{Binding IsOutOfStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource OutOfStock}" Foreground="#ffb4ab" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Product Name -->
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,2,6"/>

                    <!-- Price & Quick Add Button -->
                    <Grid Grid.Row="2" Margin="2,2,2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Price, StringFormat='{}{0:#,##0.##}'}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text=" ج.م" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignIconButton}" Background="#2b0005" Foreground="#d90429" BorderBrush="#d90429" BorderThickness="1" HorizontalAlignment="Right" Width="30" Height="30" Padding="0" ToolTip="إضافة إلى السلة">
                            <materialDesign:PackIcon Kind="CartPlus" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Cart Item Template -->
        <DataTemplate x:Key="CartItemTemplate">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Item Name & Price Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Price, StringFormat='{}{0:#,##0.##} ج.م للقطعة'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Stepper [-] Qty [+] -->
                    <Border Grid.Column="1" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Width="22" Height="22" Padding="0">
                                <materialDesign:PackIcon Kind="Minus" Width="14" Height="14"/>
                            </Button>
                            <TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center" MinWidth="16" TextAlignment="Center"/>
                            <Button Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Width="22" Height="22" Padding="0">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Line Total Price -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Remove Item Button -->
                    <Button Grid.Column="3" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Width="24" Height="24" Padding="0" VerticalAlignment="Center" ToolTip="حذف">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Column: Products Browser & Search (Flex) -->
            <ColumnDefinition Width="*"/>
            <!-- Right Column: Cart & Checkout Panel (Fixed Width) -->
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANE: PRODUCTS & CATEGORY BROWSER ==================== -->
        <Grid Grid.Column="0" Margin="16,14,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Barcode & Search Bar -->
                <RowDefinition Height="*"/>    <!-- Category Sidebar + Products Grid -->
            </Grid.RowDefinitions>

            <!-- Top Search & Barcode Scan Bar with Live Feedback -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Scanner Animated Icon & Badge -->
                        <Border Grid.Column="0" Background="#22d90429" BorderBrush="#44d90429" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="4,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="قارئ الباركود" FontSize="11" FontWeight="Bold" Foreground="#d90429" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Input Field -->
                        <TextBox Grid.Column="1"
                                 x:Name="TxtBarcodeInput"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="امسح باركود المنتج بالـ Scanner هنا أو اكتب الكود للبحث المباشر..."
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                 CaretBrush="#d90429" Padding="8,10" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ProcessBarcodeInputCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Clear Input Button -->
                        <Button Grid.Column="2" 
                                Command="{Binding ClearBarcodeInputCommand}" 
                                Visibility="{Binding BarcodeInput.Length, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource MaterialDesignIconButton}" Width="26" Height="26" Padding="0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16"/>
                        </Button>

                        <!-- Add / Search Button -->
                        <Button Grid.Column="3" Command="{Binding ProcessBarcodeInputCommand}"
                                Style="{StaticResource Axon3DPrimaryButtonStyle}"
                                Height="36" Padding="14,0" Margin="4,0" ToolTip="مسح وإضافة المنتج للسلة مباشرة">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CartPlus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة للسلة" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Live Barcode Scan Feedback Toast Badge -->
                <Border Margin="0,6,0,0" CornerRadius="8" Padding="12,6" Visibility="{Binding HasBarcodeFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#154ae176"/>
                            <Setter Property="BorderBrush" Value="#404ae176"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastScanSuccess}" Value="False">
                                    <Setter Property="Background" Value="#22EF4444"/>
                                    <Setter Property="BorderBrush" Value="#44EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock Text="{Binding LastScannedBarcodeFeedback}" FontSize="11" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4ae176"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastScanSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Main Content Area: Categories Side Panel + Products Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Categories Navigation (200px) -->
                    <ColumnDefinition Width="200"/>
                    <!-- Products Grid Area -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Categories Side Panel -->
                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,12,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="6,4,6,10">
                            <TextBlock Text="الأقسام والتصنيفات" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Vertical Categories List -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CategoryList}"
                                 SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="CatBorder"
                                                        Background="{DynamicResource CardInnerBgBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon x:Name="CatIcon" Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="CatText" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Border x:Name="CountBadge" Grid.Column="2" Background="{DynamicResource ChartTrackBgBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock x:Name="CountText" Text="{Binding ProductCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="#D90429"/>
                                                        <Setter TargetName="CatBorder" Property="BorderBrush" Value="#B90323"/>
                                                        <Setter TargetName="CatIcon" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="CatText" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="CatText" Property="FontWeight" Value="Bold"/>
                                                        <Setter TargetName="CountBadge" Property="Background" Value="#4d000a"/>
                                                        <Setter TargetName="CountText" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource ChartTrackBgBrush}"/>
                                                        <Setter TargetName="CatText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter TargetName="CatIcon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 2. Products Grid Area -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Category Header Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Products Grid -->
                    </Grid.RowDefinitions>

                    <!-- Section Header Ribbon -->
                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCategoryItem.Name, FallbackValue='جميع الأصناف'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Products.Count, StringFormat='{}{0} صنف'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Products Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="productsControl" ItemsSource="{Binding Products}" ItemTemplate="{StaticResource ProductCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,48">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=productsControl}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="36" Height="36" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="لا توجد منتجات في هذا القسم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="جرب اختيار قسم آخر أو امسح الباركود مباشرة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== RIGHT PANE: CART & CHECKOUT ==================== -->
        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Multi-Invoice Tabs Bar -->
                    <RowDefinition Height="Auto"/> <!-- Customer Header -->
                    <RowDefinition Height="*"/>    <!-- Cart Items Table -->
                    <RowDefinition Height="Auto"/> <!-- Totals & Pay Now -->
                </Grid.RowDefinitions>

                <!-- Multi-Invoice Tab Switcher Bar (فاتورة 1 | فاتورة 2 | فاتورة 3) -->
                <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tab 1: فاتورة 1 -->
                        <Button Grid.Column="0" Command="{Binding SwitchOrderTabCommand}" CommandParameter="1" Height="36" Padding="4,0" ToolTip="فاتورة الزبون الأول">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Background" Value="{DynamicResource CardInnerBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTab1Active}" Value="True">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ReceiptText" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="فاتورة 1" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Tab1Badge}" FontSize="10" FontWeight="Black" Foreground="#4ae176" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: فاتورة 2 -->
                        <Button Grid.Column="2" Command="{Binding SwitchOrderTabCommand}" CommandParameter="2" Height="36" Padding="4,0" ToolTip="فاتورة الزبون الثاني">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Background" Value="{DynamicResource CardInnerBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTab2Active}" Value="True">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ReceiptText" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="فاتورة 2" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Tab2Badge}" FontSize="10" FontWeight="Black" Foreground="#4ae176" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: فاتورة 3 -->
                        <Button Grid.Column="4" Command="{Binding SwitchOrderTabCommand}" CommandParameter="3" Height="36" Padding="4,0" ToolTip="فاتورة الزبون الثالث">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Background" Value="{DynamicResource CardInnerBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTab3Active}" Value="True">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ReceiptText" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="فاتورة 3" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Tab3Badge}" FontSize="10" FontWeight="Black" Foreground="#4ae176" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Customer Header -->
                <Border Grid.Row="1" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Customer Avatar Icon -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Account" Foreground="{DynamicResource TextSecondaryBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#4ae176" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource WalkInCustomer}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource AssignProfile}" FontSize="11" Foreground="#d90429" Cursor="Hand" Margin="12,2,0,0"/>
                        </StackPanel>
                        
                        <!-- Top Toolbar Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Return / Refund Button -->
                            <Button Command="{Binding OpenReturnDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#d90429" Foreground="#d90429" Background="#1a2b0005" Padding="8,4" Height="32" Margin="0,0,6,0" ToolTip="طلب مرتجع / استرجاع مبيعات">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashRefund" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#d90429"/>
                                    <TextBlock Text="مرتجع" FontWeight="Bold" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Hold / Pause Cart -->
                            <Button Style="{StaticResource MaterialDesignIconButton}" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextSecondaryBrush}" Width="32" Height="32" Padding="0" Margin="0,0,6,0" ToolTip="تعليق الطلب">
                                <materialDesign:PackIcon Kind="Pause" Width="16" Height="16"/>
                            </Button>
                            
                            <!-- Clear Cart Button -->
                            <Button Command="{Binding ClearCartCommand}" Style="{StaticResource MaterialDesignIconButton}" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Foreground="#EF4444" Width="32" Height="32" Padding="0" ToolTip="مسح السلة بالكامل">
                                <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cart Items List Area -->
                <Grid Grid.Row="2" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Table Header -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Items -->
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header -->
                    <Grid Grid.Row="0" Margin="4,4,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource HeaderItem}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource HeaderQty}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource HeaderPrice}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    </Grid>
                    
                    <!-- Items / Empty State -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="cartControl" ItemsSource="{Binding Cart}" ItemTemplate="{StaticResource CartItemTemplate}"/>
                            
                            <!-- Empty Cart State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,48">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=cartControl}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="CartOutline" Width="30" Height="30" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="سلة المشتريات فارغة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="امسح باركود أو انقر على صنف لإضافته" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Order Summary & Checkout Footer -->
                <Border Grid.Row="3" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                    <StackPanel>
                        <!-- Payment Method & Discount Action Buttons Row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Discount Trigger Button -->
                            <Button Grid.Column="0" Command="{Binding OpenDiscountDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="38" Padding="6,0" ToolTip="تطبيق خصم على الفاتورة">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TicketPercentOutline" Width="16" Height="16" Foreground="#d90429" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnDiscount}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Other Payment Button ("دفع آخر") -->
                            <Button Grid.Column="2" Command="{Binding OpenPaymentMethodDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#d90429" Background="#1ad90429" Foreground="#d90429" Height="38" Padding="6,0" ToolTip="اختر طريقة الدفع (فيزا، فودافون كاش، إنستاباي...)">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CreditCardOutline" Width="16" Height="16" Foreground="#d90429" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedPaymentMethod, FallbackValue='دفع آخر'}" FontSize="11" FontWeight="Bold" Foreground="#d90429" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Breakdown: Subtotal & Discount -->
                        <StackPanel Margin="0,0,0,12">
                            <!-- Subtotal -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource Subtotal}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:#,##0.##} ج.م'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <!-- Tax (if applicable) -->
                            <Grid Margin="0,0,0,6" Visibility="{Binding IsTaxVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource TaxLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Tax, StringFormat='{}{0:#,##0.##} ج.م'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <!-- Discount Amount -->
                            <Grid>
                                <TextBlock Text="الخصم المطبق" Foreground="#d90429" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Discount, StringFormat='-{0:#,##0.##} ج.م'}" Foreground="#d90429" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Grand Total Highlight -->
                        <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Total}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="شامل كافة الخصومات" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Total, StringFormat='{}{0:#,##0.##}'}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" ج.م" FontSize="14" FontWeight="Bold" Foreground="#d90429" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Big Checkout Pay Now Button -->
                        <Button Command="{Binding CheckoutCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="52" Cursor="Hand">
                            <Grid Width="330">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashRegister" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource PayNow}" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="F12" FontSize="10" FontWeight="Black" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== DISCOUNT MODAL OVERLAY ==================== -->
        <Grid Visibility="{Binding IsDiscountDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#66000000" Grid.ColumnSpan="2" Panel.ZIndex="1000">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TicketPercentOutline" Width="20" Height="20" Foreground="#d90429" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تطبيق خصم على الفاتورة" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseDiscountDialogCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="قيمة الخصم (بالجنيه / ج.م) *" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DiscountInput, Converter={StaticResource ZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,4" FontSize="15" FontWeight="Bold"/>

                    <!-- Red Validation Error Text -->
                    <TextBlock Text="{Binding DiscountValidationError}" Foreground="#EF4444" FontSize="11" FontWeight="Bold" Margin="0,4,0,12" Visibility="{Binding HasDiscountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseDiscountDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="38" FontSize="12"/>
                        <Button Grid.Column="2" Command="{Binding ApplyDiscountCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="38" Padding="10,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckBold" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تطبيق الخصم" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== PAYMENT METHOD SELECTION OVERLAY ==================== -->
        <Grid Visibility="{Binding IsPaymentMethodDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#66000000" Grid.ColumnSpan="2" Panel.ZIndex="1100">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CreditCardOutline" Width="22" Height="22" Foreground="#d90429" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تحديد طريقة الدفع (دفع آخر)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding ClosePaymentMethodDialogCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="اختر طريقة دفع الفاتورة لتسجيلها بالسيستم وتضمينها بالتقارير:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12"/>

                    <UniformGrid Columns="1">
                        <!-- 1. Cash -->
                        <Button Command="{Binding SelectPaymentMethodCommand}" CommandParameter="نقداً (Cash)" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardInnerBgBrush}" Height="46" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Stretch">
                            <Grid Width="380">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Cash" Width="20" Height="20" Foreground="#4ae176" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="نقداً (كاش / Cash)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 2. Visa / Card -->
                        <Button Command="{Binding SelectPaymentMethodCommand}" CommandParameter="فيزا / كارت (Visa)" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardInnerBgBrush}" Height="46" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Stretch">
                            <Grid Width="380">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CreditCard" Width="20" Height="20" Foreground="#60A5FA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="فيزا / شبكة (Visa / Card)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 3. Vodafone Cash -->
                        <Button Command="{Binding SelectPaymentMethodCommand}" CommandParameter="فودافون كاش (Vodafone)" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardInnerBgBrush}" Height="46" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Stretch">
                            <Grid Width="380">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CellphoneCog" Width="20" Height="20" Foreground="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="فودافون كاش (Vodafone Cash)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 4. InstaPay -->
                        <Button Command="{Binding SelectPaymentMethodCommand}" CommandParameter="إنستاباي (InstaPay)" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardInnerBgBrush}" Height="46" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Stretch">
                            <Grid Width="380">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Flash" Width="20" Height="20" Foreground="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إنستاباي (InstaPay)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 5. Credit / Account -->
                        <Button Command="{Binding SelectPaymentMethodCommand}" CommandParameter="آجل / حساب (Credit)" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardInnerBgBrush}" Height="46" Margin="0,0,0,4" Padding="12,0" HorizontalContentAlignment="Stretch">
                            <Grid Width="380">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountClock" Width="20" Height="20" Foreground="#A78BFA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="آجل / حساب عميل (On Credit)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </UniformGrid>

                    <Button Command="{Binding ClosePaymentMethodDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Center" Width="100" Height="36" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== THERMAL RECEIPT OVERLAY ==================== -->
        <Grid Visibility="{Binding IsReceiptDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.ColumnSpan="2" Panel.ZIndex="2000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
                <!-- Thermal Paper Ticket Card -->
                <Border Background="White" CornerRadius="8" Width="340" Padding="16" SnapsToDevicePixels="True" Effect="{DynamicResource Axon3DDialogShadow}">
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel TextElement.Foreground="Black">
                            <!-- 1. CIRCULAR LOGO BRANDING -->
                            <Border Width="150" Height="150" CornerRadius="75" BorderBrush="Black" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 12,2 C 10,2 8,4 8,7 C 6,4 4,4 2,6 C 0,8 1,12 4,13 C 1,15 0,18 2,20 C 4,22 8,20 10,17 C 10,19 11,21 12,21 C 13,21 14,19 14,17 C 16,20 20,22 22,20 C 24,18 23,15 20,13 C 23,12 24,8 22,6 C 20,4 18,4 16,7 C 16,4 14,2 12,2 Z"
                                              Fill="Black" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="VELOURA" FontSize="16" FontWeight="Bold" FontFamily="Georgia, Times New Roman, Segoe UI" Foreground="Black" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="العاشر من رمضان - مجاورة الخامسة" FontSize="11" FontWeight="Bold" Foreground="Black" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="مول أبو الوفا، البدروم" FontSize="11" FontWeight="Bold" Foreground="Black" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,4"/>
                            <TextBlock Text="📞 01509924025   💬 01509923025" FontSize="10" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,2"/>
                            <TextBlock Text="🎵 Veloura.clothing" FontSize="10" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 2. BON NR BLOCK -->
                            <Grid Margin="0,4">
                                <TextBlock Text="Bon Nr:" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ReceiptSaleId}" FontSize="24" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 3. RECEIPT METADATA -->
                            <Grid Margin="0,2"><TextBlock Text="Receipt:" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptSaleId}" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Date:" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptDate, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Terminal:" FontSize="11" Foreground="Black"/><TextBlock Text="Cash-PC" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Payment Method:" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptPaymentMethod}" FontSize="11" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Served by:" FontSize="11" Foreground="Black"/><TextBlock Text="Manager" FontSize="11" FontWeight="Medium" Foreground="Black" HorizontalAlignment="Right"/></Grid>

                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 4. ITEMS TABLE -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Item" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Grid.Column="1" Text="Price" FontWeight="Bold" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Qty" FontWeight="Bold" FontSize="11" Foreground="Black" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Value" FontWeight="Bold" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <ItemsControl ItemsSource="{Binding ReceiptItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="35"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="Black" FlowDirection="RightToLeft" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="11" Foreground="Black" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="----------------------------------------------------------" Foreground="Black" FontSize="10" TextAlignment="Center" Margin="0,2"/>

                            <!-- 5. TOTALS -->
                            <TextBlock Text="{Binding ReceiptItems.Count, StringFormat='Items count: {0}'}" FontSize="11" Foreground="Black" Margin="0,4,0,6"/>

                            <Grid Margin="0,4,0,8">
                                <TextBlock Text="Total" FontSize="16" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text="{Binding ReceiptTotal, StringFormat='{}{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,2"><TextBlock Text="Cash" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Tendered:" FontSize="11" Foreground="Black"/><TextBlock Text="{Binding ReceiptTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="Black" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,2"><TextBlock Text="Change:" FontSize="11" Foreground="Black"/><TextBlock Text="0.00" FontSize="11" Foreground="Black" HorizontalAlignment="Right"/></Grid>

                            <!-- 5 Small Bottom Hollow Circles -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,4">
                                <Ellipse Width="9" Height="9" Fill="Transparent" Stroke="Black" StrokeThickness="1.5" Margin="4,0"/>
                                <Ellipse Width="9" Height="9" Fill="Transparent" Stroke="Black" StrokeThickness="1.5" Margin="4,0"/>
                                <Ellipse Width="9" Height="9" Fill="Transparent" Stroke="Black" StrokeThickness="1.5" Margin="4,0"/>
                                <Ellipse Width="9" Height="9" Fill="Transparent" Stroke="Black" StrokeThickness="1.5" Margin="4,0"/>
                                <Ellipse Width="9" Height="9" Fill="Transparent" Stroke="Black" StrokeThickness="1.5" Margin="4,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Footer Action Buttons -->
                <Grid Margin="0,14,0,0" Width="340">
                    <Button Command="{Binding CloseReceiptDialogCommand}" Content="إغلاق" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="36"/>
                    <Button Command="{Binding PrintCurrentReceiptCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Padding="16,6" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Margin="0,0,6,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            <TextBlock Text="طباعة الفاتورة" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ==================== RETURN / REFUND MODAL DIALOG ==================== -->
        <Grid Grid.ColumnSpan="2" Background="#B3000000" Visibility="{Binding IsReturnDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="900" MaxHeight="640" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource Axon3DDialogShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- 2-Column Body -->
                    </Grid.RowDefinitions>

                    <!-- Top Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRefund" Width="24" Height="24" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="إرجاع مبيعات / استرجاع فاتورة" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="ابحث برقم الفاتورة، أو اسم المنتج، أو الباركود، أو اختر مباشرة من قائمة الفواتير المسجلة." FontSize="11" Foreground="#8E8E93" Margin="32,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseReturnDialogCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="#8E8E93" Width="28" Height="28" Padding="0">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <!-- Two-Column Layout -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Invoices List -->
                        <Border Grid.Column="0" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="4,0,4,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="16" Height="16" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="سجل الفواتير" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#242424" CornerRadius="6" Padding="6,1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding RecentSalesForReturn.Count, StringFormat='{}{0} فاتورة'}" FontSize="10" FontWeight="Bold" Foreground="#8E8E93"/>
                                    </Border>
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding RecentSalesForReturn}"
                                         SelectedItem="{Binding SelectedRecentSaleItem, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SaleCardBorder"
                                                                Background="#181818"
                                                                BorderBrush="#2C2C2C"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,8"
                                                                Cursor="Hand">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                
                                                                <!-- Row 0: Invoice Number (Right) & Status (Left) -->
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding ReceiptNumber}" Foreground="White" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <Border Grid.Column="1" Background="#104ae176" BorderBrush="#4d4ae176" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Status}" Foreground="#4ae176" FontSize="9" FontWeight="Bold"/>
                                                                    </Border>
                                                                </Grid>
                                                                
                                                                <!-- Row 1: Date (Right) & Total (Left) -->
                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="ClockOutline" Width="11" Height="11" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:MM/dd HH:mm}'}" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2} ج.م'}" Foreground="#ffb3af" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SaleCardBorder" Property="Background" Value="#2b0005"/>
                                                                <Setter TargetName="SaleCardBorder" Property="BorderBrush" Value="#d90429"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SaleCardBorder" Property="Background" Value="#222222"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Search & Details Area -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Search Bar -->
                            <Border Grid.Row="0" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="BarcodeScan" Width="18" Height="18" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ReturnInvoiceSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="White" BorderThickness="0"
                                             VerticalAlignment="Center" FontSize="11"
                                             materialDesign:HintAssist.Hint="ابحث بـ: رقم الفاتورة / اسم المنتج / كود SKU / الباركود / المبلغ...">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SearchSaleForReturnCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="2" Command="{Binding SearchSaleForReturnCommand}" Background="#d90429" Foreground="White" BorderThickness="0" Padding="10,4" Height="28">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Magnify" Margin="0,0,4,0" VerticalAlignment="Center" Width="13" Height="13"/>
                                            <TextBlock Text="بحث" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Items Table Area -->
                            <Border Grid.Row="1" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid Visibility="{Binding IsSaleFoundForReturn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Invoice Summary Ribbon -->
                                        <Border Grid.Row="0" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="الفاتورة المختارة: " Foreground="#8E8E93" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedSaleForReturn.ReceiptNumber}" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,14,0"/>
                                                    <TextBlock Text="التاريخ والوقت: " Foreground="#8E8E93" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedSaleForReturn.Date, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Foreground="White" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="إجمالي الفاتورة الأصلية: " Foreground="#8E8E93" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedSaleForReturn.Total, StringFormat='{}{0:N2} ج.م'}" Foreground="#ffb3af" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Line Items List -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ReturnLineItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                    <ColumnDefinition Width="1.8*"/>
                                                                    <ColumnDefinition Width="1.2*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProductName}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Sku}" Foreground="#8E8E93" FontSize="9"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="سعر الشراء:" Foreground="#8E8E93" FontSize="9"/>
                                                                    <TextBlock Text="{Binding EffectiveUnitPrice, StringFormat='{}{0:N2} ج.م'}" Foreground="#E0E0E0" FontSize="10" FontWeight="Bold"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="المباع:" Foreground="#8E8E93" FontSize="9"/>
                                                                    <TextBlock Text="{Binding MaxQuantity, StringFormat='x{0}'}" Foreground="#E0E0E0" FontSize="10" FontWeight="Bold"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                    <TextBlock Text="الكمية المرتجعة:" Foreground="#ffb3af" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Command="{Binding DataContext.DecreaseReturnQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="-" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="White" Width="20" Height="20" Padding="0" Margin="0,0,2,0"/>
                                                                        <Border Background="#111111" BorderBrush="#d90429" BorderThickness="1" CornerRadius="4" Padding="2,0" Width="36">
                                                                            <TextBox Text="{Binding QuantityToReturn, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
                                                                        </Border>
                                                                        <Button Command="{Binding DataContext.IncreaseReturnQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="+" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="White" Width="20" Height="20" Padding="0" Margin="2,0,2,0"/>
                                                                        <Button Command="{Binding DataContext.SetFullReturnQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="الكل" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#8E8E93" FontSize="8" Width="26" Height="20" Padding="0"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                    <TextBlock Text="المسترد:" Foreground="#8E8E93" FontSize="9"/>
                                                                    <TextBlock Text="{Binding LineRefundTotal, StringFormat='{}{0:N2} ج.م'}" Foreground="#d90429" FontWeight="Black" FontSize="11"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Empty Placeholder -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,24">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSaleFoundForReturn}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="ReceiptTextCheckOutline" Width="38" Height="38" Foreground="#353534" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="اختر فاتورة من القائمة على اليمين أو ابحث لعرض الأصناف" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Summary & Actions -->
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="سبب المرتجع:" Foreground="#8E8E93" FontSize="10" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="6,4" FontSize="11"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding ReturnRestockToInventory, Mode=TwoWay}" Content="إعادة الأصناف للمخزون (+ المخزون)" Foreground="#4ae176" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,2" FontSize="10"/>
                                </Grid>

                                <Border Background="#2b0005" BorderBrush="#d90429" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="إجمالي المبلغ المسترد للعميل:" FontSize="13" FontWeight="Bold" Foreground="#ffb3af" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalRefundAmount, StringFormat='{}{0:N2} ج.م'}" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Button Content="إلغاء" Command="{Binding CloseReturnDialogCommand}" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Right" Width="80" Height="32"/>
                                    <Button Command="{Binding ProcessReturnCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Padding="14,4" Height="32">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashRefund" Margin="0,0,4,0" VerticalAlignment="Center" Width="14" Height="14"/>
                                            <TextBlock Text="تأكيد المرتجع وإعادة المخزون" FontWeight="Bold" VerticalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

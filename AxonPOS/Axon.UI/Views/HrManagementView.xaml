<UserControl x:Class="Axon.UI.Views.HrManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0F1015" Foreground="White"
             FontFamily="{DynamicResource AppFont}"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Page Title Ribbon -->
            <RowDefinition Height="Auto"/> <!-- KPI Summary Cards Boxes -->
            <RowDefinition Height="Auto"/> <!-- Admin Date & Filter Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Sub-Tabs Selector Header -->
            <RowDefinition Height="*"/>    <!-- Active Tab Content Area -->
        </Grid.RowDefinitions>

        <!-- 1. Header Ribbon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="#2B0E14" BorderBrush="#E63946" BorderThickness="1" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" Foreground="#E63946" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة شؤون العاملين والرواتب (HR)" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="متابعة الرواتب، السلف، الخصومات، الحضور والانصراف والإجازات مع تقارير شاملة" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Command="{Binding OpenAddEmployeeDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Height="38" Padding="14,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="إضافة موظف جديد" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. KPI Summary Boxes -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Box 1: Total Employees -->
            <Border Grid.Column="0" Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,8,0" Effect="{DynamicResource Axon3DCardShadow}">
                <StackPanel>
                    <TextBlock Text="إجمالي الموظفين" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalEmployeesCount}" FontSize="24" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text=" موظف" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 2: Monthly Salary Pool -->
            <Border Grid.Column="1" Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4,0,8,0" Effect="{DynamicResource Axon3DCardShadow}">
                <StackPanel>
                    <TextBlock Text="مرتبات الشهر الأساسية" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalMonthlySalaryPool, StringFormat='{}{0:#,##0.##}'}" FontSize="22" FontWeight="Black" Foreground="#10B981"/>
                        <TextBlock Text=" ج.م" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 3: Pending Advance Loans -->
            <Border Grid.Column="2" Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4,0,8,0" Effect="{DynamicResource Axon3DCardShadow}">
                <StackPanel>
                    <TextBlock Text="السلف المتبقية" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalPendingAdvances, StringFormat='{}{0:#,##0.##}'}" FontSize="22" FontWeight="Black" Foreground="#F59E0B"/>
                        <TextBlock Text=" ج.م" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 4: Deductions This Month -->
            <Border Grid.Column="3" Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4,0,8,0" Effect="{DynamicResource Axon3DCardShadow}">
                <StackPanel>
                    <TextBlock Text="خصومات الشهر" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalDeductionsThisMonth, StringFormat='{}{0:#,##0.##}'}" FontSize="22" FontWeight="Black" Foreground="#EF4444"/>
                        <TextBlock Text=" ج.م" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 5: Today Present -->
            <Border Grid.Column="4" Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4,0,0,0" Effect="{DynamicResource Axon3DCardShadow}">
                <StackPanel>
                    <TextBlock Text="حضور اليوم" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TodayPresentCount}" FontSize="24" FontWeight="Black" Foreground="#3B82F6"/>
                        <TextBlock Text=" حاضر" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Admin Date & Filter Toolbar -->
        <Border Grid.Row="2" Background="#161820" BorderBrush="#262936" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="CalendarRange" Width="18" Height="18" Foreground="#E63946" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="فلترة حسب التاريخ والمدى (Admin):" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="من:" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FilterFromDate, Mode=TwoWay}" Width="120" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="4"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="إلى:" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FilterToDate, Mode=TwoWay}" Width="120" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="4"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding FilterByDateRangeCommand}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="32" Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تطبيق الفلتر" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 4. Sub-Tabs Selector Header -->
        <Border Grid.Row="3" Background="#161820" BorderBrush="#262936" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="تسجيل الرواتب والسلف" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=0}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="تقرير المرتبات والسلف" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=1}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="تسديد السلف" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=2}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="تسجيل حضور وانصراف" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=3}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="تقرير الحضور والانصراف" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=4}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="تسجيل الخصومات" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=5}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="تقرير الخصومات" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=6}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="الإجازات والغيابات" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=7}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                    <RadioButton Content="تقرير الإجازات والغيابات" IsChecked="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=8}" Style="{StaticResource AxonTabRadioStyle}" Margin="2"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 5. Active Tab Content Area -->
        <Border Grid.Row="4" Background="#161820" BorderBrush="#262936" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <!-- Tab 0: Employees & Advance Registration -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="قائمة الموظفين والرواتب المعتمدة" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding OpenAddAdvanceDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="32" Padding="10,0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashPlus" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسجيل سلفة موظف" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenSalaryPaymentDialogCommand}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="32" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CreditCardCheck" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="صرف مرتب موظف" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="الوظيفة" Binding="{Binding JobTitle}" Width="140"/>
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                            <DataGridTextColumn Header="تاريخ التعيين" Binding="{Binding HireDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                            <DataGridTemplateColumn Header="إجراءات" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.OpenEditEmployeeDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AxonToolbarBtnStyle}" Margin="0,0,4,0">
                                                <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.OpenSalaryPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AxonToolbarBtnStyle}">
                                                <materialDesign:PackIcon Kind="CashCheck" Width="14" Height="14" Foreground="#10B981"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 1: Payroll & Advances Report -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="تقرير الرواتب والسحبيات المسجلة" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SalaryPayments}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="الشهر / السنة" Binding="{Binding Month, StringFormat='{}{0}'}" Width="100"/>
                            <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat='{}{0:#,##0.##}'}" Width="110"/>
                            <DataGridTextColumn Header="المكافآت" Binding="{Binding BonusAmount, StringFormat='{}{0:#,##0.##}'}" Width="90"/>
                            <DataGridTextColumn Header="الخصومات" Binding="{Binding DeductionAmount, StringFormat='{}{0:#,##0.##}'}" Width="90"/>
                            <DataGridTextColumn Header="خصم السلفة" Binding="{Binding AdvanceDeduction, StringFormat='{}{0:#,##0.##}'}" Width="100"/>
                            <DataGridTextColumn Header="صافي الراتب" Binding="{Binding NetSalary, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                            <DataGridTextColumn Header="تاريخ الصرف" Binding="{Binding PaymentDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 2: Repaying Advances -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="سجل تسديد السلف والقسط المتبقي" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Advances}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="تاريخ السلفة" Binding="{Binding AdvanceDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                            <DataGridTextColumn Header="قيمة السلفة" Binding="{Binding Amount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="120"/>
                            <DataGridTextColumn Header="المسدد" Binding="{Binding PaidAmount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="120"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="120"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                            <DataGridTemplateColumn Header="تسديد" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenPayoffDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="تسديد" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="26" FontSize="10" Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 3: Attendance Clock In/Out Registration -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=3}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="سجل الحضور والانصراف المباشر" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Command="{Binding OpenAttendanceDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockCheckOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تسجيل حضور / انصراف" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Attendances}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                            <DataGridTextColumn Header="وقت الحضور" Binding="{Binding CheckInTime}" Width="100"/>
                            <DataGridTextColumn Header="وقت الانصراف" Binding="{Binding CheckOutTime}" Width="100"/>
                            <DataGridTextColumn Header="ساعات العمل" Binding="{Binding WorkHours, StringFormat='{}{0:N1} ساعة'}" Width="110"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 4: Attendance Report -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="تقرير الحضور والانصراف الإجمالي" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Attendances}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="120"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="إجمالي الساعات" Binding="{Binding WorkHours, StringFormat='{}{0:N1}'}" Width="120"/>
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 5: Deductions Registration -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=5}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="تسجيل الخصومات المالية على الموظفين" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Command="{Binding OpenDeductionDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMinus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تسجيل خصم جديد" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Deductions}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="تاريخ الخصم" Binding="{Binding DeductionDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="120"/>
                            <DataGridTextColumn Header="مبلغ الخصم" Binding="{Binding Amount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                            <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 6: Deductions Report -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=6}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="تقرير الخصومات حسب التاريخ والموظف" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Deductions}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding DeductionDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="130"/>
                            <DataGridTextColumn Header="القيمة" Binding="{Binding Amount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                            <DataGridTextColumn Header="سبب الخصم" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 7: Leaves & Absences Registration -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=7}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="سجل الإجازات والغيابات" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Command="{Binding OpenLeaveDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarPlus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تسجيل إجازة / غياب" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Leaves}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="نوع الإجازة" Binding="{Binding LeaveType}" Width="130"/>
                            <DataGridTextColumn Header="من تاريخ" Binding="{Binding StartDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                            <DataGridTextColumn Header="إلى تاريخ" Binding="{Binding EndDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                            <DataGridTextColumn Header="عدد الأيام" Binding="{Binding TotalDays}" Width="90"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Tab 8: Leaves Report -->
                <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=8}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="تقرير الإجازات والغيابات التفصيلي" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Leaves}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                            <DataGridTextColumn Header="نوع الإجازة" Binding="{Binding LeaveType}" Width="130"/>
                            <DataGridTextColumn Header="المدى" Binding="{Binding TotalDays, StringFormat='{}{0} يوم'}" Width="100"/>
                            <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== DIALOG OVERLAYS ==================== -->

        <!-- 1. Employee Dialog -->
        <Grid Visibility="{Binding IsEmployeeDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.RowSpan="5" Panel.ZIndex="1000">
            <Border Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="14" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="بيانات الموظف" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم الموظف الثلاثي *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EmpFullName, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="المسمى الوظيفي" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EmpJobTitle, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="رقم الهاتف" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EmpPhone, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="الرقم القومي" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EmpNationalId, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="الراتب الأساسي الشهري (ج.م) *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EmpBasicSalary, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,14"/>

                    <Grid>
                        <Button Command="{Binding CloseEmployeeDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="34"/>
                        <Button Command="{Binding SaveEmployeeAsyncCommand}" Content="حفظ الموظف" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="120" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Advance Dialog -->
        <Grid Visibility="{Binding IsAdvanceDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.RowSpan="5" Panel.ZIndex="1000">
            <Border Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="14" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="تسجيل سلفة موظف جديدة" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="اختر الموظف *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedAdvanceEmployee}" DisplayMemberPath="FullName" Background="#111218" Foreground="White" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="مبلغ السلفة (ج.م) *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AdvanceAmount, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="تاريخ السلفة" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding AdvanceDate}" Background="#111218" Foreground="White" Padding="4" Margin="0,0,0,14"/>

                    <Grid>
                        <Button Command="{Binding CloseAdvanceDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="34"/>
                        <Button Command="{Binding SaveAdvanceAsyncCommand}" Content="تأكيد السلفة" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="120" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Payoff Advance Dialog -->
        <Grid Visibility="{Binding IsPayoffDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.RowSpan="5" Panel.ZIndex="1000">
            <Border Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="14" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="تسديد سلفة" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="مبلغ التسديد (ج.م) *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PayoffAmount, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,14"/>

                    <Grid>
                        <Button Command="{Binding ClosePayoffDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="34"/>
                        <Button Command="{Binding SavePayoffAsyncCommand}" Content="تأكيد التسديد" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="120" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Salary Payment Dialog -->
        <Grid Visibility="{Binding IsSalaryPaymentDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.RowSpan="5" Panel.ZIndex="1000">
            <Border Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="14" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="حساب وصرف الراتب الشهري" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="الموظف *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedSalaryEmployee}" DisplayMemberPath="FullName" Background="#111218" Foreground="White" Padding="8" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الراتب الأساسي" Foreground="#9CA3AF" FontSize="11"/>
                            <TextBox Text="{Binding SalaryBasic, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#111218" Foreground="White" Padding="6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="مكافآت وحوافز (+)" Foreground="#10B981" FontSize="11"/>
                            <TextBox Text="{Binding SalaryBonus, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" Padding="6"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="خصومات الغياب (-)" Foreground="#EF4444" FontSize="11"/>
                            <TextBox Text="{Binding SalaryDeductions, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" Padding="6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="خصم من السلفة (-)" Foreground="#F59E0B" FontSize="11"/>
                            <TextBox Text="{Binding SalaryAdvanceDeduction, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" Padding="6"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#2B0E14" BorderBrush="#E63946" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,14">
                        <Grid>
                            <TextBlock Text="صافي الراتب المستحق:" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SalaryNet, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Button Command="{Binding CloseSalaryPaymentDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="34"/>
                        <Button Command="{Binding SaveSalaryPaymentAsyncCommand}" Content="تأكيد صرف الراتب" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="140" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. Attendance Dialog -->
        <Grid Visibility="{Binding IsAttendanceDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.RowSpan="5" Panel.ZIndex="1000">
            <Border Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="14" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="تسجيل حضور وانصراف" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="الموظف *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedAttendanceEmployee}" DisplayMemberPath="FullName" Background="#111218" Foreground="White" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="التاريخ" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding AttendanceDate}" Background="#111218" Foreground="White" Padding="4" Margin="0,0,0,14"/>

                    <Grid>
                        <Button Command="{Binding CloseAttendanceDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="34"/>
                        <Button Command="{Binding SaveAttendanceAsyncCommand}" Content="حفظ الحضور" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="120" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6. Deduction Dialog -->
        <Grid Visibility="{Binding IsDeductionDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.RowSpan="5" Panel.ZIndex="1000">
            <Border Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="14" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="تسجيل خصم مالي على موظف" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="الموظف *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedDeductionEmployee}" DisplayMemberPath="FullName" Background="#111218" Foreground="White" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="مبلغ الخصم (ج.م) *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DeductionAmount, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,8"/>

                    <TextBlock Text="سبب الخصم" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DeductionReason, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,14"/>

                    <Grid>
                        <Button Command="{Binding CloseDeductionDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="34"/>
                        <Button Command="{Binding SaveDeductionAsyncCommand}" Content="تأكيد الخصم" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="120" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 7. Leave Dialog -->
        <Grid Visibility="{Binding IsLeaveDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#99000000" Grid.RowSpan="5" Panel.ZIndex="1000">
            <Border Background="#181A22" BorderBrush="#262936" BorderThickness="1" CornerRadius="14" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="تسجيل إجازة / غياب" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="الموظف *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedLeaveEmployee}" DisplayMemberPath="FullName" Background="#111218" Foreground="White" Padding="8" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="من تاريخ" Foreground="#9CA3AF" FontSize="11"/>
                            <DatePicker SelectedDate="{Binding LeaveStartDate}" Background="#111218" Foreground="White" Padding="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="إلى تاريخ" Foreground="#9CA3AF" FontSize="11"/>
                            <DatePicker SelectedDate="{Binding LeaveEndDate}" Background="#111218" Foreground="White" Padding="4"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="السبب / الملاحظات" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LeaveReason, UpdateSourceTrigger=PropertyChanged}" Background="#111218" Foreground="White" BorderBrush="#262936" Padding="8" Margin="0,0,0,14"/>

                    <Grid>
                        <Button Command="{Binding CloseLeaveDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="90" Height="34"/>
                        <Button Command="{Binding SaveLeaveAsyncCommand}" Content="تأكيد الإجازة" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="120" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

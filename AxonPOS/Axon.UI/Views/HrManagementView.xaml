<UserControl x:Class="Axon.UI.Views.HrManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Axon.UI.Helpers"
             Background="#111111" Foreground="White"
             FontFamily="{DynamicResource AppFont}"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:IntToBoolConverter x:Key="IntToBool" />
        <helpers:IntToVisibilityConverter x:Key="IntToVis" />

        <!-- Vertical Sidebar Tab RadioButton Style -->
        <Style x:Key="HrVerticalNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Active Indicator Bar -->
                                <Border x:Name="activeIndicator" Grid.Column="0" Width="3" Height="20" Background="#D90429" CornerRadius="2" Margin="0,0,10,0" Visibility="Collapsed"/>

                                <!-- Icon & Text -->
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <!-- Chevron / Arrow -->
                                <materialDesign:PackIcon x:Name="arrowIcon" Grid.Column="2" Kind="ChevronLeft" Width="16" Height="16" Foreground="#D90429" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F222E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A141A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D90429"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="arrowIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header & Filters Toolbar -->
            <RowDefinition Height="Auto"/> <!-- 2. KPI Summary Boxes -->
            <RowDefinition Height="*"/>    <!-- 3. Main Split Workspace (Sidebar List + Active Content) -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER & FILTERS TOOLBAR ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#2B0E14" BorderBrush="#D90429" BorderThickness="1" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#D90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة شؤون العاملين والرواتب (HR)" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="متابعة الرواتب، السلف، الخصومات، الحضور والانصراف والإجازات بأسلوب متكامل" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Action Toolbar (Date Range Filters + Add Employee Button) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Date Filter Bar -->
                <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarRange" Width="18" Height="18" Foreground="#D90429" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <TextBlock Text="من:" Foreground="#B3B3B3" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FilterFromDate, Mode=TwoWay}" Width="120" Height="32" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                        <TextBlock Text="إلى:" Foreground="#B3B3B3" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FilterToDate, Mode=TwoWay}" Width="120" Height="32" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                        <Button Command="{Binding FilterByDateRangeCommand}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="32" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تطبيق" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Add Employee Button -->
                <Button Command="{Binding OpenAddEmployeeDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="40" Padding="16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إضافة موظف جديد" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 2. KPI SUMMARY BOXES ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Box 1: Total Employees -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي الموظفين" FontSize="12" Foreground="#8E8E93" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalEmployeesCount}" FontSize="24" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text=" موظف" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 2: Monthly Salary Pool -->
            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="مرتبات الشهر الأساسية" FontSize="12" Foreground="#8E8E93" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalMonthlySalaryPool, StringFormat='{}{0:#,##0.##}'}" FontSize="22" FontWeight="Black" Foreground="#10B981"/>
                        <TextBlock Text=" ج.م" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 3: Pending Advance Loans -->
            <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="السلف المتبقية" FontSize="12" Foreground="#8E8E93" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalPendingAdvances, StringFormat='{}{0:#,##0.##}'}" FontSize="22" FontWeight="Black" Foreground="#F59E0B"/>
                        <TextBlock Text=" ج.م" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 4: Deductions This Month -->
            <Border Grid.Column="3" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="خصومات الشهر" FontSize="12" Foreground="#8E8E93" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalDeductionsThisMonth, StringFormat='{}{0:#,##0.##}'}" FontSize="22" FontWeight="Black" Foreground="#EF4444"/>
                        <TextBlock Text=" ج.م" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Box 5: Today Present -->
            <Border Grid.Column="4" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="حضور اليوم" FontSize="12" Foreground="#8E8E93" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TodayPresentCount}" FontSize="24" FontWeight="Black" Foreground="#3B82F6"/>
                        <TextBlock Text=" حاضر" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 3. MAIN SPLIT WORKSPACE ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- Right Vertical Headlines List -->
                <ColumnDefinition Width="*"/>   <!-- Active Tab Content Area -->
            </Grid.ColumnDefinitions>

            <!-- RIGHT SIDE PANEL: Vertical List Headlines Navigation -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="قائمة أقسام العاملين" FontSize="13" FontWeight="Bold" Foreground="#8E8E93" Margin="10,8,10,12"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 0. تسجيل الرواتب والسلف -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=0}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسجيل الرواتب والسلف" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 1. تقرير المرتبات والسلف -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=1}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تقرير المرتبات والسلف" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. تسديد السلف -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=2}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashCheck" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسديد السلف" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. تسجيل حضور وانصراف -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=3}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockCheckOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسجيل حضور وانصراف" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. تقرير الحضور والانصراف -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=4}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileClockOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تقرير الحضور والانصراف" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 5. تسجيل الخصومات -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=5}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashMinus" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسجيل الخصومات" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 6. تقرير الخصومات -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=6}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePercentOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تقرير الخصومات" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 7. الإجازات والغيابات -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=7}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarAlert" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="الإجازات والغيابات" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 8. تقرير الإجازات والغيابات -->
                            <RadioButton IsChecked="{Binding SelectedTab, Converter={StaticResource IntToBool}, ConverterParameter=8}" Style="{StaticResource HrVerticalNavTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileCalendarOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تقرير الإجازات والغيابات" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- LEFT CONTENT AREA: Active Tab Workspace -->
            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <!-- Tab 0: Employees & Advance Registration -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="قائمة الموظفين والرواتب المعتمدة" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Command="{Binding OpenAddAdvanceDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="34" Padding="12,0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashPlus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="تسجيل سلفة موظف" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenSalaryPaymentDialogCommand}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="34" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CreditCardCheck" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="صرف مرتب موظف" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="الوظيفة" Binding="{Binding JobTitle}" Width="140"/>
                                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat='{}{0:#,##0.##} ج.م'}" Width="140"/>
                                <DataGridTextColumn Header="تاريخ التعيين" Binding="{Binding HireDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="120"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.OpenEditEmployeeDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AxonToolbarBtnStyle}" Margin="0,0,6,0">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenSalaryPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AxonToolbarBtnStyle}">
                                                    <materialDesign:PackIcon Kind="CashCheck" Width="14" Height="14" Foreground="#10B981"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 1: Payroll & Advances Report -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=1}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="تقرير الرواتب والسحبيات المسجلة" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SalaryPayments}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="الشهر / السنة" Binding="{Binding Month, StringFormat='{}{0}'}" Width="100"/>
                                <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat='{}{0:#,##0.##}'}" Width="110"/>
                                <DataGridTextColumn Header="المكافآت" Binding="{Binding BonusAmount, StringFormat='{}{0:#,##0.##}'}" Width="90"/>
                                <DataGridTextColumn Header="الخصومات" Binding="{Binding DeductionAmount, StringFormat='{}{0:#,##0.##}'}" Width="90"/>
                                <DataGridTextColumn Header="خصم السلفة" Binding="{Binding AdvanceDeduction, StringFormat='{}{0:#,##0.##}'}" Width="100"/>
                                <DataGridTextColumn Header="صافي الراتب" Binding="{Binding NetSalary, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                                <DataGridTextColumn Header="تاريخ الصرف" Binding="{Binding PaymentDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 2: Repaying Advances -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=2}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="سجل تسديد السلف والقسط المتبقي" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Advances}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="تاريخ السلفة" Binding="{Binding AdvanceDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="120"/>
                                <DataGridTextColumn Header="قيمة السلفة" Binding="{Binding Amount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                                <DataGridTextColumn Header="المسدد" Binding="{Binding PaidAmount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="130"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                                <DataGridTemplateColumn Header="تسديد" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenPayoffDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="تسديد" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="28" FontSize="11" Padding="10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 3: Attendance Clock In/Out Registration -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=3}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="سجل الحضور والانصراف المباشر" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Command="{Binding OpenAttendanceDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Height="34" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockCheckOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسجيل حضور / انصراف" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Attendances}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="120"/>
                                <DataGridTextColumn Header="وقت الحضور" Binding="{Binding CheckInTime}" Width="110"/>
                                <DataGridTextColumn Header="وقت الانصراف" Binding="{Binding CheckOutTime}" Width="110"/>
                                <DataGridTextColumn Header="ساعات العمل" Binding="{Binding WorkHours, StringFormat='{}{0:N1} ساعة'}" Width="120"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 4: Attendance Report -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=4}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="تقرير الحضور والانصراف الإجمالي" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Attendances}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="130"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="130"/>
                                <DataGridTextColumn Header="إجمالي الساعات" Binding="{Binding WorkHours, StringFormat='{}{0:N1}'}" Width="130"/>
                                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 5: Deductions Registration -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=5}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="تسجيل الخصومات المالية على الموظفين" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Command="{Binding OpenDeductionDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Height="34" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashMinus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسجيل خصم جديد" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Deductions}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="تاريخ الخصم" Binding="{Binding DeductionDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="130"/>
                                <DataGridTextColumn Header="مبلغ الخصم" Binding="{Binding Amount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="140"/>
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 6: Deductions Report -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=6}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="تقرير الخصومات حسب التاريخ والموظف" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Deductions}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding DeductionDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="140"/>
                                <DataGridTextColumn Header="القيمة" Binding="{Binding Amount, StringFormat='{}{0:#,##0.##} ج.م'}" Width="140"/>
                                <DataGridTextColumn Header="سبب الخصم" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 7: Leaves & Absences Registration -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=7}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="سجل الإجازات والغيابات" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Command="{Binding OpenLeaveDialogCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Left" Height="34" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarPlus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تسجيل إجازة / غياب" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Leaves}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="نوع الإجازة" Binding="{Binding LeaveType}" Width="140"/>
                                <DataGridTextColumn Header="من تاريخ" Binding="{Binding StartDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="120"/>
                                <DataGridTextColumn Header="إلى تاريخ" Binding="{Binding EndDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="120"/>
                                <DataGridTextColumn Header="عدد الأيام" Binding="{Binding TotalDays}" Width="100"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Tab 8: Leaves Report -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntToVis}, ConverterParameter=8}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="تقرير الإجازات والغيابات التفصيلي" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Leaves}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource AxonDataGridColumnHeaderStyle}" RowStyle="{StaticResource AxonDataGridRowStyle}" CellStyle="{StaticResource AxonDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="نوع الإجازة" Binding="{Binding LeaveType}" Width="140"/>
                                <DataGridTextColumn Header="المدى" Binding="{Binding TotalDays, StringFormat='{}{0} يوم'}" Width="110"/>
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== DIALOG OVERLAYS ==================== -->

        <!-- 1. Employee Dialog -->
        <Grid Visibility="{Binding IsEmployeeDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="بيانات الموظف" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="اسم الموظف الثلاثي *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EmpFullName, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="المسمى الوظيفي" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EmpJobTitle, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="رقم الهاتف" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EmpPhone, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="الرقم القومي" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EmpNationalId, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="الراتب الأساسي الشهري (ج.م) *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EmpBasicSalary, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,20" FontSize="13"/>

                    <Grid>
                        <Button Command="{Binding CloseEmployeeDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="36"/>
                        <Button Command="{Binding SaveEmployeeAsyncCommand}" Content="حفظ الموظف" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="130" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Advance Dialog -->
        <Grid Visibility="{Binding IsAdvanceDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="تسجيل سلفة موظف جديدة" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="اختر الموظف *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedAdvanceEmployee}" DisplayMemberPath="FullName" Background="#111111" Foreground="White" Padding="10" Margin="0,0,0,12"/>

                    <TextBlock Text="مبلغ السلفة (ج.م) *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding AdvanceAmount, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="تاريخ السلفة" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding AdvanceDate}" Background="#111111" Foreground="White" Padding="6" Margin="0,0,0,20"/>

                    <Grid>
                        <Button Command="{Binding CloseAdvanceDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="36"/>
                        <Button Command="{Binding SaveAdvanceAsyncCommand}" Content="تأكيد السلفة" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="130" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Payoff Advance Dialog -->
        <Grid Visibility="{Binding IsPayoffDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="تسديد سلفة" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    <TextBlock Text="مبلغ التسديد (ج.م) *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding PayoffAmount, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,20" FontSize="13"/>

                    <Grid>
                        <Button Command="{Binding ClosePayoffDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="36"/>
                        <Button Command="{Binding SavePayoffAsyncCommand}" Content="تأكيد التسديد" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="130" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Salary Payment Dialog -->
        <Grid Visibility="{Binding IsSalaryPaymentDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="حساب وصرف الراتب الشهري" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="الموظف *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedSalaryEmployee}" DisplayMemberPath="FullName" Background="#111111" Foreground="White" Padding="10" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الراتب الأساسي" Foreground="#B3B3B3" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SalaryBasic, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#111111" Foreground="White" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="مكافآت وحوافز (+)" Foreground="#10B981" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SalaryBonus, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="خصومات الغياب (-)" Foreground="#EF4444" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SalaryDeductions, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="خصم من السلفة (-)" Foreground="#F59E0B" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SalaryAdvanceDeduction, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#2A141A" BorderBrush="#D90429" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,20">
                        <Grid>
                            <TextBlock Text="صافي الراتب المستحق:" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SalaryNet, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="22" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Button Command="{Binding CloseSalaryPaymentDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="36"/>
                        <Button Command="{Binding SaveSalaryPaymentAsyncCommand}" Content="تأكيد صرف الراتب" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="150" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. Attendance Dialog -->
        <Grid Visibility="{Binding IsAttendanceDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="تسجيل حضور وانصراف" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="الموظف *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedAttendanceEmployee}" DisplayMemberPath="FullName" Background="#111111" Foreground="White" Padding="10" Margin="0,0,0,12"/>

                    <TextBlock Text="التاريخ" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding AttendanceDate}" Background="#111111" Foreground="White" Padding="6" Margin="0,0,0,20"/>

                    <Grid>
                        <Button Command="{Binding CloseAttendanceDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="36"/>
                        <Button Command="{Binding SaveAttendanceAsyncCommand}" Content="حفظ الحضور" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="130" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6. Deduction Dialog -->
        <Grid Visibility="{Binding IsDeductionDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="تسجيل خصم مالي على موظف" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="الموظف *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedDeductionEmployee}" DisplayMemberPath="FullName" Background="#111111" Foreground="White" Padding="10" Margin="0,0,0,12"/>

                    <TextBlock Text="مبلغ الخصم (ج.م) *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DeductionAmount, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="سبب الخصم" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DeductionReason, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,20" FontSize="13"/>

                    <Grid>
                        <Button Command="{Binding CloseDeductionDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="36"/>
                        <Button Command="{Binding SaveDeductionAsyncCommand}" Content="تأكيد الخصم" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="130" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 7. Leave Dialog -->
        <Grid Visibility="{Binding IsLeaveDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="تسجيل إجازة / غياب" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="الموظف *" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedLeaveEmployee}" DisplayMemberPath="FullName" Background="#111111" Foreground="White" Padding="10" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="من تاريخ" Foreground="#B3B3B3" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding LeaveStartDate}" Background="#111111" Foreground="White" Padding="6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="إلى تاريخ" Foreground="#B3B3B3" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding LeaveEndDate}" Background="#111111" Foreground="White" Padding="6"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="السبب / الملاحظات" Foreground="#B3B3B3" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding LeaveReason, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" Padding="10" Margin="0,0,0,20" FontSize="13"/>

                    <Grid>
                        <Button Command="{Binding CloseLeaveDialogCommand}" Content="إلغاء" Style="{StaticResource Axon3DSecondaryButtonStyle}" HorizontalAlignment="Left" Width="100" Height="36"/>
                        <Button Command="{Binding SaveLeaveAsyncCommand}" Content="تأكيد الإجازة" Style="{StaticResource Axon3DPrimaryButtonStyle}" HorizontalAlignment="Right" Width="130" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

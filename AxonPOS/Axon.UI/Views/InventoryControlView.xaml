<UserControl x:Class="Axon.UI.Views.InventoryControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#111111" Foreground="White"
             FontFamily="Segoe UI">

    <!-- Value Converters for Status Badge -->
    <UserControl.Resources>
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="مثالي">
                    <Setter Property="Background" Value="#104ae176" />
                    <Setter Property="BorderBrush" Value="#4d4ae176" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="مخزون منخفض">
                    <Setter Property="Background" Value="#10ffb4ab" />
                    <Setter Property="BorderBrush" Value="#4dffb4ab" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="نفذت الكمية">
                    <Setter Property="Background" Value="#33ffb4ab" />
                    <Setter Property="BorderBrush" Value="#80ffb4ab" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="مثالي">
                    <Setter Property="Foreground" Value="#4ae176" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="مخزون منخفض">
                    <Setter Property="Foreground" Value="#ffb4ab" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="نفذت الكمية">
                    <Setter Property="Foreground" Value="#ffb4ab" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{DynamicResource InventoryDesc}" Foreground="#b4b5b5" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding ToggleLowStockFilterCommand}" Content="{DynamicResource BtnFilter}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="White" Margin="0,0,12,0"/>
                    <Button Command="{Binding OpenAddStockCommand}" Background="#d90429" Foreground="White" BorderThickness="0" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantClosedPlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource BtnReceiveStock}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- KPI Cards Grid -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Items -->
                <Border Grid.Column="0" Style="{StaticResource Axon3DCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource KpiTotalItems}" FontSize="13" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalItemsCount}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Low Stock -->
                <Border Grid.Column="2" Style="{StaticResource Axon3DCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource KpiLowStockAlerts}" FontSize="13" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding LowStockAlertsCount}" FontSize="28" FontWeight="Bold" Foreground="#EF4444"/>
                        <TextBlock Text="{DynamicResource KpiRequiresAttention}" Foreground="#737373" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Restock -->
                <Border Grid.Column="4" Style="{StaticResource Axon3DCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource KpiPendingRestock}" FontSize="13" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PendingRestockCount}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Capacity -->
                <Border Grid.Column="6" Background="#1A1A1A" CornerRadius="8" BorderBrush="#2C2C2C" BorderThickness="1" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource KpiWarehouseCapacity}" FontSize="12" Foreground="#b4b5b5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding WarehouseCapacity, StringFormat={}{0}%}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <ProgressBar Value="{Binding WarehouseCapacity}" Height="6" Background="#222222" Foreground="#4ae176" BorderThickness="0" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DataGrid -->
            <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource InventoryList}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,12,0"/>
                            <Border Background="#222222" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding EntriesCountDisplay}" Foreground="#b4b5b5" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        
                        <Border Grid.Column="1" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="4" Width="250">
                            <Grid>
                                <materialDesign:PackIcon Kind="Magnify" Foreground="#b4b5b5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" Margin="32,0,0,0" VerticalAlignment="Center" materialDesign:HintAssist.Hint="{DynamicResource HintSearchSku}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid>
                        <DataGrid x:Name="inventoryGrid" ItemsSource="{Binding InventoryItems}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowBackground="#111111" AlternatingRowBackground="#1A1A1A" Foreground="White" HeadersVisibility="Column" BorderThickness="0,1,0,0" BorderBrush="#2C2C2C" GridLinesVisibility="None" RowHeight="48">
                            <DataGrid.Columns>
                                <!-- Checkbox Column -->
                                <DataGridTemplateColumn Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{DynamicResource HeaderSku}" Binding="{Binding Sku}" Foreground="#b4b5b5" Width="120" />
                                
                                <DataGridTemplateColumn Header="{DynamicResource HeaderProductName}" Width="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36" Background="#222222" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <materialDesign:PackIcon Kind="{Binding Icon}" Foreground="#b4b5b5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="{DynamicResource HeaderLocation}" Binding="{Binding Location}" Foreground="#b4b5b5" Width="150" />
                                
                                <!-- Current Stock -->
                                <DataGridTemplateColumn Header="{DynamicResource HeaderCurrent}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CurrentStock}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStock}" Value="0">
                                                                <Setter Property="Foreground" Value="#ffb4ab" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{DynamicResource HeaderRequired}" Binding="{Binding RequiredStock}" Foreground="#b4b5b5" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,16,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTemplateColumn Header="{DynamicResource HeaderStatus}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <!-- Actions -->
                                <DataGridTemplateColumn Header="{DynamicResource HeaderActions}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.RestockItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{DynamicResource Restock}" BorderBrush="#d90429" Foreground="#d90429" Height="28" Padding="12,0" FontSize="12" Margin="0,0,8,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="مثالي">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="OnThreeDotsMenuClick" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#b4b5b5" Padding="4" Height="28">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="#1A1A1A" Foreground="White" BorderBrush="#2C2C2C">
                                                            <MenuItem Header="إعادة التخزين السريع (+50)" Command="{Binding PlacementTarget.Tag.RestockItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="PackageVariantPlus" Foreground="#4ae176"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="تغذية كمية مخصصة (توريد)" Command="{Binding PlacementTarget.Tag.CustomRestockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="PlusBox" Foreground="#3b82f6"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Background="#2C2C2C"/>
                                                            <MenuItem Header="حذف الصنف" Command="{Binding PlacementTarget.Tag.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#d90429"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <materialDesign:PackIcon Kind="DotsVertical" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,32">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=inventoryGrid}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Kind="PackageVariant" Width="64" Height="64" Foreground="#353534" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="لا توجد بيانات مخزون" Foreground="#b4b5b5" FontSize="20" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

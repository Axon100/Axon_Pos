<UserControl x:Class="Axon.UI.Views.InventoryControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#111111" Foreground="White"
             FontFamily="Segoe UI" FlowDirection="RightToLeft">

    <!-- Value Converters for Status Badge -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="مثالي">
                    <Setter Property="Background" Value="#224AE176" />
                    <Setter Property="BorderBrush" Value="#444AE176" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="مخزون منخفض">
                    <Setter Property="Background" Value="#22FBBF24" />
                    <Setter Property="BorderBrush" Value="#44FBBF24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="نفذت الكمية">
                    <Setter Property="Background" Value="#22EF4444" />
                    <Setter Property="BorderBrush" Value="#44EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="مثالي">
                    <Setter Property="Foreground" Value="#4AE176" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="مخزون منخفض">
                    <Setter Property="Foreground" Value="#FBBF24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="نفذت الكمية">
                    <Setter Property="Foreground" Value="#EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header & Filters -->
            <RowDefinition Height="Auto"/> <!-- 2. 3D KPI Cards -->
            <RowDefinition Height="*"/>    <!-- 3. Main Catalog/Table Area -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. PAGE HEADER & ACTIONS ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="28" Height="28" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="إدارة مواقع المستودعات، تتبع حركة المواد والتوريدات، ومراقبة مستويات المخزون بالنظام." Foreground="#8E8E93" FontSize="13" Margin="38,4,0,0"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Filter Low Stock Toggle -->
                <Button Command="{Binding ToggleLowStockFilterCommand}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="38" Padding="14,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" Foreground="#B3B3B3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تصفية النواقص فقط" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Receive Stock Button -->
                <Button Command="{Binding OpenAddStockCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="38" Padding="16,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageVariantClosedPlus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="استلام وتغذية مخزون" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 2. 3D KPI STATS CARDS GRID ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Items Card -->
            <Border Grid.Column="0" Style="{StaticResource Axon3DCardStyle}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الأصناف بالمخزن" FontSize="11" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalItemsCount}" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FFFFFF" Width="42" Height="42" CornerRadius="10" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Low Stock Alerts Card -->
            <Border Grid.Column="2" Style="{StaticResource Axon3DCardStyle}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="تنبيهات نقص المخزون" FontSize="11" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LowStockAlertsCount}" FontSize="24" FontWeight="ExtraBold" Foreground="#EF4444"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22EF4444" Width="42" Height="42" CornerRadius="10" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AlertCircle" Width="24" Height="24" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Pending Restock Card -->
            <Border Grid.Column="4" Style="{StaticResource Axon3DCardStyle}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="بانتظار إعادة التخزين" FontSize="11" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PendingRestockCount}" FontSize="24" FontWeight="ExtraBold" Foreground="#FBBF24"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FBBF24" Width="42" Height="42" CornerRadius="10" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="24" Height="24" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Warehouse Capacity Card -->
            <Border Grid.Column="6" Style="{StaticResource Axon3DCardStyle}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="سعة المستودع التشغيلية" FontSize="11" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding WarehouseCapacity, StringFormat={}{0}%}" FontSize="24" FontWeight="ExtraBold" Foreground="#4AE176"/>
                        <ProgressBar Value="{Binding WarehouseCapacity}" Height="5" Background="#222222" Foreground="#4AE176" BorderThickness="0" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#224AE176" Width="42" Height="42" CornerRadius="10" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Warehouse" Width="24" Height="24" Foreground="#4AE176" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. MAIN INVENTORY CATALOG / TABLE CONTAINER ==================== -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="20" Effect="{DynamicResource Axon3DCardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Bar (Count + View Switcher + Search Box) -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardTextMultiple" Width="20" Height="20" Foreground="#d90429" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource InventoryList}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EntriesCountDisplay}" Foreground="#B3B3B3" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- View Switcher (3D Cards / Table) -->
                    <Border Grid.Column="2" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetCardViewModeCommand}" ToolTip="عرض بوكسات الأصناف (3D Boxes)" Style="{StaticResource Axon3DSecondaryButtonStyle}" Padding="10,4" Height="32" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewGrid" Width="18" Height="18" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="بوكسات" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetTableViewModeCommand}" ToolTip="عرض الجدول القياسي" Style="{StaticResource Axon3DSecondaryButtonStyle}" Padding="10,4" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Table" Width="18" Height="18" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="جدول" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Search Input Box -->
                    <Border Grid.Column="3" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="10,6" Width="260">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" FontSize="12" materialDesign:HintAssist.Hint="بحث باسم المنتج أو الموقع..."/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 1. 3D INVENTORY BOX CARDS CATALOG VIEW ==================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardViewMode}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ItemsControl ItemsSource="{Binding InventoryItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 3D Card Box Container with Upward TranslateY Animation & Light Red Glow -->
                                <Border Style="{StaticResource Axon3DCardStyle}" Width="290" Margin="0,0,16,16" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Status Badge & Location -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
                                            </Border>
                                            <Border Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="MapMarkerOutline" Width="12" Height="12" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Location}" Foreground="#B3B3B3" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Product Thumbnail & Name -->
                                        <Grid Grid.Row="1" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="48" Height="48" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <materialDesign:PackIcon Kind="PackageVariant" Width="24" Height="24" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 2: Stock Fill Level & Counter -->
                                        <Border Grid.Row="2" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                            <Grid>
                                                <TextBlock Text="كمية المخزون الحالي" FontSize="11" Foreground="#8E8E93" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CurrentStock}" FontSize="16" FontWeight="ExtraBold" Foreground="#4AE176"/>
                                                    <TextBlock Text=" قطعة" FontSize="12" Foreground="#4AE176" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 3: Quick Action Buttons (Restock / Deduct / Delete) -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Quick Restock Button -->
                                            <Button Grid.Column="0" Command="{Binding DataContext.CustomRestockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="32" Padding="4,0" ToolTip="تزويد وتغذية كمية">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="#4AE176" Margin="0,0,4,0"/>
                                                    <TextBlock Text="تزويد" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Stock Deduct Button -->
                                            <Button Grid.Column="2" Command="{Binding DataContext.DeductStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="32" Padding="4,0" ToolTip="خصم / سحب قطعة واحدة من المخزون">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" Foreground="#FBBF24" Margin="0,0,4,0"/>
                                                    <TextBlock Text="خصم" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="4" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="32" Width="34" Padding="0" ToolTip="حذف الصنف نهائياً">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#EF4444"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ==================== 2. INVENTORY DATA TABLE VIEW (SKU REMOVED) ==================== -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryItems}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#222222"
                          HeadersVisibility="Column" RowBackground="#161616" AlternatingRowBackground="#1A1A1A" SelectionMode="Single" RowHeight="48"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardViewMode}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AxonDataGridColumnHeaderStyle}"/>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AxonDataGridRowStyle}"/>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Product Name -->
                        <DataGridTemplateColumn Header="{DynamicResource HeaderProductName}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <materialDesign:PackIcon Kind="{Binding Icon}" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Location -->
                        <DataGridTextColumn Header="{DynamicResource HeaderLocation}" Binding="{Binding Location}" Foreground="#B3B3B3" Width="160" />
                        
                        <!-- Current Stock -->
                        <DataGridTemplateColumn Header="{DynamicResource HeaderCurrent}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentStock}" FontWeight="ExtraBold" FontSize="14" Foreground="#4AE176" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        
                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="{DynamicResource HeaderStatus}" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Quick Actions -->
                        <DataGridTemplateColumn Header="{DynamicResource HeaderActions}" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.CustomRestockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="30" Padding="8,0" Margin="0,0,6,0" ToolTip="تزويد كمية">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="#4AE176"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeductStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="30" Padding="8,0" Margin="0,0,6,0" ToolTip="خصم قطعة">
                                            <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" Foreground="#FBBF24"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="30" Padding="8,0" ToolTip="حذف الصنف">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

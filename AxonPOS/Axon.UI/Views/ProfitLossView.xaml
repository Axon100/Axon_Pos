<UserControl x:Class="Axon.UI.Views.ProfitLossView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Axon.UI.Helpers"
             FlowDirection="RightToLeft"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <helpers:StringEqualsToStyleConverter x:Key="StringToStyleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Select Mode Button Active -->
        <Style x:Key="PeriodBtnActive" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Select Mode Button Inactive -->
        <Style x:Key="PeriodBtnInactive" TargetType="Button" BasedOn="{StaticResource PeriodBtnActive}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Add Stock Button -->
        <Style x:Key="AddStockBtn" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Profit / Loss Cards -->
            <RowDefinition Height="20"/>    <!-- Gutter -->
            <RowDefinition Height="Auto"/>  <!-- Audit Controls -->
            <RowDefinition Height="15"/>    <!-- Gutter -->
            <RowDefinition Height="*"/>     <!-- Tables Grid -->
        </Grid.RowDefinitions>

        <!-- ==================== Row 0: Profit / Loss Cards ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Profit Card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with Select -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" Width="20" Height="20" Foreground="#4ADE80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إجمالي الأرباح" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Selector يومي / أسبوعي / شهري -->
                        <Border Grid.Column="1" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="يومي" Command="{Binding UpdateProfitTimeframeCommand}" CommandParameter="يومي">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProfitTimeframe}" Value="يومي">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="أسبوعي" Command="{Binding UpdateProfitTimeframeCommand}" CommandParameter="أسبوعي">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProfitTimeframe}" Value="أسبوعي">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="شهري" Command="{Binding UpdateProfitTimeframeCommand}" CommandParameter="شهري">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProfitTimeframe}" Value="شهري">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Amount -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalProfitAmount, StringFormat={}{0:N2}}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" ج.م" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                        </StackPanel>
                        <TextBlock Text="الأرباح الصافية المحققة للمبيعات بعد خصم جملة التكلفة" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Loss Card -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Select -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingDown" Width="20" Height="20" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إجمالي المصاريف والخسائر" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Selector يومي / أسبوعي / شهري -->
                        <Border Grid.Column="1" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="يومي" Command="{Binding UpdateLossTimeframeCommand}" CommandParameter="يومي">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LossTimeframe}" Value="يومي">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="أسبوعي" Command="{Binding UpdateLossTimeframeCommand}" CommandParameter="أسبوعي">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LossTimeframe}" Value="أسبوعي">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="شهري" Command="{Binding UpdateLossTimeframeCommand}" CommandParameter="شهري">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LossTimeframe}" Value="شهري">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Amount -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalLossAmount, StringFormat={}{0:N2}}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" ج.م" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                        </StackPanel>
                        <TextBlock Text="إجمالي بنود الصرف والتكلفة المهدورة أو التالفة المسجلة" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Row 2: Audit Controls & Summary stats ==================== -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Bar: Filter & Add Stock Button -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileFindOutline" Width="22" Height="22" Foreground="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="جرد المبيعات والأرباح" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <!-- Selector يومي / شهري / سنوي -->
                        <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="يومي" Command="{Binding UpdateAuditPeriodCommand}" CommandParameter="يومي">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuditPeriod}" Value="يومي">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="شهري" Command="{Binding UpdateAuditPeriodCommand}" CommandParameter="شهري">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuditPeriod}" Value="شهري">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="سنوي" Command="{Binding UpdateAuditPeriodCommand}" CommandParameter="سنوي">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtnInactive}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuditPeriod}" Value="سنوي">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Target Period Date Display -->
                        <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarMonth" Width="15" Height="15" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AuditDateDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Quick Stock Addition Button -->
                    <Button Grid.Column="1" Style="{StaticResource AddStockBtn}" Command="{Binding AddStockCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Warehouse" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="توريد / زيادة كمية بضاعة" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Bottom Row: KPI Summary Table / Metric Cards Grid -->
                <UniformGrid Grid.Row="1" Columns="5">
                    <!-- Metric 1: القطع المباعة -->
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="القطع المباعة" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalItemsSold}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text=" قطعة" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metric 2: قيمة المبيعات -->
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="قيمة المبيعات" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SalesRevenue, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="#3B82F6"/>
                                <TextBlock Text=" ج.م" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metric 3: التكلفة والجملة -->
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي الجملة / التكلفة" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SalesCost, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text=" ج.م" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metric 4: المصاريف -->
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="المصاريف" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AuditExpenses, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                                <TextBlock Text=" ج.م" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metric 5: صافي المكسب -->
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="صافي المكسب" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NetProfit, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Black" Foreground="#4ADE80"/>
                                <TextBlock Text=" ج.م" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ==================== Row 4: Tables Grid (Left: Audit details | Right: Stock Log) ==================== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>  <!-- Left: Audit Items Table -->
                <ColumnDefinition Width="20"/>  <!-- Gutter -->
                <ColumnDefinition Width="2*"/>  <!-- Right: Stock log history -->
            </Grid.ColumnDefinitions>

            <!-- Left: Audit Grid -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <TextBlock Text="تفاصيل جرد المنتجات والمبيعات" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AuditItems}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                              HeadersVisibility="Column" RowBackground="Transparent">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- اسم الصنف -->
                            <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" Width="1.5*"/>
                            
                            <!-- الكمية المباعة -->
                            <DataGridTextColumn Header="المباع" Binding="{Binding SoldQty}" Width="0.6*"/>
                            
                            <!-- سعر البيع -->
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SoldPrice, StringFormat={}{0:N0} ج.م}" Width="*"/>
                            
                            <!-- جملة المبيعات -->
                            <DataGridTextColumn Header="إجمالي البيع" Binding="{Binding TotalSales, StringFormat={}{0:N0} ج.م}" Width="*"/>
                            
                            <!-- التكلفة جملة -->
                            <DataGridTextColumn Header="جملة التكلفة" Binding="{Binding TotalCost, StringFormat={}{0:N0} ج.م}" Width="*"/>
                            
                            <!-- المكسب -->
                            <DataGridTemplateColumn Header="المكسب" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Profit, StringFormat={}{0:N0} ج.م}" Foreground="#4ADE80" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المخزون المتبقي -->
                            <DataGridTemplateColumn Header="الرصيد المتبقي" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CurrentStock, StringFormat={}{0} قطع}" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Stock Log Grid -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <TextBlock Text="سجل عمليات التوريد وزيادة البضاعة" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding StockLogs}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                              HeadersVisibility="Column" RowBackground="Transparent">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- المستند -->
                            <DataGridTextColumn Header="المستند" Binding="{Binding DocNumber}" Width="0.8*"/>

                            <!-- الصنف المورد -->
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="1.5*"/>

                            <!-- الكمية المضافة -->
                            <DataGridTemplateColumn Header="الكمية المضافة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding QuantityAdded, StringFormat={}+{0} قطع}" Foreground="#4ADE80" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- التاريخ -->
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

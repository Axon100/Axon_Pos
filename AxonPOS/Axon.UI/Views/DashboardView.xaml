<UserControl x:Class="Axon.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI" FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== 1. HEADER & QUICK ACTION BAR ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Header Title & Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource CardBgBrush}" BorderBrush="#d90429" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center" Effect="{DynamicResource Axon3DCardShadow}">
                        <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" Foreground="#d90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DateRange}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Interactive Date Filter & Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Quick POS Navigation Button -->
                    <Button Command="{Binding NavigateToPosCommand}" 
                            Style="{StaticResource Axon3DPrimaryButtonStyle}" 
                            Height="36" Padding="12,0" Margin="0,0,8,0" ToolTip="فتح نقطة البيع للمبيعات المباشرة">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PointOfSale" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="نقطة البيع POS" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Data Button -->
                    <Button Command="{Binding RefreshDataCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            Height="36" Padding="8,0" Margin="0,0,8,0" ToolTip="تحديث كافة بيانات لوحة التحكم">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#4AE176"/>
                    </Button>

                    <!-- Year Selector Dropdown (Appears when 'سنوي' is selected) -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="#d90429" BorderThickness="1" CornerRadius="8" Padding="8,2" Height="36" Margin="0,0,6,0"
                            Visibility="{Binding IsYearSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CalendarRange" Foreground="#D90429" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="السنة:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Custom Date Range Pickers (Appears when 'فترة مخصصة' is selected) -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <DatePicker SelectedDate="{Binding CustomStartDate}" Width="110" Height="36" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,4,0" Padding="4,2" VerticalContentAlignment="Center"/>
                        <TextBlock Text="إلى" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker SelectedDate="{Binding CustomEndDate}" Width="110" Height="36" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,4,0" Padding="4,2" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Main Filter Dropdown -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,2" Height="36" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarToday" Foreground="#D90429" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding DateRanges}" SelectedItem="{Binding SelectedDateRange}"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ==================== 2. KPI CARDS ==================== -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Net Profit Card -->
                <Border Grid.Column="0" Style="{StaticResource Axon3DCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="صافي الأرباح" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#142B1A" BorderBrush="#4AE176" BorderThickness="1" CornerRadius="6" Padding="5">
                                <materialDesign:PackIcon Kind="TrendingUp" Foreground="#4AE176" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalProfit, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="22" FontWeight="Black" Foreground="#4AE176" Margin="0,8,0,4"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Border Background="#142B1A" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                <TextBlock Text="الأرباح الفعلية" Foreground="#4AE176" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="المبيعات - المرتجعات - المصروفات" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Expenses Card -->
                <Border Grid.Column="2" Style="{StaticResource Axon3DCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="إجمالي المصروفات" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2B1414" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="5">
                                <materialDesign:PackIcon Kind="CashMinus" Foreground="#EF4444" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalExpenses, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="22" FontWeight="Black" Foreground="#EF4444" Margin="0,8,0,4"/>
                        <TextBlock Grid.Row="2" Text="إجمالي النفقات في الفترة المحددة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- 3. Products Card -->
                <Border Grid.Column="4" Style="{StaticResource Axon3DCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="إجمالي المنتجات والأصناف" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#14202B" BorderBrush="#60A5FA" BorderThickness="1" CornerRadius="6" Padding="5">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Foreground="#60A5FA" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalProducts, StringFormat='{}{0} صنف'}" FontSize="22" FontWeight="Black" Foreground="#60A5FA" Margin="0,8,0,4"/>
                        <TextBlock Grid.Row="2" Text="إجمالي الأصناف المسجلة بالنظام" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- 4. Low Stock Card -->
                <Border Grid.Column="6" Style="{StaticResource Axon3DCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تنبيهات نقص المخزون" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2B2214" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="5">
                                <materialDesign:PackIcon Kind="AlertOutline" Foreground="#F59E0B" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding LowStockCount, StringFormat='{}{0} أصناف'}" FontSize="22" FontWeight="Black" Foreground="#F59E0B" Margin="0,8,0,4"/>
                        <TextBlock Grid.Row="2" Text="أصناف أقل من الحد الأدنى بالمخزن" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 3. CHARTS ROW ==================== -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Daily Sales Overview Chart -->
                <Border Grid.Column="0" Style="{StaticResource Axon3DCardStyle}" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#2B1414" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="ChartAreaspline" Width="16" Height="16" Foreground="#D90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="نظرة عامة على المبيعات اليومية" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#142B1A" BorderBrush="#4AE176" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalSales, StringFormat='إجمالي المبيعات: {0:#,##0.##} ج.م'}" FontSize="11" FontWeight="Bold" Foreground="#4AE176"/>
                            </Border>
                        </Grid>

                        <!-- Dynamic Bar Graph -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DailySalesChartData}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0" VerticalAlignment="Bottom" Height="180" ToolTip="{Binding AmountDisplay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- The Vertical Bar with proportional dynamic height -->
                                        <Grid Grid.Row="0" VerticalAlignment="Bottom">
                                            <Border Background="{DynamicResource ChartTrackBgBrush}" CornerRadius="4,4,0,0" Height="140" Width="18" Opacity="0.8"/>
                                            <Border Background="#D90429" CornerRadius="4,4,0,0" Width="18" VerticalAlignment="Bottom" Height="{Binding BarHeight}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Amount}" Value="0">
                                                                <Setter Property="Background" Value="#2A2A2A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Day Label -->
                                        <TextBlock Grid.Row="1" Text="{Binding DayLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                
                <!-- Revenue Distribution by Category -->
                <Border Grid.Column="2" Style="{StaticResource Axon3DCardStyle}" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="#14202B" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="ChartDonut" Width="16" Height="16" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="توزيع الإيرادات حسب الأقسام" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Category Distribution Bars -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <ItemsControl ItemsSource="{Binding CategoryDistributionData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CategoryName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalSales, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <Border Background="#142B1A" CornerRadius="4" Padding="5,2">
                                                        <TextBlock Text="{Binding PercentageDisplay}" FontWeight="Bold" FontSize="10" Foreground="#4AE176"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="{DynamicResource ChartTrackBgBrush}" Height="6" CornerRadius="3">
                                                <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="6" Foreground="{Binding ColorHex}" Background="Transparent" BorderThickness="0"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 4. RECENT SALES & ALERTS ROW ==================== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Recent Sales Table -->
                <Border Grid.Column="0" Style="{StaticResource Axon3DCardStyle}">
                    <StackPanel>
                        <!-- Table Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#2B1414" Margin="0,0,10,0">
                                    <materialDesign:PackIcon Kind="History" Width="18" Height="18" Foreground="#D90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="أحدث عمليات البيع" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding ViewAllSalesCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#D90429" FontWeight="Bold" Height="32" Padding="8,0" Cursor="Hand" ToolTip="الانتقال لتقرير الفواتير التفصيلي">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="عرض الكل بالتقارير" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        
                        <DataGrid x:Name="recentSalesGrid" ItemsSource="{Binding RecentSales}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  HeadersVisibility="Column" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource TableAltRowBrush}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource TableHeaderBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ChartTrackBgBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding TxId}" Foreground="#D90429" FontWeight="Bold" Width="170"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Width="*"/>
                                <DataGridTextColumn Header="القيمة" Binding="{Binding AmountDisplay}" Foreground="#4AE176" FontWeight="Bold" Width="110"/>
                                <DataGridTemplateColumn Header="الحالة" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#142B1A" BorderBrush="#234D28" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#4AE176"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Time}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Inventory Alerts -->
                <Border Grid.Column="2" Style="{StaticResource Axon3DCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#2B2214" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Alert" Foreground="#F59E0B" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="تنبيهات المخزون الحرج" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <ItemsControl x:Name="alertsControl" ItemsSource="{Binding InventoryAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" Background="#261C14" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Grid.Column="0" Margin="0,0,12,0">
                                                    <materialDesign:PackIcon Kind="PackageVariant" Foreground="#F59E0B" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Alert}" Foreground="#D90429" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding DataContext.NavigateToInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Content="المخزون" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Height="30" FontSize="11" Padding="10,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State when no low stock alerts -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36,0,36">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=alertsControl}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="44" Height="44" Foreground="#4AE176" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="المخزون مستقر ولا توجد نواقص" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Axon.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#111111" Foreground="White"
             FontFamily="Segoe UI" FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,18,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== 1. HEADER & DATE FILTER ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ViewDashboard" Width="26" Height="26" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DateRange}" FontSize="12" Foreground="#8E8E93" Margin="36,4,0,0"/>
                </StackPanel>

                <!-- Interactive Arabic Date Range & Year Picker Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Year Selector Dropdown (Appears when 'سنوي' is selected) -->
                    <Border Background="#1A1A1A" BorderBrush="#d90429" BorderThickness="1" CornerRadius="8" Padding="10,4" Height="38" Margin="0,0,8,0"
                            Visibility="{Binding IsYearSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CalendarRange" Foreground="#D90429" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="السنة:" Foreground="#8E8E93" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}"
                                      Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Custom Date Range Pickers (Appears when 'فترة مخصصة' is selected) -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,8,0" VerticalAlignment="Center">
                        <DatePicker SelectedDate="{Binding CustomStartDate}" Width="120" Height="38" Background="#1A1A1A" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Margin="0,0,6,0" Padding="6,2" VerticalContentAlignment="Center"/>
                        <TextBlock Text="إلى" Foreground="#8E8E93" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding CustomEndDate}" Width="120" Height="38" Background="#1A1A1A" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Margin="0,0,6,0" Padding="6,2" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Main Filter Dropdown -->
                    <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12,4" Height="38" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarToday" Foreground="#D90429" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding DateRanges}" SelectedItem="{Binding SelectedDateRange}"
                                      Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ==================== 2. KPI CARDS ==================== -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Profit Card -->
                <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="18,16" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="صافي الأرباح" FontSize="12" Foreground="#8E8E93" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#162D1C" CornerRadius="6" Padding="6">
                                <materialDesign:PackIcon Kind="TrendingUp" Foreground="#4AE176" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalProfit, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="22" FontWeight="Bold" Foreground="#4AE176" Margin="0,10,0,6"/>
                        <TextBlock Grid.Row="2" Text="المبيعات - المرتجعات - المصروفات" Foreground="#6B7280" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- 2. Expenses Card -->
                <Border Grid.Column="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="18,16" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="إجمالي المصروفات" FontSize="12" Foreground="#8E8E93" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2D1616" CornerRadius="6" Padding="6">
                                <materialDesign:PackIcon Kind="CashMinus" Foreground="#EF4444" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalExpenses, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="22" FontWeight="Bold" Foreground="#EF4444" Margin="0,10,0,6"/>
                        <TextBlock Grid.Row="2" Text="إجمالي النفقات في الفترة المحددة" Foreground="#6B7280" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- 3. Products Card -->
                <Border Grid.Column="4" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="18,16" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="إجمالي المنتجات والأصناف" FontSize="12" Foreground="#8E8E93" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#16202D" CornerRadius="6" Padding="6">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Foreground="#60A5FA" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalProducts, StringFormat='{}{0} صنف'}" FontSize="22" FontWeight="Bold" Foreground="#60A5FA" Margin="0,10,0,6"/>
                        <TextBlock Grid.Row="2" Text="إجمالي الأصناف المسجلة بالنظام" Foreground="#6B7280" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- 4. Low Stock Card -->
                <Border Grid.Column="6" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="18,16" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تنبيهات نقص المخزون" FontSize="12" Foreground="#8E8E93" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2D2416" CornerRadius="6" Padding="6">
                                <materialDesign:PackIcon Kind="AlertOutline" Foreground="#F59E0B" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding LowStockCount, StringFormat='{}{0} أصناف'}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,10,0,6"/>
                        <TextBlock Grid.Row="2" Text="أصناف أقل من الحد الأدنى بالمخزن" Foreground="#6B7280" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 3. REAL CHARTS ROW ==================== -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Daily Sales Overview Chart -->
                <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="20" Height="300" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Header with separate Columns to prevent text overlap -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ChartAreaspline" Width="20" Height="20" Foreground="#D90429" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="نظرة عامة على المبيعات اليومية" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#162D1C" BorderBrush="#234D28" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalSales, StringFormat='إجمالي المبيعات: {0:#,##0.##} ج.م'}" FontSize="11" FontWeight="Bold" Foreground="#4AE176"/>
                            </Border>
                        </Grid>

                        <!-- Dynamic Bar Graph -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DailySalesChartData}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0" VerticalAlignment="Bottom" Height="200" ToolTip="{Binding AmountDisplay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- The Vertical Bar with proportional dynamic height -->
                                        <Grid Grid.Row="0" VerticalAlignment="Bottom">
                                            <Border Background="#222222" CornerRadius="4,4,0,0" Height="160" Width="18" Opacity="0.4"/>
                                            <Border Background="#D90429" CornerRadius="4,4,0,0" Width="18" VerticalAlignment="Bottom" Height="{Binding BarHeight}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Amount}" Value="0">
                                                                <Setter Property="Background" Value="#2E2E2E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Day Label -->
                                        <TextBlock Grid.Row="1" Text="{Binding DayLabel}" Foreground="#8E8E93" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                
                <!-- Revenue Distribution by Category -->
                <Border Grid.Column="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="20" Height="300" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartDonut" Width="20" Height="20" Foreground="#60A5FA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="توزيع الإيرادات حسب الأقسام" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Category Distribution Bars -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CategoryDistributionData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <!-- Separate columns for Category Name vs Percentage/Total -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalSales, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="11" Foreground="#8E8E93" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Border Background="#1E1E1E" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding PercentageDisplay}" FontWeight="Bold" FontSize="11" Foreground="#4AE176"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#222222" Height="6" CornerRadius="3">
                                                <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="6" Foreground="{Binding ColorHex}" Background="Transparent" BorderThickness="0"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 4. RECENT SALES & ALERTS ROW ==================== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Recent Sales Table -->
                <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="20" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <!-- Table Header with separate columns to prevent button/title collision -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="History" Width="20" Height="20" Foreground="#D90429" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="أحدث عمليات البيع" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding ViewAllSalesCommand}" Content="عرض الكل بالتقارير" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#D90429" FontWeight="Bold" FontSize="12" Height="28" Padding="8,2"/>
                        </Grid>
                        
                        <DataGrid x:Name="recentSalesGrid" ItemsSource="{Binding RecentSales}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#222222"
                                  HeadersVisibility="Column" RowBackground="Transparent">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#8E8E93"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#282828"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#222222"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding TxId}" Foreground="#D90429" FontWeight="Bold" Width="170"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Width="*"/>
                                <DataGridTextColumn Header="القيمة" Binding="{Binding AmountDisplay}" Foreground="#4AE176" FontWeight="Bold" Width="110"/>
                                <DataGridTemplateColumn Header="الحالة" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#162D1C" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#4AE176"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Time}" Foreground="#8E8E93" FontSize="11" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Inventory Alerts -->
                <Border Grid.Column="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="20" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Alert" Foreground="#F59E0B" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تنبيهات المخزون الحرج" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <ItemsControl x:Name="alertsControl" ItemsSource="{Binding InventoryAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" Background="#261C14" CornerRadius="6" Grid.Column="0" Margin="0,0,10,0">
                                                    <materialDesign:PackIcon Kind="PackageVariant" Foreground="#F59E0B" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Alert}" Foreground="#ffb4ab" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding DataContext.NavigateToInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Content="المخزون" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="#353534" Height="28" FontSize="11" Padding="8,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State when no low stock alerts -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,32">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=alertsControl}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="40" Height="40" Foreground="#4AE176" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="المخزون مستقر ولا توجد نواقص" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>

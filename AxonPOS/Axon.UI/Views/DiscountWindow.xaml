<Window x:Class="Axon.UI.Views.DiscountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تطبيق خصم على الفاتورة" Height="280" Width="360"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="RightToLeft"
        WindowStyle="SingleBorderWindow">

    <Border Padding="20">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Percent" Width="22" Height="22" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="إضافة خصم للفاتورة" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="أدخل قيمة الخصم إما كمبلغ ثابت بالجنيه أو نسبة مئوية %" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,2,0,0"/>
        </StackPanel>

        <!-- Input Section -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Type Selector (مبلغ / نسبة) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <RadioButton x:Name="RadioAmount" Grid.Column="0" Content="مبلغ ثابت (ج.م)" IsChecked="True" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" GroupName="DiscountType"/>
                <RadioButton x:Name="RadioPercent" Grid.Column="2" Content="نسبة مئوية (%)" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" GroupName="DiscountType"/>
            </Grid>

            <!-- Discount Value Field -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="TicketPercentOutline" Width="20" Height="20" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtDiscountValue" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextAlignment="Left" Text="0" PreviewTextInput="NumberValidationTextBox"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="إلغاء" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource CardBorderBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Height="40"/>
            <Button Grid.Column="2" Content="تطبيق الخصم" Click="Apply_Click" Background="#EF4444" Foreground="White" BorderThickness="0" Height="40" materialDesign:ButtonAssist.CornerRadius="6"/>
        </Grid>
    </Grid>
    </Border>
</Window>

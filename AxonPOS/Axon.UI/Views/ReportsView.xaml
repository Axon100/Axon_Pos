<UserControl x:Class="Axon.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource AppFont}" FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Toolbar Button Style -->
        <Style x:Key="ReportToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardInnerBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D90429"/>
                                <Setter Property="Foreground" Value="#D90429"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Selector RadioButton Style -->
        <Style x:Key="ReportTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D90429"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D90429"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header & Date/Filter -->
            <RowDefinition Height="Auto"/> <!-- 2. Tabs Selector -->
            <RowDefinition Height="Auto"/> <!-- 3. KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- 4. Report & Print Toolbar -->
            <RowDefinition Height="*"/>    <!-- 5. Report Document Canvas -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER & DATE FILTER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#22D90429" BorderBrush="#44D90429" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ChartBoxOutline" Width="24" Height="24" Foreground="#d90429" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="التقارير والتحليلات المالية" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="استخراج وتصدير تقارير الصندوق المغلق، مبيعات الأصناف، ودورة مبيعات المنتجات، وسجل الفواتير." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="44,4,0,0"/>
            </StackPanel>

            <!-- Filters Bar (Date Range + Category Filter + Product Filter) -->
            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Category Selector (Optional filter) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="القسم:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding FilterCategories}"
                                  SelectedItem="{Binding SelectedFilterCategory, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="135" Height="32" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                    </StackPanel>

                    <!-- Product Selector (Dropdown for all products in system) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="المنتج:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding FilterProducts}"
                                  SelectedItem="{Binding SelectedFilterProduct, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="150" Height="32" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                    </StackPanel>

                    <!-- From Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="CalendarImport" Width="16" Height="16" Foreground="#D90429" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="من:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="32" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="12"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="CalendarExport" Width="16" Height="16" Foreground="#D90429" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="إلى:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="32" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="12"/>
                    </StackPanel>

                    <!-- Generate Button -->
                    <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="34" Padding="16,0" ToolTip="تطبيق الفلترة وإنشاء التقرير">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إنشاء التقرير" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 2. 4 REPORT TABS ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <!-- 1. الصندوق المغلق -->
                <RadioButton Content="الصندوق المغلق (تقفيلات الشيفت)" GroupName="ReportCategoryGroup"
                             IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="0"
                             Style="{StaticResource ReportTabRadio}"/>
                
                <!-- 2. تصنيف المبيعات -->
                <RadioButton Content="تصنيف المبيعات (حسب الأقسام)" GroupName="ReportCategoryGroup"
                             Command="{Binding SetTabCommand}" CommandParameter="1"
                             Style="{StaticResource ReportTabRadio}"/>

                <!-- 3. مبيعات منتج موسع -->
                <RadioButton Content="مبيعات منتج موسع (دورة مبيعات الصنف)" GroupName="ReportCategoryGroup"
                             Command="{Binding SetTabCommand}" CommandParameter="2"
                             Style="{StaticResource ReportTabRadio}"/>

                <!-- 4. سجل الفواتير -->
                <RadioButton Content="سجل الفواتير والمبيعات" GroupName="ReportCategoryGroup"
                             Command="{Binding SetTabCommand}" CommandParameter="3"
                             Style="{StaticResource ReportTabRadio}"/>
                <!-- 5. الأرباح والخسائر -->
                <RadioButton Content="الأرباح والخسائر (Profit &amp; Loss)" GroupName="ReportCategoryGroup"
                             Command="{Binding SetTabCommand}" CommandParameter="4"
                             Style="{StaticResource ReportTabRadio}"/>
            </StackPanel>
        </Border>

        <!-- ==================== 3. KPI CARDS ==================== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <!-- KPIs for Tab 0: Closed Register (الصندوق المغلق) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إجمالي النقدي (مبيعات)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxCashTotal, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#162D1C" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CashPlus" Foreground="#4AE176" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إجمالي المرتجع (مستردات)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxReturnTotal, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2D1616" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CashMinus" Foreground="#EF4444" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="صافي البيع (النقدي - المرتجع)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxNetTotal, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#16202D" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ScaleBalance" Foreground="#60A5FA" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="عدد التقفيلات المسجلة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxClosuresCount, StringFormat='{}{0} تقفيلة'}" FontSize="20" FontWeight="Bold" Foreground="#FBBF24"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2D2416" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Safe" Foreground="#FBBF24" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- KPIs for Tab 1: Sales Classification (تصنيف المبيعات) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي مبيعات الأقسام" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportTotalSales, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي الكميات المباعة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportTotalQty, StringFormat='{}{0} قطعة'}" FontSize="20" FontWeight="Bold" Foreground="#60A5FA"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="القسم الأكثر مبيعاً" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportTopCategory}" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="عدد الأقسام النشطة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportActiveCount, StringFormat='{}{0} أقسام'}" FontSize="20" FontWeight="Bold" Foreground="#D90429"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KPIs for Tab 2: Extended Product Sales (مبيعات منتج موسع) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي مبيعات الصنف" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductReportTotalSales, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي الكميات المباعة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductReportTotalQty, StringFormat='{}{0} قطعة'}" FontSize="20" FontWeight="Bold" Foreground="#60A5FA"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="سعر البيع / المخزون" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SingleProductPrice, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="18" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock Text="{Binding SingleProductCurrentStock, StringFormat=' (مخزون: {0})'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="عدد حركات البيع والفواتير" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductReportActiveCount, StringFormat='{}{0} حركة بيع'}" FontSize="20" FontWeight="Bold" Foreground="#D90429"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KPIs for Tab 3: Sales Invoices & External Expenses (سجل الفواتير والمصروفات) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي الإيرادات (المبيعات)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="المصروفات الخارجية (النفقات)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي المرتجعات (المستردات)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalReturns, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="صافي الأرباح التشغيلية" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NetProfit, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#D90429"/>
                    </StackPanel>
                </Border>

            <!-- KPIs for Tab 4: Profit & Loss Statement (الأرباح والخسائر) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي إيرادات المبيعات" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="تكلفة البضاعة المباعة (COGS)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalCOGS, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#60A5FA"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="المصروفات والنثريات" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="صافي الأرباح النهائي" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NetProfit, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 4. REPORT & PRINT TOOLBAR ==================== -->
        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation & Zoom -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pagination Buttons -->
                    <Button Command="{Binding FirstPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة الأولى" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding PrevPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة السابقة" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                    </Button>

                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,4" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة التالية" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LastPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة الأخيرة" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource CardBorderBrush}" Margin="0,0,14,0"/>

                    <!-- Zoom Controls -->
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="تصغير التقرير" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="16" Height="16"/>
                    </Button>
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,4,0" Width="55" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
                    </Border>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="تكبير التقرير" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding ResetZoomCommand}" Style="{StaticResource ReportToolbarBtn}" Content="100%" FontSize="11" FontWeight="Bold" Padding="8,2" Height="32" Margin="0,0,10,0"/>
                </StackPanel>

                <!-- Status in center -->
                <TextBlock Grid.Column="1" Text="{Binding ReportStatus}" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Right Actions: Save/Export & Print -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Export Report Button (Save Dialog) -->
                    <Button Command="{Binding ExportExcelCommand}" CommandParameter="{Binding ElementName=ReportDocumentSheet}"
                            Background="#162D1C" Foreground="#4AE176" BorderBrush="#234D28" BorderThickness="1"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0" Padding="14,0" Height="34"
                            ToolTip="حفظ وتصدير التقرير بملف خارجي (PDFمطابق تماماً للشاشة, Excel .xlsx, CSV)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDownload" Foreground="#4AE176" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تصدير التقرير" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Print Report Button -->
                    <Button Command="{Binding PrintReportCommand}" CommandParameter="{Binding ElementName=ReportDocumentSheet}"
                            Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="34" Padding="16,0" ToolTip="طباعة التقرير مباشرة">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Printer" Margin="0,0,6,0" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="طباعة التقرير" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 5. REPORT DOCUMENT PREVIEW CANVAS ==================== -->
        <Border Grid.Row="4" Background="{DynamicResource HeaderBgBrush}" BorderBrush="#222222" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <!-- Generated Report Document (Only when HasReportData is True) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasReportData, Converter={StaticResource BoolToVis}}">
                    <Grid x:Name="ReportDocumentCanvas" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                        </Grid.LayoutTransform>

                        <!-- Realistic White Document Sheet -->
                        <Border x:Name="ReportDocumentSheet" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="32,28" Width="840" MinHeight="580" Effect="{DynamicResource Axon3DDialogShadow}">
                            <StackPanel>
                                <!-- ==================== A. TAB 0: CLOSED BOX REPORT (تقرير الصندوق المغلق وتقفيل الشيفت) ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedReportTab}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Document Official Header -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="VELOURA" FontSize="18" FontWeight="Black" FontFamily="Georgia, Times New Roman" Foreground="#1E3A8A"/>
                                                <TextBlock Text=" • نظام إدارة المبيعات" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="تقرير تقفيل الشيفت والصندوق المغلق التفصيلي" FontSize="20" FontWeight="Black" Foreground="#0F172A"/>
                                            <TextBlock Text="سجل الشفتات وتقفيلات الوردية والسيولة النقدية والمستردات بالفترة" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,0,4">
                                                <TextBlock Text="تقرير تقفيلة معتمد" FontSize="11" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding StartDate, StringFormat='من: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding EndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Navy Separator Line -->
                                    <Rectangle Height="2" Fill="#1E3A8A" Margin="0,0,0,16"/>

                                    <!-- Shift Financial Summary Mini Cards (ملخص سيولة الصندوق) -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Card 1: Gross Sales -->
                                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="إجمالي مبيعات النقدي" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ClosedBoxCashTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="16" FontWeight="Black" Foreground="#1E3A8A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 2: Returns -->
                                        <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="إجمالي المرتجعات" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                                                <TextBlock Text="{Binding ClosedBoxReturnTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="16" FontWeight="Black" Foreground="#DC2626" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 3: Invoices Count -->
                                        <Border Grid.Column="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="إجمالي الفواتير الصادرة" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                                                <TextBlock Text="{Binding ClosedBoxInvoicesCount, StringFormat='{}{0} فاتورة'}" FontSize="16" FontWeight="Black" Foreground="#2563EB" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 4: Net Shift Cash -->
                                        <Border Grid.Column="6" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="صافي الصندوق والدرج" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                <TextBlock Text="{Binding ClosedBoxNetTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="16" FontWeight="Black" Foreground="#059669" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Section Title: Shift Closures Breakdown -->
                                    <TextBlock Text="تفاصيل تقفيلات الوردية والشيفتات المسجلة:" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                                    <!-- Closures Report Main Data Table Header -->
                                    <Border Background="#1E3A8A" CornerRadius="4,4,0,0" Padding="10,8" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="كود التقفيلة" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                            <TextBlock Grid.Column="1" Text="الكاشير المسؤول" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                            <TextBlock Grid.Column="2" Text="توقيت بداية ونهاية الوردية" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                            <TextBlock Grid.Column="3" Text="الفواتير" FontWeight="Bold" FontSize="11" Foreground="White" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="مبيعات الكاش" FontWeight="Bold" FontSize="11" Foreground="White" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="المرتجعات" FontWeight="Bold" FontSize="11" Foreground="White" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="صافي التقفيلة" FontWeight="Bold" FontSize="11" Foreground="White" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="الحالة" FontWeight="Bold" FontSize="11" Foreground="White" TextAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Closures Report Items Table Rows -->
                                    <ItemsControl ItemsSource="{Binding ClosedRegisterReport}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" Padding="10,8" Background="White">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="75"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="65"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding ClosureCode}" FontWeight="Bold" FontSize="11" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CashierName}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PeriodDisplay}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding InvoicesCount, StringFormat='{}{0} فاتورة'}" FontSize="11" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding CashSales, StringFormat='{}{0:N2} ج.م'}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding ReturnsAmount, StringFormat='{}{0:N2} ج.م'}" FontSize="11" Foreground="#DC2626" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding NetSales, StringFormat='{}{0:N2} ج.م'}" FontWeight="Black" FontSize="12" Foreground="#059669" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="7" Background="#DCFCE7" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Detailed Shift Invoices Section -->
                                    <TextBlock Text="بيانات الفواتير المندرجة تحت التقرير:" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,18,0,8"/>
                                    
                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="95"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="رقم الفاتورة" FontWeight="Bold" FontSize="10" Foreground="#334155"/>
                                            <TextBlock Grid.Column="1" Text="تاريخ ووقت الفاتورة" FontWeight="Bold" FontSize="10" Foreground="#334155"/>
                                            <TextBlock Grid.Column="2" Text="الأصناف والقطع المباعة" FontWeight="Bold" FontSize="10" Foreground="#1E3A8A"/>
                                            <TextBlock Grid.Column="3" Text="الكاشير" FontWeight="Bold" FontSize="10" Foreground="#334155"/>
                                            <TextBlock Grid.Column="4" Text="العدد" FontWeight="Bold" FontSize="10" Foreground="#334155" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="طريقة الدفع" FontWeight="Bold" FontSize="10" Foreground="#334155" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="إجمالي الفاتورة" FontWeight="Bold" FontSize="10" Foreground="#334155" TextAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding SalesInvoicesReport}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="1,0,1,1" Padding="10,6" Background="White">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="95"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ReceiptNumber}" FontWeight="Bold" FontSize="11" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ItemsSummary}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding CashierName}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ItemsCount, StringFormat='{}{0} ق'}" FontSize="10" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding PaymentMethod}" FontSize="10" Foreground="#475569" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding Total, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" FontSize="11" Foreground="#059669" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Document Grand Total Summary Box -->
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ملخص الاعتماد النهائي للصندوق المغلق" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A"/>
                                                <TextBlock Text="{Binding ReportPeriodTitle}" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding ClosedBoxClosuresCount, StringFormat='عدد التقفيلات: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding ClosedBoxInvoicesCount, StringFormat='إجمالي الفواتير: {0}'}" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="إجمالي النقدي الشامل: " FontSize="12" Foreground="#475569" Width="140"/>
                                                    <TextBlock Text="{Binding ClosedBoxCashTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="إجمالي المرتجعات: " FontSize="12" Foreground="#DC2626" Width="140"/>
                                                    <TextBlock Text="{Binding ClosedBoxReturnTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                                                </StackPanel>
                                                <Rectangle Height="1" Fill="#CBD5E1" Margin="0,4,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="الإجمالي العام (صافي المبيعات): " FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Width="180"/>
                                                    <TextBlock Text="{Binding ClosedBoxNetTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="16" FontWeight="Black" Foreground="#1E3A8A"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Signatures & Authorization Section -->
                                    <Grid Margin="0,24,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="توقيع واعتمااد الكاشير المسؤول:" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="......................................................" FontSize="12" Foreground="#CBD5E1" Margin="0,10,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="توقيع واعتمااد إدارة المحل:" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="......................................................" FontSize="12" Foreground="#CBD5E1" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- ==================== B. TAB 1: SALES CLASSIFICATION (تصنيف المبيعات حسب الأقسام) ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedReportTab}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Document Official Header -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="VELOURA" FontSize="20" FontWeight="Black" Foreground="#1E3A8A" FontFamily="Segoe UI"/>
                                                <TextBlock Text=" • تعليمات فروع الفواتير والتقرير" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="تقرير تصنيف المبيعات والأقسام التفصيلي" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="القسم المختار: " FontSize="11" Foreground="#475569"/>
                                                <TextBlock Text="{Binding SelectedCategoryTitle}" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="تقرير تصنيفي معتمد" FontSize="11" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StartDate, StringFormat='من: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#047857" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding EndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#047857"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Divider Line -->
                                    <Rectangle Height="1.5" Fill="#1E3A8A" Margin="0,0,0,16"/>

                                    <!-- Categories Table Navy Header -->
                                    <Border Background="#1E3A8A" CornerRadius="4,4,0,0" Padding="10,8" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>

                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="65"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding ReceiptNumber}" FontWeight="Bold" FontSize="11" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CashierName}" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ItemsCount, StringFormat='{}{0} ق'}" FontSize="11" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding SubTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="#0F172A" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding DiscountAmount, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="#DC2626" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding TaxAmount, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="#64748B" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding Total, StringFormat='{}{0:N2} ج.م'}" FontWeight="Black" FontSize="11" Foreground="#059669" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="8" Background="#DCFCE7" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Invoices Total Summary Box -->
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ملخص إجمالي سجل المبيعات والفواتير" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A"/>
                                            <TextBlock Text="{Binding ReportPeriodTitle}" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding SalesInvoicesReport.Count, StringFormat='عدد الفواتير: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding TotalDiscounts, StringFormat='إجمالي الخصومات: {0:N2} ج.م'}" FontSize="11" Foreground="#DC2626" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding TotalTax, StringFormat='إجمالي الضرائب: {0:N2} ج.م'}" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>

                            <!-- ==================== E. TAB 4: PROFIT & LOSS STATEMENT (الأرباح والخسائر) ==================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="4">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Document Official Header -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="VELOURA" FontSize="20" FontWeight="Black" Foreground="#1E3A8A" FontFamily="Segoe UI"/>
                                            <TextBlock Text=" • تعليمات الحسابات والمالية" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="تقرير قائمة الأرباح والخسائر والتحليل المالي التفصيلي" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                        <TextBlock Text="بيان مالي تفصيلي بالإيرادات، التكاليف، هامش الربح، والمصروفات التشغيلية" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="تقرير أرباح وخسائر معتمد" FontSize="11" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat='من: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#047857" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding EndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#047857"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1.5" Fill="#1E3A8A" Margin="0,0,0,16"/>

                                <!-- SECTION 1: P&L FINANCIAL STATEMENT SUMMARY BOX -->
                                <TextBlock Text="أولاً: ملخص قائمة الأرباح والخسائر (Profit &amp; Loss Financial Statement):" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Gross Revenue -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1. إجمالي إيرادات المبيعات (Gross Sales Revenue)" FontSize="12" Foreground="#334155" Padding="0,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalRevenue, StringFormat='{}{0:N2} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#059669" Padding="0,4"/>

                                        <!-- 2. Returns -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="   (-) إجمالي المرتجعات والمستردات (Returns)" FontSize="11" Foreground="#DC2626" Padding="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalReturns, StringFormat='-{0:N2} ج.م'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" Padding="0,3"/>

                                        <!-- 3. Discounts -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="   (-) إجمالي الخصومات والتخفيضات (Discounts)" FontSize="11" Foreground="#D97706" Padding="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalDiscounts, StringFormat='-{0:N2} ج.م'}" FontSize="11" FontWeight="SemiBold" Foreground="#D97706" Padding="0,3"/>

                                        <!-- Net Revenue Row -->
                                        <Rectangle Grid.Row="3" Grid.ColumnSpan="2" Height="1" Fill="#CBD5E1" Margin="0,4"/>

                                        <!-- 4. COGS -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="2. تكلفة البضاعة المباعة (Cost of Goods Sold - COGS)" FontSize="12" Foreground="#334155" Padding="0,4"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalCOGS, StringFormat='-{0:N2} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB" Padding="0,4"/>

                                        <!-- Gross Profit Row -->
                                        <Border Grid.Row="5" Grid.ColumnSpan="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4">
                                            <Grid>
                                                <TextBlock Text="(=) إجمالي أرباح النشاط قبل المصروفات (Gross Profit Margin)" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding GrossProfit, StringFormat='{}{0:N2} ج.م'}" FontSize="14" FontWeight="Black" Foreground="#1E40AF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- 5. Operating Expenses -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="3. إجمالي المصروفات والنثريات التشغيلية (Operating Expenses)" FontSize="12" Foreground="#334155" Padding="0,4"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TotalExpenses, StringFormat='-{0:N2} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Padding="0,4"/>

                                        <!-- Final Net Profit / Loss Row -->
                                        <Border Grid.Row="7" Grid.ColumnSpan="2" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,6,0,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="(=) صافي الأرباح / الخسائر النهائي (Net Profit / Loss): " FontSize="13" FontWeight="Bold" Foreground="#92400E"/>
                                                    <TextBlock Text="{Binding NetProfitMarginPct, StringFormat='(نسبة الصافي: {0:F1}%)'}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding NetProfit, StringFormat='{}{0:N2} ج.م'}" FontSize="16" FontWeight="Black" Foreground="#059669" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- SECTION 2: PRODUCT-LEVEL PROFITABILITY TABLE -->
                                <TextBlock Text="ثانياً: تحليل أرباح وهامش ربحية الأصناف والمنتجات التفصيلي:" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                
                                <Border Background="#1E3A8A" CornerRadius="4,4,0,0" Padding="10,8" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="كود الصنف" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        <TextBlock Grid.Column="1" Text="اسم المنتج" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        <TextBlock Grid.Column="2" Text="القسم" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        <TextBlock Grid.Column="3" Text="الكمية" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="التكلفة" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="سعر البيع" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="إجمالي المبيعات" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="إجمالي التكلفة" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="صافي الربح" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="الهامش %" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ProductProfitabilityReport}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" Padding="8,6" Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="65"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayCode}" FontWeight="Bold" FontSize="10" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontWeight="Bold" FontSize="10" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CategoryName}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding QuantitySold, StringFormat='{}{0} ق'}" FontWeight="SemiBold" FontSize="10" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding CostPrice, StringFormat='{}{0:N2}'}" FontSize="10" Foreground="#475569" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding SellingPrice, StringFormat='{}{0:N2}'}" FontSize="10" Foreground="#0F172A" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding TotalSales, StringFormat='{}{0:N2}'}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding TotalCost, StringFormat='{}{0:N2}'}" FontSize="10" Foreground="#DC2626" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding NetProfit, StringFormat='{}{0:N2} ج.م'}" FontWeight="Black" FontSize="11" Foreground="#059669" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    
                                                    <Border Grid.Column="9" Background="#FEF3C7" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MarginDisplay}" FontSize="9" FontWeight="Bold" Foreground="#B45309"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- SECTION 3: OPERATING EXPENSES LEDGER TABLE -->
                                <TextBlock Text="ثالثاً: تفاصيل المصروفات التشغيلية والنثريات خلال الفترة:" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,18,0,8"/>
                                
                                <Border Background="#1E3A8A" CornerRadius="4,4,0,0" Padding="10,8" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="م" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="رمز المصروف" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        <TextBlock Grid.Column="2" Text="بند/نوع المصروف" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        <TextBlock Grid.Column="3" Text="البيان والوصف التفصيلي" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        <TextBlock Grid.Column="4" Text="المسؤول / المستلم" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        <TextBlock Grid.Column="5" Text="القيمة (ج.م)" FontWeight="Bold" FontSize="10" Foreground="White" TextAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ExpensesReport}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" Padding="8,6" Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding SequenceNumber}" FontSize="10" Foreground="#64748B" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ExpenseCode}" FontWeight="Bold" FontSize="10" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Category}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="10" Foreground="#334155" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding UserName}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat='{}{0:N2} ج.م'}" FontWeight="Black" FontSize="11" Foreground="#DC2626" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Signatures -->
                                <Grid Margin="0,30,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Right">
                                        <TextBlock Text="مسؤول الحسابات / المالي:" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        <TextBlock Text="التوقيع: ......................................." FontSize="10" Foreground="#64748B" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                        <TextBlock Text="توقيع واعتماد الإدارة:" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        <TextBlock Text="التوقيع: ......................................." FontSize="10" Foreground="#64748B" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="إجمالي المبيعات الإجمالي: " FontSize="11" Foreground="#475569" Width="140"/>
                                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N2} ج.م'}" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="#CBD5E1" Margin="0,4,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="الإجمالي الشامل الصافي للفواتير: " FontSize="12" FontWeight="Bold" Foreground="#059669" Width="190"/>
                                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N2} ج.م'}" FontSize="15" FontWeight="Black" Foreground="#059669"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Signatures & Authorization Section -->
                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="مسؤول المبيعات / الكاشير:" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="......................................................" FontSize="12" Foreground="#CBD5E1" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="توقيع واعتماد إدارة المحل:" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="......................................................" FontSize="12" Foreground="#CBD5E1" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Placeholder when report not generated yet -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,80" Padding="40,30" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReportData}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="72" Height="72" Background="#22D90429" BorderBrush="#44D90429" BorderThickness="1" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="ChartBar" Width="36" Height="36" Foreground="#d90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="جاهز لاستخراج التقارير والتحليلات المالية" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="اختر نوع التقرير والفترة الزمنية المطلوب استخراجها من الشريط العلوي، ثم اضغط على زر [ إنشاء التقرير ]" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Grid>
    </Grid>
</UserControl>





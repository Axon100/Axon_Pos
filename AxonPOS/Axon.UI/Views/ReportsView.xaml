<UserControl x:Class="Axon.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI" FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Toolbar Button Style -->
        <Style x:Key="ReportToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D90429"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Selector RadioButton Style -->
        <Style x:Key="ReportTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2b0005"/>
                                <Setter Property="Foreground" Value="#ffb3af"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header & Date/Filter -->
            <RowDefinition Height="Auto"/> <!-- 2. Tabs Selector -->
            <RowDefinition Height="Auto"/> <!-- 3. KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- 4. Report & Print Toolbar -->
            <RowDefinition Height="*"/>    <!-- 5. Report Document Canvas -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER & DATE FILTER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#22D90429" BorderBrush="#44D90429" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ChartBoxOutline" Width="24" Height="24" Foreground="#d90429" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="التقارير والتحليلات المالية" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="استخراج وتصدير تقارير الصندوق المغلق، مبيعات الأصناف، ودورة مبيعات المنتجات، وسجل الفواتير." Foreground="#8E8E93" FontSize="12" Margin="44,4,0,0"/>
            </StackPanel>

            <!-- Filters Bar (Date Range + Category Filter + Product Filter) -->
            <Border Grid.Column="1" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center" Effect="{DynamicResource Axon3DCardShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Category Selector (Optional filter) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="القسم:" Foreground="#A0A0A0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding FilterCategories}"
                                  SelectedItem="{Binding SelectedFilterCategory, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="135" Height="32" Background="#111111" Foreground="White"
                                  BorderBrush="#2C2C2C" BorderThickness="1" FontSize="11" Padding="8,4"/>
                    </StackPanel>

                    <!-- Product Selector (Dropdown for all products in system) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="المنتج:" Foreground="#A0A0A0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding FilterProducts}"
                                  SelectedItem="{Binding SelectedFilterProduct, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="150" Height="32" Background="#111111" Foreground="White"
                                  BorderBrush="#2C2C2C" BorderThickness="1" FontSize="11" Padding="8,4"/>
                    </StackPanel>

                    <!-- From Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="CalendarImport" Width="16" Height="16" Foreground="#D90429" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="من:" Foreground="#A0A0A0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="32" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" FontSize="12"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="CalendarExport" Width="16" Height="16" Foreground="#D90429" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="إلى:" Foreground="#A0A0A0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="32" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" FontSize="12"/>
                    </StackPanel>

                    <!-- Generate Button -->
                    <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="34" Padding="16,0" ToolTip="تطبيق الفلترة وإنشاء التقرير">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إنشاء التقرير" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 2. 4 REPORT TABS ==================== -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,14" Effect="{DynamicResource Axon3DCardShadow}">
            <StackPanel Orientation="Horizontal">
                <!-- 1. الصندوق المغلق -->
                <RadioButton Content="الصندوق المغلق (تقفيلات الشيفت)" GroupName="ReportCategoryGroup"
                             IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="0"
                             Style="{StaticResource ReportTabRadio}"/>
                
                <!-- 2. تصنيف المبيعات -->
                <RadioButton Content="تصنيف المبيعات (حسب الأقسام)" GroupName="ReportCategoryGroup"
                             Command="{Binding SetTabCommand}" CommandParameter="1"
                             Style="{StaticResource ReportTabRadio}"/>

                <!-- 3. مبيعات منتج موسع -->
                <RadioButton Content="مبيعات منتج موسع (دورة مبيعات الصنف)" GroupName="ReportCategoryGroup"
                             Command="{Binding SetTabCommand}" CommandParameter="2"
                             Style="{StaticResource ReportTabRadio}"/>

                <!-- 4. سجل الفواتير -->
                <RadioButton Content="سجل الفواتير والمبيعات" GroupName="ReportCategoryGroup"
                             Command="{Binding SetTabCommand}" CommandParameter="3"
                             Style="{StaticResource ReportTabRadio}"/>
            </StackPanel>
        </Border>

        <!-- ==================== 3. KPI CARDS ==================== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <!-- KPIs for Tab 0: Closed Register (الصندوق المغلق) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إجمالي النقدي (مبيعات)" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxCashTotal, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#162D1C" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CashPlus" Foreground="#4AE176" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إجمالي المرتجع (مستردات)" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxReturnTotal, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2D1616" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CashMinus" Foreground="#EF4444" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="صافي البيع (النقدي - المرتجع)" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxNetTotal, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#16202D" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ScaleBalance" Foreground="#60A5FA" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="6" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="عدد التقفيلات المسجلة" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClosedBoxClosuresCount, StringFormat='{}{0} تقفيلة'}" FontSize="20" FontWeight="Bold" Foreground="#FBBF24"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2D2416" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Safe" Foreground="#FBBF24" Width="20" Height="20"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- KPIs for Tab 1: Sales Classification (تصنيف المبيعات) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="إجمالي مبيعات الأقسام" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportTotalSales, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="إجمالي الكميات المباعة" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportTotalQty, StringFormat='{}{0} قطعة'}" FontSize="20" FontWeight="Bold" Foreground="#60A5FA"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="القسم الأكثر مبيعاً" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportTopCategory}" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="عدد الأقسام النشطة" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CategoryReportActiveCount, StringFormat='{}{0} أقسام'}" FontSize="20" FontWeight="Bold" Foreground="#ffb3af"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KPIs for Tab 2: Extended Product Sales (مبيعات منتج موسع) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="إجمالي مبيعات الصنف" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductReportTotalSales, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="إجمالي الكميات المباعة" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductReportTotalQty, StringFormat='{}{0} قطعة'}" FontSize="20" FontWeight="Bold" Foreground="#60A5FA"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="سعر البيع / المخزون" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SingleProductPrice, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="18" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock Text="{Binding SingleProductCurrentStock, StringFormat=' (مخزون: {0})'}" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="عدد حركات البيع والفواتير" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductReportActiveCount, StringFormat='{}{0} حركة بيع'}" FontSize="20" FontWeight="Bold" Foreground="#ffb3af"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KPIs for Tab 3: Sales Invoices & External Expenses (سجل الفواتير والمصروفات) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="إجمالي الإيرادات (المبيعات)" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#4ae176"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="المصروفات الخارجية (النفقات)" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="إجمالي المرتجعات (المستردات)" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalReturns, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16,12" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel>
                        <TextBlock Text="صافي الأرباح التشغيلية" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NetProfit, StringFormat='{}{0:#,##0.##} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#ffb3af"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 4. REPORT & PRINT TOOLBAR ==================== -->
        <Border Grid.Row="3" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" Effect="{DynamicResource Axon3DCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation & Zoom -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pagination Buttons -->
                    <Button Command="{Binding FirstPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة الأولى" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding PrevPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة السابقة" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                    </Button>

                    <Border Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="12,4" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentPage}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text=" / " Foreground="#8E8E93" FontSize="11"/>
                            <TextBlock Text="{Binding TotalPages}" Foreground="#8E8E93" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة التالية" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LastPageCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="الصفحة الأخيرة" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="#2C2C2C" Margin="0,0,14,0"/>

                    <!-- Zoom Controls -->
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="تصغير التقرير" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="16" Height="16"/>
                    </Button>
                    <Border Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,4,0" Width="55" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomText}" Foreground="White" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
                    </Border>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource ReportToolbarBtn}" Width="32" ToolTip="تكبير التقرير" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding ResetZoomCommand}" Style="{StaticResource ReportToolbarBtn}" Content="100%" FontSize="11" FontWeight="Bold" Padding="8,2" Height="32" Margin="0,0,10,0"/>
                </StackPanel>

                <!-- Status in center -->
                <TextBlock Grid.Column="1" Text="{Binding ReportStatus}" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Right Actions: Save/Export & Print -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Export Report Button (Save Dialog) -->
                    <Button Command="{Binding ExportExcelCommand}"
                            Background="#162D1C" Foreground="#4AE176" BorderBrush="#234D28" BorderThickness="1"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0" Padding="14,0" Height="34"
                            ToolTip="حفظ وتصدير التقرير بملف خارجي (Excel .xlsx, CSV .csv, HTML)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDownload" Foreground="#4AE176" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تصدير التقرير" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Print Report Button -->
                    <Button Command="{Binding PrintReportCommand}" CommandParameter="{Binding ElementName=ReportDocumentCanvas}"
                            Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="34" Padding="16,0" ToolTip="طباعة التقرير مباشرة">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Printer" Margin="0,0,6,0" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="طباعة التقرير" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 5. REPORT DOCUMENT PREVIEW CANVAS ==================== -->
        <Border Grid.Row="4" Background="{DynamicResource HeaderBgBrush}" BorderBrush="#222222" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <!-- Generated Report Document (Only when HasReportData is True) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasReportData, Converter={StaticResource BoolToVis}}">
                    <Grid x:Name="ReportDocumentCanvas" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                        </Grid.LayoutTransform>

                        <!-- Realistic White Document Sheet -->
                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="32,28" Width="840" MinHeight="580" Effect="{DynamicResource Axon3DDialogShadow}">
                            <StackPanel>
                                <!-- ==================== A. TAB 0: CLOSED BOX REPORT ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedReportTab}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Document Header -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="تقرير الصندوق المغلق" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
                                            <TextBlock Text="سجل تقفيلات الوردية والإيرادات والمستردات اليومية" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBlock Text="مطبوع" FontSize="11" FontWeight="Bold" Foreground="#008000" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat='الفترة: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding EndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Rectangle Height="1.5" Fill="#1E3A8A" Margin="0,0,0,16"/>

                                    <!-- Closures Report Items Table -->
                                    <ItemsControl ItemsSource="{Binding ClosedRegisterReport}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ClosureCode}" FontWeight="Bold" FontSize="12" Foreground="#1E3A8A"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CashierName, StringFormat='الكاشير: {0}'}" FontSize="11" Foreground="#333333"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PeriodDisplay, StringFormat='الفترة: {0}'}" FontSize="11" Foreground="#555555" HorizontalAlignment="Left"/>
                                                        </Grid>

                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Border Background="#F3F4F6" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="نقدي: " FontSize="11" Foreground="#666666"/>
                                                                        <TextBlock Text="{Binding CashSales, StringFormat='{}{0:N0} ج.م'}" FontSize="11" FontWeight="Bold" Foreground="#111827"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="#FEF2F2" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="مرتجع: " FontSize="11" Foreground="#EF4444"/>
                                                                        <TextBlock Text="{Binding ReturnsAmount, StringFormat='{}{0:N0} ج.م'}" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="صافي البيع: " FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                                                        <TextBlock Text="{Binding NetSales, StringFormat='{}{0:N0} ج.م'}" FontSize="12" FontWeight="Black" Foreground="#047857"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Document Total Summary Box -->
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ملخص إجمالي الصندوق المغلق" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A"/>
                                                <TextBlock Text="{Binding ReportPeriodTitle}" FontSize="11" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding ClosedBoxClosuresCount, StringFormat='عدد التقفيلات: {0}'}" FontSize="11" Foreground="#666666" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding ClosedBoxInvoicesCount, StringFormat='إجمالي الفواتير: {0}'}" FontSize="11" Foreground="#666666"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="إجمالي النقدي الشامل: " FontSize="12" Foreground="#4B5563" Width="140"/>
                                                    <TextBlock Text="{Binding ClosedBoxCashTotal, StringFormat='{}{0:N0} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="إجمالي المرتجعات: " FontSize="12" Foreground="#EF4444" Width="140"/>
                                                    <TextBlock Text="{Binding ClosedBoxReturnTotal, StringFormat='{}{0:N0} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>
                                                </StackPanel>
                                                <Rectangle Height="1" Fill="#D1D5DB" Margin="0,4,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="الإجمالي العام (صافي المبيعات): " FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Width="180"/>
                                                    <TextBlock Text="{Binding ClosedBoxNetTotal, StringFormat='{}{0:N0} ج.م'}" FontSize="15" FontWeight="Black" Foreground="#1E3A8A"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ==================== B. TAB 1: SALES CLASSIFICATION (تصنيف المبيعات) ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedReportTab}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Document Header -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="تقرير تصنيف المبيعات حسب الأقسام" FontSize="20" FontWeight="Bold" Foreground="#D90429"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="القسم المختار: " FontSize="11" Foreground="#666666"/>
                                                <TextBlock Text="{Binding SelectedCategoryTitle}" FontSize="11" FontWeight="Bold" Foreground="#111827"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBlock Text="تقرير تصنيفي معتمد" FontSize="11" FontWeight="Bold" Foreground="#008000" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat='الفترة: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding EndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Rectangle Height="1.5" Fill="#D90429" Margin="0,0,0,16"/>

                                    <!-- Categories Table Header -->
                                    <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="كود القسم" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                            <TextBlock Grid.Column="1" Text="اسم القسم / التصنيف" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                            <TextBlock Grid.Column="2" Text="عدد الأصناف" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="الكمية المباعة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="إجمالي المبيعات" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="النسبة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Left"/>
                                        </Grid>
                                    </Border>

                                    <!-- Category Items Rows -->
                                    <ItemsControl ItemsSource="{Binding SalesClassificationReport}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding CategoryCode}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontWeight="Bold" FontSize="12" Foreground="#111827" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DistinctProductsCount, StringFormat='{}{0} أصناف'}" FontSize="11" Foreground="#4B5563" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding QuantitySold, StringFormat='{}{0} قطعة'}" FontWeight="SemiBold" FontSize="12" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding TotalSales, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" FontSize="12" Foreground="#047857" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        
                                                        <Border Grid.Column="5" Background="#FEF3C7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PercentageDisplay}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Category Classification Total Summary Box -->
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ملخص تصنيف المبيعات" FontSize="13" FontWeight="Bold" Foreground="#D90429"/>
                                                <TextBlock Text="{Binding ReportPeriodTitle}" FontSize="11" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding CategoryReportActiveCount, StringFormat='عدد الأقسام المدرجة بالتقرير: {0} أقسام'}" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="إجمالي الكميات المباعة: " FontSize="12" Foreground="#4B5563" Width="140"/>
                                                    <TextBlock Text="{Binding CategoryReportTotalQty, StringFormat='{}{0} قطعة'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                                </StackPanel>
                                                <Rectangle Height="1" Fill="#D1D5DB" Margin="0,4,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="الإجمالي الشامل لمبيعات الأقسام: " FontSize="13" FontWeight="Bold" Foreground="#047857" Width="190"/>
                                                    <TextBlock Text="{Binding CategoryReportTotalSales, StringFormat='{}{0:N0} ج.م'}" FontSize="15" FontWeight="Black" Foreground="#047857"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ==================== C. TAB 2: EXTENDED PRODUCT SALES (مبيعات منتج موسع) ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedReportTab}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Document Header -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="تقرير مبيعات منتج موسع" FontSize="20" FontWeight="Bold" Foreground="#D90429"/>
                                            <TextBlock Text="{Binding IsSingleProductMode, Converter={x:Null}}" FontSize="11" Foreground="#666666" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="ملخص مبيعات وكميات الأصناف المباعة خلال الفترة"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSingleProductMode}" Value="True">
                                                                <Setter Property="Text" Value="دورة حركات البيع والفواتير التفصيلية للصنف المحدد"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBlock Text="تقرير دورة المبيعات" FontSize="11" FontWeight="Bold" Foreground="#008000" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat='الفترة: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding EndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Rectangle Height="1.5" Fill="#D90429" Margin="0,0,0,16"/>

                                    <!-- SINGLE PRODUCT CYCLE DETAILS (Shown when a specific product is chosen) -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSingleProductMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Single Product Info Banner -->
                                        <Border Background="#FDF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SingleProductName}" FontSize="15" FontWeight="Bold" Foreground="#991B1B"/>
                                                        <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SingleProductSku, StringFormat='كود: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#991B1B"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding SingleProductCategory, StringFormat='القسم: {0}'}" FontSize="11" Foreground="#4B5563" Margin="0,0,14,0"/>
                                                        <TextBlock Text="{Binding SingleProductCurrentStock, StringFormat='المخزون الحالي: {0} قطعة'}" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding SingleProductPrice, StringFormat='سعر البيع: {0:N0} ج.م'}" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Invoices/Transactions Table Header -->
                                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="95"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="رقم الفاتورة" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="1" Text="التاريخ والوقت" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="2" Text="الكاشير" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="3" Text="الكمية" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="سعر الوحدة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="الخصم" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="الإجمالي" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Invoices/Transactions Items Rows -->
                                        <ItemsControl ItemsSource="{Binding SingleProductCycleReport}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="12,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="75"/>
                                                                <ColumnDefinition Width="85"/>
                                                                <ColumnDefinition Width="75"/>
                                                                <ColumnDefinition Width="95"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding ReceiptNumber}" FontWeight="Bold" FontSize="11" Foreground="#D90429" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" FontSize="11" Foreground="#4B5563" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CashierName}" FontSize="11" Foreground="#111827" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat='{}{0} قطعة'}" FontWeight="SemiBold" FontSize="12" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding UnitPrice, StringFormat='{}{0:N0} ج.م'}" FontSize="11" Foreground="#4B5563" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding DiscountAmount, StringFormat='{}{0:N0} ج.م'}" FontSize="11" Foreground="#EF4444" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding LineTotal, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" FontSize="12" Foreground="#047857" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Single Product Total Summary Box -->
                                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="ملخص دورة مبيعات الصنف" FontSize="13" FontWeight="Bold" Foreground="#D90429"/>
                                                    <TextBlock Text="{Binding ReportPeriodTitle}" FontSize="11" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding ProductReportActiveCount, StringFormat='إجمالي عدد حركات البيع: {0} حركة'}" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="إجمالي الكميات المباعة: " FontSize="12" Foreground="#4B5563" Width="140"/>
                                                        <TextBlock Text="{Binding ProductReportTotalQty, StringFormat='{}{0} قطعة'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                                    </StackPanel>
                                                    <Rectangle Height="1" Fill="#D1D5DB" Margin="0,4,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="الإجمالي الشامل لمبيعات الصنف: " FontSize="13" FontWeight="Bold" Foreground="#047857" Width="190"/>
                                                        <TextBlock Text="{Binding ProductReportTotalSales, StringFormat='{}{0:N0} ج.م'}" FontSize="15" FontWeight="Black" Foreground="#047857"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- ALL PRODUCTS SUMMARY TABLE (Shown when "كافة المنتجات" is chosen) -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSingleProductMode}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Products Table Header -->
                                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="65"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="كود الصنف" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="1" Text="اسم المنتج" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="2" Text="القسم" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="3" Text="سعر الوحدة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="الكمية المباعة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="إجمالي المبيعات" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="النسبة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Left"/>
                                            </Grid>
                                        </Border>

                                        <!-- Product Items Rows -->
                                        <ItemsControl ItemsSource="{Binding ProductSalesReport}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="12,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="65"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayCode}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontWeight="Bold" FontSize="12" Foreground="#111827" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CategoryName}" FontSize="11" Foreground="#4B5563" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat='{}{0:N0} ج.م'}" FontSize="11" Foreground="#4B5563" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding QuantitySold, StringFormat='{}{0} قطعة'}" FontWeight="SemiBold" FontSize="12" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding TotalSales, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" FontSize="12" Foreground="#047857" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            
                                                            <Border Grid.Column="6" Background="#FEF3C7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PercentageDisplay}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Product Sales Total Summary Box -->
                                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ملخص إجمالي مبيعات المنتجات" FontSize="13" FontWeight="Bold" Foreground="#D90429"/>
                                                <TextBlock Text="{Binding ReportPeriodTitle}" FontSize="11" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ProductReportActiveCount, StringFormat='عدد الأصناف المباعة بالتقرير: {0} أصناف'}" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="إجمالي الكميات المباعة: " FontSize="12" Foreground="#4B5563" Width="140"/>
                                                    <TextBlock Text="{Binding ProductReportTotalQty, StringFormat='{}{0} قطعة'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                                </StackPanel>
                                                <Rectangle Height="1" Fill="#D1D5DB" Margin="0,4,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="الإجمالي الشامل لمبيعات المنتجات: " FontSize="13" FontWeight="Bold" Foreground="#047857" Width="190"/>
                                                    <TextBlock Text="{Binding ProductReportTotalSales, StringFormat='{}{0:N0} ج.م'}" FontSize="15" FontWeight="Black" Foreground="#047857"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- ==================== D. TAB 3: INVOICES LEDGER (سجل الفواتير والمبيعات) ==================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedReportTab}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Document Header -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="تقرير سجل الفواتير والمبيعات التفصيلي" FontSize="20" FontWeight="Bold" Foreground="#D90429"/>
                                        <TextBlock Text="سجل شامل لكافة الفواتير الصادرة والمبيعات والخصومات والضرائب خلال الفترة" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                        <TextBlock Text="سجل مبيعات رسمي" FontSize="11" FontWeight="Bold" Foreground="#008000" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding StartDate, StringFormat='الفترة: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding EndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#666666"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Rectangle Height="1.5" Fill="#D90429" Margin="0,0,0,16"/>

                                <!-- Invoices Table Header -->
                                <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="165"/>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="رقم الفاتورة" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                        <TextBlock Grid.Column="1" Text="التاريخ والوقت" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                        <TextBlock Grid.Column="2" Text="الكاشير" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                                        <TextBlock Grid.Column="3" Text="القطع" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="المجموع" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="الخصم" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="الضريبة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="الإجمالي" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="الحالة" FontWeight="Bold" FontSize="11" Foreground="#4B5563" TextAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Invoices Items Rows -->
                                <ItemsControl ItemsSource="{Binding SalesInvoicesReport}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="165"/>
                                                        <ColumnDefinition Width="135"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding ReceiptNumber}" FontWeight="Bold" FontSize="11" Foreground="#D90429" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" FontSize="10" Foreground="#4B5563" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CashierName}" FontSize="11" Foreground="#111827" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ItemsCount, StringFormat='{}{0} ق'}" FontSize="11" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding SubTotal, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#4B5563" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding DiscountAmount, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#EF4444" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding TaxAmount, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding Total, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" FontSize="11" Foreground="#047857" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="8" Background="#ECFDF5" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#047857"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Invoices Total Summary Box -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ملخص إجمالي سجل المبيعات والفواتير" FontSize="13" FontWeight="Bold" Foreground="#D90429"/>
                                            <TextBlock Text="{Binding ReportPeriodTitle}" FontSize="11" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding SalesInvoicesReport.Count, StringFormat='عدد الفواتير: {0}'}" FontSize="11" Foreground="#666666" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding TotalDiscounts, StringFormat='إجمالي الخصومات: {0:N0} ج.م'}" FontSize="11" Foreground="#EF4444" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding TotalTax, StringFormat='إجمالي الضرائب: {0:N0} ج.م'}" FontSize="11" Foreground="#666666"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="إجمالي المبيعات الإجمالي: " FontSize="12" Foreground="#4B5563" Width="140"/>
                                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} ج.م'}" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="#D1D5DB" Margin="0,4,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="الإجمالي الشامل الصافي للفواتير: " FontSize="13" FontWeight="Bold" Foreground="#047857" Width="190"/>
                                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} ج.م'}" FontSize="15" FontWeight="Black" Foreground="#047857"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Document Footer Signature -->
                            <Grid Margin="0,32,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="مسؤول المبيعات / الكاشير: ...................." FontSize="10" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" Text="توقيع واعتماد الإدارة: ...................." FontSize="10" Foreground="#666666" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Placeholder when report not generated yet -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,80" Padding="40,30" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="16" Effect="{DynamicResource Axon3DCardShadow}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReportData}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="72" Height="72" Background="#22D90429" BorderBrush="#44D90429" BorderThickness="1" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="ChartBar" Width="36" Height="36" Foreground="#d90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="جاهز لاستخراج التقارير والتحليلات المالية" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="اختر نوع التقرير والفترة الزمنية المطلوب استخراجها من الشريط العلوي، ثم اضغط على زر [ إنشاء التقرير ]" Foreground="#A0A0A0" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Grid>
</UserControl>





<UserControl x:Class="Axon.UI.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#131313" Foreground="White"
             FontFamily="Segoe UI" FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style x:Key="ProductStatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="متوفر">
                    <Setter Property="Background" Value="#104ae176" />
                    <Setter Property="BorderBrush" Value="#4d4ae176" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="مخزون منخفض">
                    <Setter Property="Background" Value="#10ffb4ab" />
                    <Setter Property="BorderBrush" Value="#4dffb4ab" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="نفذت الكمية">
                    <Setter Property="Background" Value="#33ffb4ab" />
                    <Setter Property="BorderBrush" Value="#80ffb4ab" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProductStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="متوفر">
                    <Setter Property="Foreground" Value="#4ae176" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="مخزون منخفض">
                    <Setter Property="Foreground" Value="#ffb4ab" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="نفذت الكمية">
                    <Setter Property="Foreground" Value="#ffb4ab" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource Axon3DCardShadow}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#444444"/>
                    <Setter Property="Background" Value="#202020"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER WITH VIEW SWITCHER ==================== -->
        <Grid Grid.Row="0" Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title and Description -->
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariant" Width="28" Height="28" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="إدارة المنتجات والأقسام" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="التحكم الكامل في كتالوج الأصناف، التصنيفات، ومستويات المخزون للمؤسسة." Foreground="#8E8E93" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            
            <!-- View Selector & Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tab Selector Segmented Control -->
                <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Products Tab Button -->
                        <RadioButton GroupName="ViewModeGroup" Content="المنتجات"
                                     IsChecked="True"
                                     Click="ProductsTab_Click"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Foreground="White" Padding="14,6" FontSize="13" FontWeight="SemiBold"/>
                        <!-- Categories Tab Button -->
                        <RadioButton GroupName="ViewModeGroup" Content="الأقسام"
                                     Click="CategoriesTab_Click"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Foreground="White" Padding="14,6" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Dynamic Action Button: Add Product (Visible in Tab 0) -->
                <Button Command="{Binding OpenAddProductDialogCommand}" Background="#d90429" Foreground="White" BorderThickness="0" Padding="16,8" Height="38">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlusBox" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إضافة منتج جديد" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Dynamic Action Button: Add Category (Visible in Tab 1) -->
                <Button Command="{Binding OpenAddCategoryDialogCommand}" Background="#d90429" Foreground="White" BorderThickness="0" Padding="16,8" Height="38">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShapePlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إضافة قسم جديد" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== TAB 0: PRODUCTS MANAGEMENT ==================== -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Filters -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" Effect="{DynamicResource Axon3DCardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="تصفية حسب القسم" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" Foreground="#b4b5b5" IsChecked="{Binding IsChecked}" Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" Effect="{DynamicResource Axon3DCardShadow}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StockStatusFilter}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>
                            <RadioButton Content="{DynamicResource FilterAllProducts}" GroupName="StockFilter" Foreground="#b4b5b5" IsChecked="True" Margin="0,0,0,8"/>
                            <RadioButton Content="{DynamicResource FilterInStock}" GroupName="StockFilter" Foreground="#b4b5b5" Margin="0,0,0,8"/>
                            <RadioButton Content="{DynamicResource FilterLowStock}" GroupName="StockFilter" Foreground="#b4b5b5" Margin="0,0,0,8"/>
                            <RadioButton Content="{DynamicResource FilterOutOfStock}" GroupName="StockFilter" Foreground="#b4b5b5" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Main Products Table Area -->
            <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{DynamicResource Axon3DCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Products Table Header Bar with Search -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShowingProductsCountDisplay}" Foreground="#8E8E93" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Product Search Input -->
                        <Border Grid.Column="2" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="10,6" Width="280">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" FontSize="12" materialDesign:HintAssist.Hint="بحث باسم المنتج أو كود SKU..."/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Products Data Table (No outer ScrollViewer for proper rendering) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" Foreground="White" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SeparatorBrush}"
                              RowBackground="#161616" AlternatingRowBackground="#1A1A1A"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="48"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AxonDataGridColumnHeaderStyle}"/>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource AxonDataGridRowStyle}"/>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Product Image -->
                            <DataGridTemplateColumn Header="الصورة" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" Background="#111111" CornerRadius="6" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Product Name -->
                            <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" Foreground="White"/>
                            
                            <!-- SKU -->
                            <DataGridTextColumn Header="رمز الصنف (SKU)" Binding="{Binding Sku}" Width="1.2*" Foreground="#b4b5b5"/>
                            
                            <!-- Category -->
                            <DataGridTextColumn Header="القسم" Binding="{Binding Category}" Width="1.2*" Foreground="#E0E0E0"/>
                            
                            <!-- Stock Level Badge -->
                            <DataGridTemplateColumn Header="مستوى المخزون" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ProductStatusBadgeStyle}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource ProductStatusTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Price -->
                            <DataGridTextColumn Header="السعر" Binding="{Binding Price, StringFormat='{}{0:N2} ج.م'}" Width="1*" FontWeight="Bold" Foreground="White"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="إجراءات" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.OpenEditProductDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#3B82F6" Padding="4" Height="28" Width="28" ToolTip="تعديل">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Padding="4" Height="28" Width="28" ToolTip="حذف">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="{Binding PaginationCountDisplay}" Foreground="#8E8E93" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== TAB 1: CATEGORIES MANAGEMENT ==================== -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- KPI Cards -->
                <RowDefinition Height="*"/>    <!-- Categories Table -->
            </Grid.RowDefinitions>

            <!-- 2 KPI Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Categories Card -->
                <Border Grid.Column="0" Style="{StaticResource HoverCardStyle}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#1E293B" VerticalAlignment="Center" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="ViewList" Width="22" Height="22" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي الأقسام" FontSize="12" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalCategoriesCount}" FontSize="24" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active Categories Card -->
                <Border Grid.Column="2" Style="{StaticResource HoverCardStyle}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#152E22" VerticalAlignment="Center" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="22" Height="22" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="الأقسام النشطة" FontSize="12" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCategoriesCount}" FontSize="24" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Categories Data Table Area -->
            <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{DynamicResource Axon3DCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,16" HorizontalAlignment="Left" Width="320">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" FontSize="13" materialDesign:HintAssist.Hint="البحث في الأقسام..."/>
                        </Grid>
                    </Border>

                    <!-- Categories DataGrid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <DataGrid ItemsSource="{Binding CategoryItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="Transparent" Foreground="White" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SeparatorBrush}"
                                  RowBackground="Transparent" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AxonDataGridColumnHeaderStyle}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource AxonDataGridRowStyle}"/>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="14,10" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" FontWeight="Bold" Foreground="#8E8E93"/>
                                <DataGridTextColumn Header="اسم القسم (عربي)" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="الوصف / الاسم بالإنجليزي" Binding="{Binding Description}" Width="2*" Foreground="#b4b5b5"/>
                                
                                <!-- Linked Products Count Badge -->
                                <DataGridTemplateColumn Header="المنتجات المرتبطة" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#242424" BorderBrush="#353534" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="14" Height="14" Foreground="#ffb3af" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding ProductsCount, StringFormat='{}{0} منتج'}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status Badge -->
                                <DataGridTemplateColumn Header="الحالة" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#104ae176" BorderBrush="#4d4ae176" BorderThickness="1" CornerRadius="12" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="نشط" Foreground="#4ae176" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="إجراءات" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.OpenEditCategoryDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#3B82F6" Padding="4" Height="28" Width="28" ToolTip="تعديل">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Padding="4" Height="28" Width="28" ToolTip="حذف">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== MODAL 1: ADD / EDIT PRODUCT DIALOG ==================== -->
        <Grid Grid.RowSpan="2" Background="#B3000000" Visibility="{Binding IsAddProductDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource Axon3DDialogShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                    <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Product Name AR -->
                            <TextBlock Text="اسم المنتج (عربي) *" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewProductNameAR, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8" Margin="0,0,0,12"/>

                            <!-- Product Name EN -->
                            <TextBlock Text="اسم المنتج (إنجليزي - اختياري)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewProductNameEN, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8" Margin="0,0,0,12"/>

                            <!-- Category Selection & Tax Classification -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Category Selection Dropdown -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="القسم (التصنيف) *" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding DialogCategories}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewProductCategoryId, Mode=TwoWay}"
                                              Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1"
                                              Padding="8,6"/>
                                </StackPanel>
                                
                                <!-- Tax Classification -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تصنيف الضريبة *" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                                    <Border Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="4">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="عليه ضريبة"
                                                         IsChecked="{Binding NewProductIsTaxable, Mode=TwoWay}"
                                                         GroupName="TaxClassGroup"
                                                         Foreground="#b4b5b5" Margin="4,2" Padding="4,2"
                                                         VerticalContentAlignment="Center"/>
                                            <RadioButton Content="بدون ضريبة"
                                                         IsChecked="{Binding NewProductIsNotTaxable, Mode=TwoWay}"
                                                         GroupName="TaxClassGroup"
                                                         Foreground="#b4b5b5" Margin="4,2" Padding="4,2"
                                                         VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- SKU & Barcode -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="رمز الصنف (SKU)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewProductSKU, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الباركود (المرجع)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewProductBarcode, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8"/>
                                </StackPanel>
                            </Grid>

                            <!-- Selling Price & Cost Price -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="سعر البيع *" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewProductSellingPrice, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="سعر الشراء (التكلفة)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewProductCostPrice, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8"/>
                                </StackPanel>
                            </Grid>

                            <!-- Stock -->
                            <TextBlock Text="الكمية بالمخزون" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewProductStock, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8" Margin="0,0,0,12"/>

                            <!-- Image Path -->
                            <TextBlock Text="صورة المنتج (اختياري)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewProductImagePath, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8"/>
                                <Button Grid.Column="2" Command="{Binding BrowseProductImageCommand}" Content="استعراض..." Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" Padding="12,4"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid>
                        <Button Content="إلغاء" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding CloseAddProductDialogCommand}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" HorizontalAlignment="Left" Width="100"/>
                        <Button Content="حفظ المنتج" Command="{Binding SaveProductCommand}" Background="#d90429" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" Width="120"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL 2: ADD / EDIT CATEGORY DIALOG ==================== -->
        <Grid Grid.RowSpan="2" Background="#B3000000" Visibility="{Binding IsAddCategoryDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource Axon3DDialogShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="ShapePlus" Width="24" Height="24" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding CategoryDialogTitle}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Category Name AR -->
                    <TextBlock Text="اسم القسم (عربي) *" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCategoryNameAR, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8" Margin="0,0,0,14"/>

                    <!-- Category Name EN / Description -->
                    <TextBlock Text="اسم القسم (إنجليزي / الوصف)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCategoryNameEN, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="8" Margin="0,0,0,20"/>

                    <Grid>
                        <Button Content="إلغاء" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding CloseCategoryDialogCommand}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" HorizontalAlignment="Left" Width="100"/>
                        <Button Content="حفظ القسم" Command="{Binding SaveCategoryCommand}" Background="#d90429" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" Width="120"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

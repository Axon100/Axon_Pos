<UserControl x:Class="Axon.UI.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#111111" Foreground="White"
             FontFamily="Segoe UI" FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header & Filters -->
            <RowDefinition Height="Auto"/> <!-- 2. KPI Cards -->
            <RowDefinition Height="*"/>    <!-- 3. Expenses Catalog/Table Area -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. PAGE HEADER & DATE FILTERS ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashMinus" Width="28" Height="28" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="المصروفات الخارجية والنفقات" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="تسجيل وتتبع المصروفات الإدارية، الصيانة، النثريات، والمدفوعات التشغيلية للمتجر." Foreground="#8E8E93" FontSize="13" Margin="38,4,0,0"/>
            </StackPanel>

            <!-- Filters Bar (Date Range + Add Button) -->
            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="14,8" VerticalAlignment="Center" Effect="{DynamicResource Axon3DCardShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- From Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="من:" Foreground="#B3B3B3" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Width="130" Height="34" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" FontSize="12" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="إلى:" Foreground="#B3B3B3" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Width="130" Height="34" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" FontSize="12" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Add Expense Button -->
                    <Button Command="{Binding AddExpenseCommand}" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="38" Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusBox" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تسجيل مصروف جديد" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 2. 3D KPI STATS CARDS ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Expenses in Period Card -->
            <Border Grid.Column="0" Style="{StaticResource Axon3DCardStyle}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="إجمالي المصروفات والنفقات" Foreground="#B3B3B3" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalExpensesAmount, StringFormat='{}{0:N0} ج.م'}" FontSize="24" FontWeight="ExtraBold" Foreground="#EF4444"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22EF4444" Width="46" Height="46" CornerRadius="12" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashMinus" Width="26" Height="26" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Count of Operations Card -->
            <Border Grid.Column="2" Style="{StaticResource Axon3DCardStyle}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="عدد عمليات وقيود الصرف" Foreground="#B3B3B3" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalExpensesCount, StringFormat='{}{0} قيد'}" FontSize="24" FontWeight="ExtraBold" Foreground="#60A5FA"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#2260A5FA" Width="46" Height="46" CornerRadius="12" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ReceiptText" Width="26" Height="26" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Top Expense Category Card -->
            <Border Grid.Column="4" Style="{StaticResource Axon3DCardStyle}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="أعلى بند مصروفات استهلاكاً" Foreground="#B3B3B3" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TopExpenseCategory}" FontSize="20" FontWeight="ExtraBold" Foreground="#FBBF24" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FBBF24" Width="46" Height="46" CornerRadius="12" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ChartPie" Width="26" Height="26" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. EXPENSES MAIN CONTENT AREA ==================== -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="20" Effect="{DynamicResource Axon3DCardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Bar (Search Box + View Switcher) -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" Foreground="#d90429" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="سجل قيود ومصروفات المتجر" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- View Switcher (3D Cards / Table) -->
                    <Border Grid.Column="2" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetCardViewModeCommand}" ToolTip="عرض كروت المصروفات (3D Boxes)" Style="{StaticResource Axon3DSecondaryButtonStyle}" Padding="10,4" Height="32" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewGrid" Width="18" Height="18" Foreground="{DynamicResource AxonPrimaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="بوكسات" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetTableViewModeCommand}" ToolTip="عرض الجدول القياسي" Style="{StaticResource Axon3DSecondaryButtonStyle}" Padding="10,4" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Table" Width="18" Height="18" Foreground="{DynamicResource AxonSecondaryTextBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="جدول" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search Input Box -->
                    <Border Grid.Column="3" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="10,6" Width="260">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" FontSize="12" materialDesign:HintAssist.Hint="بحث في المصروفات أو البيان..."/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 1. 3D EXPENSES BOX CARDS CATALOG VIEW ==================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardViewMode}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ItemsControl ItemsSource="{Binding FilteredExpenses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 3D Card Box Container with Upward TranslateY Animation & Light Red Glow -->
                                <Border Style="{StaticResource Axon3DCardStyle}" Width="300" Margin="0,0,16,16" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Category Badge & Reference Doc Number -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Border Background="#22EF4444" BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TagOutline" Width="14" Height="14" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DocNumber}" Foreground="#B3B3B3" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Description / Reason for Expense -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Description}" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#737373" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Date}" FontSize="11" Foreground="#737373" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Row 2: Expense Amount Box -->
                                        <Border Grid.Row="2" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="المبلغ المصروف" FontSize="10" Foreground="#737373" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} ج.م'}" FontSize="20" FontWeight="ExtraBold" Foreground="#EF4444"/>
                                                </StackPanel>
                                                <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PaymentMethod}" FontSize="11" Foreground="#B3B3B3" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ==================== 2. EXPENSES DATA TABLE VIEW ==================== -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredExpenses}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#222222"
                          HeadersVisibility="Column" RowBackground="#161616" AlternatingRowBackground="#1A1A1A" SelectionMode="Single" RowHeight="48"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardViewMode}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AxonDataGridColumnHeaderStyle}"/>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AxonDataGridRowStyle}"/>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- رقم المستند -->
                        <DataGridTextColumn Header="رقم المستند" Binding="{Binding DocNumber}" Width="120" FontWeight="Bold"/>

                        <!-- بيان وسبب الصرف -->
                        <DataGridTemplateColumn Header="بيان وسبب الصرف" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- تصنيف المصروف -->
                        <DataGridTemplateColumn Header="التصنيف / الفئة" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#22EF4444" BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#EF4444" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- طريقة الدفع -->
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="130" Foreground="#B3B3B3"/>

                        <!-- التاريخ -->
                        <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date}" Width="150" Foreground="#B3B3B3"/>

                        <!-- المبلغ -->
                        <DataGridTemplateColumn Header="المبلغ المصروف" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} ج.م'}" FontWeight="ExtraBold" FontSize="14" Foreground="#EF4444"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>






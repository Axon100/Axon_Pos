<Window x:Class="Axon.UI.Views.DeductStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="خصم كمية من المخزون" Height="380" Width="440"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FBBF24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#b4b5b5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <!-- Solid High-End Axon 3D Dark Card -->
    <Border CornerRadius="16" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="-90" RenderingBias="Quality" ShadowDepth="4" Opacity="0.85" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content Form -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" Padding="20,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="MinusCircleOutline" Width="24" Height="24" Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="خصم وسحب كمية من المخزون" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Click="Close_Click" Foreground="#8E8E93">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Form -->
            <Border Grid.Row="1" Padding="22,18">
                <StackPanel>
                    <!-- Product Info Box -->
                    <Border Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="الصنف المحدد:" FontSize="11" Foreground="#8E8E93" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtProductName" Text="اسم المنتج" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <Border Grid.Column="1" VerticalAlignment="Center" Background="#224AE176" BorderBrush="#444AE176" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="المتاح بالرصيد: " FontSize="11" Foreground="#4AE176" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtCurrentStock" Text="0" FontSize="12" Foreground="#4AE176" FontWeight="ExtraBold"/>
                                    <TextBlock Text=" قطعة" FontSize="11" Foreground="#4AE176" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Quantity to Deduct Input -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="الكمية المراد خصمها (عدد القطع) *"/>
                    <TextBox x:Name="TxtDeductQuantity" Style="{StaticResource InputField}" Margin="0,0,0,6" PreviewTextInput="NumberValidationTextBox" materialDesign:HintAssist.Hint="أدخل عدد القطع المراد خصمها (مثال: 5)"/>
                </StackPanel>
            </Border>

            <!-- Actions Footer -->
            <Border Grid.Row="2" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Confirm Deduct Button -->
                    <Button Grid.Column="0" Content="تأكيد خصم الكمية" Click="Save_Click" Background="#d90429" Foreground="White" BorderThickness="0" Height="40" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Cancel Button -->
                    <Button Grid.Column="2" Content="إلغاء" Click="Close_Click" Background="#1F1F1F" Foreground="#b4b5b5" BorderBrush="#2C2C2C" BorderThickness="1" Height="40" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="Axon.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" Height="620" Width="960"
        Icon="/Assets/app.ico"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0A0A0C" Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <!-- Outer Main Card Container -->
    <Border BorderBrush="#242428" BorderThickness="1" CornerRadius="16" Background="#141416" ClipToBounds="True" Effect="{DynamicResource Axon3DDialogShadow}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Window TitleBar -->
            <Grid Grid.Row="0" Background="#141416" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#8E8E93" Padding="0" Height="28" Width="32" ToolTip="تصغير">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Padding="0" Height="28" Width="32" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="WindowClose" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content 2-Column Split Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/> <!-- Right Column in RTL: Login Form -->
                    <ColumnDefinition Width="1*"/>    <!-- Left Column in RTL: ERP AXON Showcase Panel -->
                </Grid.ColumnDefinitions>

                <!-- ==================== COLUMN 0 (RIGHT SIDE IN RTL): LOGIN FORM ==================== -->
                <Border Grid.Column="0" Padding="48,20,48,32" VerticalAlignment="Center">
                    <StackPanel>
                        <!-- Header Greeting -->
                        <TextBlock Text="أهلاً بك مجدداً!" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="الرجاء إدخال بيانات حسابك للوصول إلى النظام" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                        <!-- Field 1: Username / Email -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="البريد الإلكتروني" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                            <Border Background="#1F1F23" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="46">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="White" FontSize="13" VerticalAlignment="Center"
                                             CaretBrush="#FF2B4A"/>
                                    <materialDesign:PackIcon Grid.Column="1" Kind="EmailOutline" Width="18" Height="18" Foreground="#66666E" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Field 2: Password with Eye Toggle -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="كلمة المرور" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                            <Border Background="#1F1F23" BorderBrush="#2D2D32" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="46">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <PasswordBox x:Name="SecretPasswordBox" Grid.Column="0"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="White" FontSize="13" VerticalAlignment="Center"
                                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                                    <TextBox x:Name="PlainPasswordBox" Grid.Column="0"
                                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="White" FontSize="13" VerticalAlignment="Center"
                                             TextChanged="PlainPasswordBox_TextChanged"
                                             Visibility="Collapsed" CaretBrush="#FF2B4A"/>

                                    <Button Grid.Column="1" Click="ToggleEye_Click" Command="{Binding TogglePasswordVisibilityCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                            VerticalAlignment="Center" Margin="4,0,0,0" Padding="0" Height="28" Width="28" ToolTip="إظهار / إخفاء كلمة المرور">
                                        <materialDesign:PackIcon x:Name="EyeIcon" Kind="Eye" Width="16" Height="16" Foreground="#66666E"/>
                                    </Button>

                                    <materialDesign:PackIcon Grid.Column="2" Kind="LockOutline" Width="18" Height="18" Foreground="#66666E" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Remember Me Checkbox -->
                        <CheckBox Content="تذكرني على هذا الجهاز" 
                                  IsChecked="{Binding KeepMeSignedIn}" 
                                  Margin="0,4,0,24" Foreground="#8E8E93" FontSize="12"/>

                        <!-- Login Button (دخول النظام) -->
                        <Button Command="{Binding LoginCommand}" 
                                Height="48"
                                Background="#FF2B4A" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF2B4A"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF425F"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#D91E3B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="دخول النظام" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Login" Width="20" Height="20" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Progress & Error Feedback -->
                        <ProgressBar IsIndeterminate="True" 
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,12,0,0" Foreground="#FF2B4A" Height="3"/>

                        <TextBlock Margin="0,12,0,0" Text="{Binding ErrorMessage}" 
                                   Foreground="#EF4444" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- ==================== COLUMN 1 (LEFT SIDE IN RTL): ERP AXON SHOWCASE ==================== -->
                <Border Grid.Column="1" Background="#0F0F11" BorderBrush="#242428" BorderThickness="1,0,0,0" Padding="36,28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header Branding -->
                            <RowDefinition Height="*"/>    <!-- Hero & Features List -->
                            <RowDefinition Height="Auto"/> <!-- Footer -->
                        </Grid.RowDefinitions>

                        <!-- 1. Header Branding (Top Right of Left Column) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ERP " FontSize="16" FontWeight="Black" Foreground="White"/>
                                    <TextBlock Text="AXON" FontSize="16" FontWeight="Black" Foreground="#FF2B4A"/>
                                </StackPanel>
                                <TextBlock Text="للتوريدات والمخازن" FontSize="10" Foreground="#8E8E93" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#260C11" BorderBrush="#4D151D" BorderThickness="1">
                                <materialDesign:PackIcon Kind="HomeVariantOutline" Foreground="#FF2B4A" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- 2. Hero Title & 3 Feature Showcase Cards -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,20">
                            <!-- Hero Title & Paragraph -->
                            <TextBlock Text="إدارة أعمالك باحترافية" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,0,0,10" HorizontalAlignment="Right"/>
                            <TextBlock Text="نظام سحابي ذكي لإدارة مخازنك، تتبع بضائعك، طباعة الباركود، وتحرير المبيعات والمشتريات بسرعة فائقة." 
                                       FontSize="12" Foreground="#A0A0AB" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,36" HorizontalAlignment="Right"/>

                            <!-- Feature 1: إدارة الفروع والمستودعات -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="إدارة الفروع والمستودعات" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Background="#1A1A1E" BorderBrush="#2A2A30" BorderThickness="1" Margin="14,0,0,0">
                                    <materialDesign:PackIcon Kind="GridLarge" Foreground="#FF2B4A" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Feature 2: ملصقات الباركود و QR مخصصة -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ملصقات الباركود و QR مخصصة" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Background="#1A1A1E" BorderBrush="#2A2A30" BorderThickness="1" Margin="14,0,0,0">
                                    <materialDesign:PackIcon Kind="QrcodeScan" Foreground="#FF2B4A" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Feature 3: تقارير وتحليلات متطورة -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تقارير وتحليلات متطورة" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Background="#1A1A1E" BorderBrush="#2A2A30" BorderThickness="1" Margin="14,0,0,0">
                                    <materialDesign:PackIcon Kind="ChartBar" Foreground="#FF2B4A" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- 3. Footer Section -->
                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                            <TextBlock Text="© 2026 حلول Axon" FontSize="11" Foreground="#55555C" HorizontalAlignment="Right"/>
                            <TextBlock Text="إصدار 1.0" FontSize="11" Foreground="#55555C" HorizontalAlignment="Left"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

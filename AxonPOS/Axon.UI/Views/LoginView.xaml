<Window x:Class="Axon.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" Height="540" Width="420"
        Icon="/Assets/app.ico"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#111111" Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Background="#111111" ClipToBounds="True" Effect="{DynamicResource Axon3DDialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Window TitleBar -->
            <Grid Grid.Row="0" Background="#181818" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Axon POS - تسجيل الدخول" FontSize="13" FontWeight="SemiBold" Foreground="#B3B3B3" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#B3B3B3" Padding="0" Height="32" Width="36" ToolTip="تصغير">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Padding="0" Height="32" Width="36" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Card -->
            <Grid Grid.Row="1" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Image Source="/Assets/logo.png" Height="44" HorizontalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{DynamicResource SignInToContinue}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#B3B3B3"/>
                </StackPanel>

                <!-- Username Input -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource UserID}" FontSize="13" FontWeight="SemiBold" Foreground="#B3B3B3" Margin="0,0,0,6"/>
                    <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="46">
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                
                <!-- Password Input with Eye Toggle -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource Password}" FontSize="13" FontWeight="SemiBold" Foreground="#B3B3B3" Margin="0,0,0,6"/>
                    <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="46">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="SecretPasswordBox" Grid.Column="0"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="White" FontSize="14" VerticalAlignment="Center"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>

                            <TextBox x:Name="PlainPasswordBox" Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="White" FontSize="14" VerticalAlignment="Center"
                                     TextChanged="PlainPasswordBox_TextChanged"
                                     Visibility="Collapsed"/>

                            <Button Grid.Column="1" Click="ToggleEye_Click" Command="{Binding TogglePasswordVisibilityCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" 
                                    VerticalAlignment="Center" Margin="6,0,0,0" Padding="0" Height="30" Width="30" ToolTip="إظهار / إخفاء كلمة المرور">
                                <materialDesign:PackIcon x:Name="EyeIcon" Kind="Eye" Width="18" Height="18" Foreground="#B3B3B3"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <CheckBox Grid.Row="3" Content="{DynamicResource KeepMeSignedIn}" 
                          IsChecked="{Binding KeepMeSignedIn}" 
                          Margin="0,0,0,24" Foreground="#B3B3B3"/>

                <!-- Tactile 3D Login Button -->
                <Button Grid.Row="4" Content="{DynamicResource SignIn}" 
                        Command="{Binding LoginCommand}" 
                        Style="{StaticResource Axon3DPrimaryButtonStyle}" 
                        Height="46" FontSize="15" FontWeight="Bold">
                </Button>
                
                <ProgressBar Grid.Row="5" IsIndeterminate="True" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Margin="0,8,0,0" Foreground="#D90429"/>

                <TextBlock Grid.Row="6" Margin="0,12,0,0" Text="{Binding ErrorMessage}" 
                           Foreground="#EF4444" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="Axon.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" Height="520" Width="860"
        Icon="/Assets/app.ico"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="16" Background="#0F0F0F" BorderBrush="#262626" BorderThickness="1.5" Effect="{DynamicResource Axon3DWindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Top Accent Line -->
                <RowDefinition Height="*"/>    <!-- Content Container -->
            </Grid.RowDefinitions>

            <!-- 1. Top Red Accent Line -->
            <Border Grid.Row="1" Height="3" Background="#D90429" VerticalAlignment="Top"/>

            <!-- 2. Custom Window Title Bar -->
            <Grid Grid.Row="0" Height="40" Background="#141414" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Axon POS — تسجيل الدخول للنظام" FontSize="12" FontWeight="Bold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#8E8E93" Padding="0" Height="32" Width="36" ToolTip="تصغير">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Padding="0" Height="32" Width="36" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 3. Horizontal Two-Column Main Layout -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/> <!-- Right Column (Branding & Features) -->
                    <ColumnDefinition Width="1.3*"/> <!-- Left Column (Login Form Card) -->
                </Grid.ColumnDefinitions>

                <!-- ==================== COLUMN 0: HERO BRANDING PANEL ==================== -->
                <Border Grid.Column="0" Background="#141414" BorderBrush="#242424" BorderThickness="0,0,1,0" Padding="28,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Brand Logo & Header -->
                        <StackPanel Grid.Row="0" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <Border Width="52" Height="52" CornerRadius="12" Background="#261014" BorderBrush="#D90429" BorderThickness="1.5" Padding="6" Margin="0,0,12,0">
                                    <Image Source="/Assets/logo.png" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Axon POS" FontSize="22" FontWeight="Black" Foreground="White"/>
                                    <TextBlock Text="Enterprise Edition v2.0" FontSize="11" FontWeight="Bold" Foreground="#D90429"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="منظومة إدارة المبيعات والمخازن الحسابية الذكية" FontSize="12" Foreground="#8E8E93" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Feature Highlights List -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,16">
                            <!-- Feature 1 -->
                            <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#261014" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="LightningBolt" Width="14" Height="14" Foreground="#D90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="سرعة فائقة ومعالجة مبيعات لحظية" FontSize="11" FontWeight="Bold" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Feature 2 -->
                            <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#142B1A" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ShieldCheck" Width="14" Height="14" Foreground="#4AE176" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="نظام حماية وتشفير عالي للصلاحيات" FontSize="11" FontWeight="Bold" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Feature 3 -->
                            <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#101C2B" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ChartBox" Width="14" Height="14" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="تقارير أرباح وخسائر دقيقة ومدققة" FontSize="11" FontWeight="Bold" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Support Card Footer -->
                        <Border Grid.Row="2" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8" Cursor="Hand" MouseDown="WhatsApp_Click" ToolTip="اضغط للتواصل المباشر عبر الواتساب">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#261014" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Headset" Width="15" Height="15" Foreground="#D90429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="الدعم الفني والترخيص" FontSize="10" FontWeight="Bold" Foreground="#CCCCCC"/>
                                    <TextBlock Text="01158906986" FontSize="10" Foreground="#8E8E93" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#152E22" BorderBrush="#4D4ADE80" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Whatsapp" Width="13" Height="13" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="واتساب" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== COLUMN 1: LOGIN FORM CARD ==================== -->
                <Grid Grid.Column="1" Margin="32,24,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- Username -->
                        <RowDefinition Height="Auto"/> <!-- Password -->
                        <RowDefinition Height="Auto"/> <!-- CheckBox -->
                        <RowDefinition Height="Auto"/> <!-- Login Button -->
                        <RowDefinition Height="Auto"/> <!-- Progress / Status -->
                        <RowDefinition Height="*"/>    <!-- Copyright -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="تسجيل الدخول للنظام" FontSize="20" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="أهلاً بك! يرجى إدخال بيانات حسابك للمتابعة" FontSize="11" Foreground="#8E8E93" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Username Field -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="اسم المستخدم / رقم الحساب" FontSize="11" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                        <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="42">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18" Foreground="#D90429" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Password Field -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="كلمة المرور" FontSize="11" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                        <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="42">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="LockOutline" Width="18" Height="18" Foreground="#D90429" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <PasswordBox x:Name="SecretPasswordBox" Grid.Column="1"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>

                                <TextBox x:Name="PlainPasswordBox" Grid.Column="1"
                                         Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                         TextChanged="PlainPasswordBox_TextChanged"
                                         Visibility="Collapsed"/>

                                <Button Grid.Column="2" Click="ToggleEye_Click" Command="{Binding TogglePasswordVisibilityCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}" Foreground="#8E8E93"
                                        VerticalAlignment="Center" Margin="4,0,0,0" Padding="0" Height="28" Width="28" ToolTip="إظهار / إخفاء كلمة المرور">
                                    <materialDesign:PackIcon x:Name="EyeIcon" Kind="Eye" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Remember Me Checkbox -->
                    <CheckBox Grid.Row="3" Content="تذكر بيانات الدخول على هذا الجهاز" 
                              IsChecked="{Binding KeepMeSignedIn}" 
                              Margin="0,0,0,16" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"/>

                    <!-- Login Button -->
                    <Button Grid.Row="4" Command="{Binding LoginCommand}" 
                            Style="{StaticResource Axon3DPrimaryButtonStyle}" 
                            Height="44" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Login" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تسجيل الدخول الآن" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Progress Bar & Error Alert Container -->
                    <StackPanel Grid.Row="5" Margin="0,8,0,0">
                        <ProgressBar IsIndeterminate="True" 
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Height="3" Foreground="#D90429"/>

                        <Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="#22EF4444" BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#EF4444" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Copyright Footer -->
                    <TextBlock Grid.Row="6" Text="Axon POS Enterprise v2.0 • جميع الحقوق محفوظة" 
                               FontSize="10" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
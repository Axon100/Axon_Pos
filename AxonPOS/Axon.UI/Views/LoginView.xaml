<Window x:Class="Axon.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" Height="600" Width="440"
        Icon="/Assets/app.ico"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <!-- Outer Window Card with Glow & Shadow -->
    <Border BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="16" Background="#111111" ClipToBounds="True" Effect="{DynamicResource Axon3DDialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>  <!-- Crimson Top Accent Bar -->
                <RowDefinition Height="42"/> <!-- Custom TitleBar -->
                <RowDefinition Height="*"/>  <!-- Login Card Content -->
            </Grid.RowDefinitions>

            <!-- 1. Top Crimson Glow Line -->
            <Rectangle Grid.Row="0" Fill="#d90429"/>

            <!-- 2. Custom TitleBar -->
            <Grid Grid.Row="1" Background="#161616" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Axon POS — تسجيل الدخول" FontSize="12" FontWeight="Bold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#8E8E93" Padding="0" Height="32" Width="36" ToolTip="تصغير">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Padding="0" Height="32" Width="36" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 3. Main Login Card Body -->
            <Grid Grid.Row="2" Margin="32,24,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Hero Logo & Welcome -->
                    <RowDefinition Height="Auto"/> <!-- Username Field -->
                    <RowDefinition Height="Auto"/> <!-- Password Field -->
                    <RowDefinition Height="Auto"/> <!-- Remember Me -->
                    <RowDefinition Height="Auto"/> <!-- Login Button -->
                    <RowDefinition Height="Auto"/> <!-- Progress / Status -->
                    <RowDefinition Height="*"/>    <!-- Footer Signature -->
                </Grid.RowDefinitions>

                <!-- Hero Branding Badge -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <!-- Circular Glowing Card -->
                    <Border Width="72" Height="72" CornerRadius="36" Background="#161616" BorderBrush="#d90429" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14" Effect="{DynamicResource Axon3DCardShadow}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/logo.png" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="تسجيل الدخول للنظام" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="أهلاً بك! يرجى إدخال بيانات حسابك للمتابعة" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Username Input -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="رقم المستخدم / اسم الحساب" FontSize="12" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="12,0" Height="48">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Password Input with Eye Toggle -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="كلمة المرور" FontSize="12" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="12,0" Height="48">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="LockOutline" Width="20" Height="20" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <PasswordBox x:Name="SecretPasswordBox" Grid.Column="1"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>

                            <TextBox x:Name="PlainPasswordBox" Grid.Column="1"
                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                     TextChanged="PlainPasswordBox_TextChanged"
                                     Visibility="Collapsed"/>

                            <Button Grid.Column="2" Click="ToggleEye_Click" Command="{Binding TogglePasswordVisibilityCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}" Foreground="#8E8E93"
                                    VerticalAlignment="Center" Margin="4,0,0,0" Padding="0" Height="30" Width="30" ToolTip="إظهار / إخفاء كلمة المرور">
                                <materialDesign:PackIcon x:Name="EyeIcon" Kind="Eye" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Remember Me Checkbox -->
                <CheckBox Grid.Row="3" Content="تذكر بيانات الدخول على هذا الجهاز" 
                          IsChecked="{Binding KeepMeSignedIn}" 
                          Margin="0,0,0,22" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold"/>

                <!-- Tactile 3D Login Action Button -->
                <Button Grid.Row="4" Command="{Binding LoginCommand}" 
                        Style="{StaticResource Axon3DPrimaryButtonStyle}" 
                        Height="48" Cursor="Hand">
                    <Grid Width="340">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Login" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تسجيل الدخول الآن" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Progress Bar & Error Alert Container -->
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <ProgressBar IsIndeterminate="True" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Height="3" Foreground="#D90429"/>

                    <Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#22EF4444" BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#EF4444" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer Signature -->
                <TextBlock Grid.Row="6" Text="Axon POS Enterprise v2.0 • جميع الحقوق محفوظة" 
                           FontSize="10" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,12,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="Axon.UI.Views.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إعدادات قاعدة البيانات - Axon POS Setup" 
        Icon="/Assets/app.ico"
        Height="720" Width="900"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#111111" Foreground="White"
        FontFamily="{DynamicResource AppFont}" FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Grid Grid.Row="0" Background="#181818" MouseDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,8">
                <materialDesign:PackIcon Kind="DatabaseSettings" Foreground="#d90429" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Axon POS - إعدادات قاعدة البيانات" FontSize="13" Foreground="#b4b5b5" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#b4b5b5" Padding="8,4" Height="36" Width="44" ToolTip="تصغير">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                </Button>
                <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#ffb4ab" Padding="8,4" Height="36" Width="44" ToolTip="إغلاق">
                    <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="DatabaseSettings" Width="36" Height="36" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="وضع التهيئة التشغيلي - إعدادات SQL Server" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="لم يتم العثور على قاعدة البيانات أو تعذر الاتصال بخادم SQL Server. يرجى تهيئة الاتصال أدناه للمتابعة." Foreground="#b4b5b5" FontSize="14"/>
            </StackPanel>

        <!-- Body Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Status Banner -->
                <Border Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#22104ae1"/>
                            <Setter Property="BorderBrush" Value="#4d104ae1"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccessStatus}" Value="True">
                                    <Setter Property="Background" Value="#15104ae1"/>
                                    <Setter Property="BorderBrush" Value="#4ae176"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSuccessStatus}" Value="False">
                                    <Setter Property="Background" Value="#25d90429"/>
                                    <Setter Property="BorderBrush" Value="#d90429"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#ffb4ab"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessStatus}" Value="True">
                                        <Setter Property="Foreground" Value="#4ae176"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="معلومات خادم SQL Server" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم السيرفر (Server Name)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="12,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="اسم قاعدة البيانات (Database Name)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="12,8"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="نوع المصادقة (Authentication Type)" Foreground="#b4b5b5" FontSize="12" Margin="0,8,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="Windows Authentication" IsChecked="{Binding UseWindowsAuth}" Foreground="White" Margin="0,0,24,0"/>
                            <RadioButton Content="SQL Server Authentication" IsChecked="{Binding UseWindowsAuth, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="White"/>
                        </StackPanel>

                        <!-- SQL Server Credentials -->
                        <Grid Margin="0,0,0,16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseWindowsAuth}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم المستخدم (Username)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="12,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="كلمة المرور (Password)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="12,8"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="تفعيل الوضع المتقدم (سلسلة اتصال مخصصة)" IsChecked="{Binding IsAdvancedMode}" Foreground="#b4b5b5" Margin="0,8,0,12"/>

                        <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="سلسلة الاتصال المباشرة (Full Connection String)" Foreground="#b4b5b5" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding FullConnectionString, UpdateSourceTrigger=PropertyChanged}" Background="#111111" Foreground="White" BorderBrush="#2C2C2C" BorderThickness="1" Padding="12,8" TextWrapping="Wrap" MinHeight="60"/>

                            <TextBlock Text="نماذج الاتصال السريعة (Sample Presets):" Foreground="#b4b5b5" FontSize="11" Margin="0,6,0,6"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Command="{Binding SetLocalExpressSampleCommand}" Content="مثال 1: سيرفر محلي (SQLEXPRESS)" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" Padding="8,4" FontSize="11" Margin="0,0,8,4"/>
                                <Button Command="{Binding SetCloudDbSampleCommand}" Content="مثال 2: سيرفر سحابي (ASP.NET DB)" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="#b4b5b5" Padding="8,4" FontSize="11" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding TestConnectionCommand}" Content="اختبار الاتصال" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="White" Margin="0,0,8,0" Padding="16,8"/>
                    <Button Command="{Binding SaveCommand}" Content="حفظ الاتصال" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2C2C2C" Foreground="White" Margin="0,0,8,0" Padding="16,8"/>
                    <Button Command="{Binding CreateAndMigrateCommand}" Content="إنشاء قاعدة البيانات والترحيل" Background="#005321" Foreground="White" BorderThickness="0" Padding="16,8"/>
                </StackPanel>

                <Button Command="{Binding ContinueCommand}" Content="متابعة تشغيل التطبيق" Background="#d90429" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" Padding="24,8" FontWeight="Bold"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>

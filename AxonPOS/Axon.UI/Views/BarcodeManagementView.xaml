<UserControl x:Class="Axon.UI.Views.BarcodeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBgBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource AppFont}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Input Field Style -->
        <Style x:Key="BarcodeFilterInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardInnerBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#d90429"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form Field Label -->
        <Style x:Key="BarcodeFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardInnerBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Printable Barcode Label Sticker Template Style -->
        <Style x:Key="BarcodeStickerCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="-90" Opacity="0.2" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Top Form / Criteria Card -->
            <RowDefinition Height="Auto"/> <!-- 2. Report & Print Toolbar -->
            <RowDefinition Height="*"/>    <!-- 3. Preview Canvas Sheet -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. CRITERIA & FILTERS CARD ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header Title -->
                    <RowDefinition Height="Auto"/> <!-- First Row: Inputs -->
                    <RowDefinition Height="Auto"/> <!-- Second Row: Options & Execute Button -->
                </Grid.RowDefinitions>

                <!-- Card Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="BarcodeScan" Width="22" Height="22" Foreground="#d90429" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="طباعة وتصميم ملصقات الباركود" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="#1f2b0005" BorderBrush="#33d90429" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="14,0,0,0">
                            <TextBlock Text="باركود المنتجات والأسعار" FontSize="11" Foreground="#ffb3af" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Form Criteria (4 Columns Grid) -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <!-- 1. Barcode / Code Search -->
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="14"/>
                        <!-- 2. Category Picker -->
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="14"/>
                        <!-- 3. Product Picker -->
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="14"/>
                        <!-- 4. Label Count -->
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. بواسطة الباركود / الكود -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource BarcodeFieldLabel}" Text="بواسطة الباركود / الكود:"/>
                        <TextBox Text="{Binding SearchBarcodeOrCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BarcodeFilterInput}" materialDesign:HintAssist.Hint="امسح أو اكتب الكود..."/>
                    </StackPanel>

                    <!-- 2. بواسطة القسم / التصنيف -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource BarcodeFieldLabel}" Text="بواسطة القسم (التصنيف):"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                  Padding="10,6" Height="34"/>
                    </StackPanel>

                    <!-- 3. اسم الصنف / المنتج -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource BarcodeFieldLabel}" Text="اسم الصنف (المنتج):"/>
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                  Padding="10,6" Height="34"/>
                    </StackPanel>

                    <!-- 4. عدد الملصقات -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource BarcodeFieldLabel}" Text="عدد الملصقات:"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding DecreaseCountCommand}" Content="-" Style="{StaticResource ToolbarBtn}" Padding="0" Height="34"/>
                            <TextBox Grid.Column="1" Text="{Binding LabelsCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BarcodeFilterInput}" TextAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                            <Button Grid.Column="2" Command="{Binding IncreaseCountCommand}" Content="+" Style="{StaticResource ToolbarBtn}" Padding="0" Height="34"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Display Checkboxes & Execute Button -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Label Size Combo -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>    <!-- Checkboxes -->
                        <ColumnDefinition Width="Auto"/> <!-- Execute Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Label Size -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="مقاس الملصق:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding LabelSizes}"
                                  SelectedItem="{Binding LabelSize, Mode=TwoWay}"
                                  Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                  Padding="8,4" Height="32" Width="190" FontSize="11"/>
                    </StackPanel>

                    <!-- Options Checkboxes -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <CheckBox IsChecked="{Binding ShowStoreName, Mode=TwoWay}" Content="اسم المتجر" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,12,0"/>
                        <CheckBox IsChecked="{Binding ShowProductName, Mode=TwoWay}" Content="اسم المنتج" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,12,0"/>
                        <CheckBox IsChecked="{Binding ShowPrice, Mode=TwoWay}" Content="سعر البيع" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,12,0"/>
                        <CheckBox IsChecked="{Binding ShowBarcodeNumber, Mode=TwoWay}" Content="رقم الباركود" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,12,0"/>
                        <CheckBox IsChecked="{Binding ShowCategoryName, Mode=TwoWay}" Content="القسم" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <!-- Execute Button (تنفيذ التقرير) -->
                    <Button Grid.Column="3" Command="{Binding ExecuteGenerateCommand}" Background="#d90429" Foreground="White" BorderThickness="0" Padding="18,6" Height="36" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="تنفيذ وعرض الباركود" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 2. PRINT & NAVIGATION TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Navigation & Zoom -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Print & Refresh Actions -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls & Zoom (Like the reference photo) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Page Navigation -->
                    <Button Command="{Binding FirstPageCommand}" Style="{StaticResource ToolbarBtn}" Width="30" ToolTip="الصفحة الأولى" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding PrevPageCommand}" Style="{StaticResource ToolbarBtn}" Width="30" ToolTip="الصفحة السابقة" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                    </Button>
                    
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,4,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource ToolbarBtn}" Width="30" ToolTip="الصفحة التالية" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LastPageCommand}" Style="{StaticResource ToolbarBtn}" Width="30" ToolTip="الصفحة الأخيرة" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource CardBorderBrush}" Margin="0,0,14,0"/>

                    <!-- Zoom Controls -->
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource ToolbarBtn}" Width="30" ToolTip="تصغير" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="16" Height="16"/>
                    </Button>
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,4,0" Width="55" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
                    </Border>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource ToolbarBtn}" Width="30" ToolTip="تكبير" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding ResetZoomCommand}" Style="{StaticResource ToolbarBtn}" Content="100%" FontSize="10" Padding="6,2" Height="30" Margin="0,0,10,0"/>
                </StackPanel>

                <!-- Status text in center -->
                <TextBlock Grid.Column="1" Text="{Binding StatusInfo}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Right Print Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LoadInitialDataCommand}" Style="{StaticResource ToolbarBtn}" Width="32" ToolTip="تحديث البيانات" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                    
                    <!-- Print Button -->
                    <Button Command="{Binding PrintLabelsCommand}" CommandParameter="{Binding ElementName=PrintCanvasElement}" Background="#d90429" Foreground="White" BorderThickness="0" Padding="14,4" Height="32" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Printer" Margin="0,0,6,0" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="طباعة الملصقات" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 3. PRINT PREVIEW CANVAS ==================== -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <!-- Generated Labels Sheet -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="PrintCanvasElement" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                        </Grid.LayoutTransform>

                        <!-- White Sticker Sheet Surface -->
                        <Border Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="16" MinWidth="760" MinHeight="480" Effect="{DynamicResource Axon3DDialogShadow}">
                            <ItemsControl ItemsSource="{Binding GeneratedLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" MaxWidth="720"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Individual Barcode Sticker Label -->
                                        <Border Style="{StaticResource BarcodeStickerCard}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Store Name -->
                                                    <RowDefinition Height="Auto"/> <!-- Product Name -->
                                                    <RowDefinition Height="*"/>    <!-- Barcode Image -->
                                                    <RowDefinition Height="Auto"/> <!-- Code & Price -->
                                                </Grid.RowDefinitions>

                                                <!-- Store Name Header -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding StoreName}"
                                                           FontSize="9" FontWeight="Bold" Foreground="#333333"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{Binding ShowStoreName, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Product Name -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ProductName}"
                                                           FontSize="10" FontWeight="Bold" Foreground="Black"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" Margin="0,1,0,2"
                                                           Visibility="{Binding ShowProductName, Converter={StaticResource BoolToVis}}"/>

                                                <!-- High Quality Barcode Image -->
                                                <Image Grid.Row="2"
                                                       Source="{Binding BarcodeImage}"
                                                       Stretch="Uniform" MaxHeight="44"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Code & Price Footer -->
                                                <Grid Grid.Row="3" Margin="0,2,0,0">
                                                    <!-- Barcode Number text -->
                                                    <TextBlock Text="{Binding SkuOrBarcode}"
                                                               FontSize="9" FontWeight="SemiBold" Foreground="#444444"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowBarcodeNumber, Converter={StaticResource BoolToVis}}"/>
                                                    <!-- Price Text -->
                                                    <TextBlock Text="{Binding FormattedPrice}"
                                                               FontSize="10" FontWeight="Black" Foreground="#d90429"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Placeholder when no labels generated yet -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGenerated}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="BarcodeScan" Width="56" Height="56" Foreground="#2A2A2A" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="اختر معايير الباركود واضغط على 'تنفيذ وعرض الباركود' لمعاينة الملصقات" Foreground="#8E8E93" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

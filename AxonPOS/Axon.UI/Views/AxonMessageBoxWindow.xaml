<Window x:Class="Axon.UI.Views.AxonMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تنبيه النظام" Height="Auto" SizeToContent="Height" Width="440"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <!-- Solid High-End Axon 3D Dark Card -->
    <Border CornerRadius="16" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="-90" RenderingBias="Quality" ShadowDepth="4" Opacity="0.85" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content Body -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" Padding="18,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="HeaderIcon" Kind="Information" Width="22" Height="22" Foreground="#4AE176" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtTitle" Text="تنبيه النظام" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Click="BtnClose_Click" Foreground="#8E8E93">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Body -->
            <Border Grid.Row="1" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="IconBadge" Width="44" Height="44" CornerRadius="12" Background="#224AE176" Margin="0,0,16,0" VerticalAlignment="Top">
                        <materialDesign:PackIcon x:Name="BodyIcon" Kind="CheckCircle" Width="24" Height="24" Foreground="#4AE176" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1" x:Name="TxtMessage" Text="محتوى الرسالة..." FontSize="13" Foreground="#E5E7EB" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Actions Footer -->
            <Border Grid.Row="2" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="18,12">
                <StackPanel x:Name="PnlButtons" Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Dynamic Buttons Generated or Toggled in Code-Behind -->
                    <Button x:Name="BtnYes" Content="نعم، تأكيد" Click="BtnYes_Click" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="36" Padding="20,0" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnNo" Content="لا، إلغاء" Click="BtnNo_Click" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="36" Padding="20,0" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnOk" Content="موافق" Click="BtnOk_Click" Style="{StaticResource Axon3DPrimaryButtonStyle}" Height="36" Padding="24,0" Margin="0,0,8,0"/>
                    <Button x:Name="BtnCancel" Content="إلغاء" Click="BtnCancel_Click" Style="{StaticResource Axon3DSecondaryButtonStyle}" Height="36" Padding="20,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

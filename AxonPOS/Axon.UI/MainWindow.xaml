<Window x:Class="Axon.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:Axon.UI.ViewModels"
        xmlns:views="clr-namespace:Axon.UI.Views"
        Title="Axon POS Enterprise" Height="768" Width="1024"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#131313" Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Window.Resources>
        <!-- DataTemplates for Navigation -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PosTerminalViewModel}">
            <views:PosTerminalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProductManagementViewModel}">
            <views:ProductManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InventoryControlViewModel}">
            <views:InventoryControlView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ExpensesViewModel}">
            <views:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BarcodeManagementViewModel}">
            <views:BarcodeManagementView />
        </DataTemplate>

        <!-- Sidebar Button Style based on Axon 3D Design System -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource Axon3DSidebarButtonStyle}">
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AxonBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 3D Elevated Sidebar -->
        <Border Grid.Column="0" Background="#141415" BorderBrush="#222222" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar Header / Logo Area -->
                <Border Grid.Row="0" Margin="14,14,14,8" Background="#161616" BorderBrush="#D90429" BorderThickness="1" CornerRadius="12" Padding="14,10" Effect="{DynamicResource Axon3DCardShadow}">
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="AXON" FontSize="20" FontWeight="Black" Foreground="#D90429" VerticalAlignment="Center"/>
                        <TextBlock Text=" POS" FontSize="20" FontWeight="Black" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Links -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="4,4,4,4">
                        <!-- Dashboard Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Dashboard">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Dashboard">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Dashboard}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- POS Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="PosTerminal">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPosVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="PosTerminal">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="PosTerminal">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource PosTerminal}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Inventory Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Inventory">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInventoryVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Inventory">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Inventory">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Inventory}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Products Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Products">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Products">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Tags" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Products">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Products}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Barcodes Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Barcodes">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBarcodeVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Barcodes">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Barcode" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Barcodes">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Barcodes}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Expenses Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Expenses">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpensesVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Expenses">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashMinus" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Expenses">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource ExternalExpenses}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Reports Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Reports">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReportsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Reports">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Reports">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Reports}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Settings">
                                            <Setter Property="Background" Value="#2A0E12"/>
                                            <Setter Property="BorderBrush" Value="#D90429"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Settings">
                                                    <Setter Property="Foreground" Value="#D90429"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Settings}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Logout Action -->
                <StackPanel Grid.Row="2" Margin="10,0,10,14">
                    <Separator Background="#222222" Margin="10,0,10,10"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding LogoutCommand}" 
                            Background="#1F1113" BorderBrush="#4E161C" BorderThickness="1" Padding="14,10" Height="44" Cursor="Hand" ToolTip="تسجيل الخروج من النظام">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,12,0" Foreground="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Logout}" Foreground="#EF4444" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#131313" BorderBrush="#353534" BorderThickness="0,0,0,1" MouseDown="TopBar_MouseDown">
                <Grid Margin="24,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Bar -->
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="{DynamicResource SearchPlaceholder}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Width="400" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Foreground="White" BorderBrush="#353534" />

                    <!-- User Profile & Notifications -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="#b4b5b5" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="BellOutline" Width="24" Height="24" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="#b4b5b5" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="ViewGridOutline" Width="24" Height="24" />
                        </Button>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#353534">
                            <TextBlock Text="AD" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#b4b5b5" Padding="12,0" Height="64" ToolTip="ØªØµØºÙŠØ±">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                        </Button>
                        <Button Click="MaximizeButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#b4b5b5" Padding="12,0" Height="64" ToolTip="ØªÙƒØ¨ÙŠØ±/Ø§Ø³ØªØ¹Ø§Ø¯Ø©">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16"/>
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#ffb4ab" Background="#2b0004" Padding="16,0" Height="64" ToolTip="Ø¥ØºÙ„Ø§Ù‚ Ø§Ù„ØªØ·Ø¨ÙŠÙ‚">
                            <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0" Background="#131313" />
        </Grid>
    </Grid>
</Window>


<Window x:Class="Axon.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:Axon.UI.ViewModels"
        xmlns:views="clr-namespace:Axon.UI.Views"
        Title="Axon POS Enterprise" Height="768" Width="1024"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#131313" Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Window.Resources>
        <!-- DataTemplates for Navigation -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PosTerminalViewModel}">
            <views:PosTerminalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProductManagementViewModel}">
            <views:ProductManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InventoryControlViewModel}">
            <views:InventoryControlView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ExpensesViewModel}">
            <views:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BarcodeManagementViewModel}">
            <views:BarcodeManagementView />
        </DataTemplate>

        <!-- Sidebar Button Style based on Axon 3D Design System -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource Axon3DSidebarButtonStyle}">
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 3D Elevated Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar Header / Logo Area (Exact Match to User Image) -->
                <Border Grid.Row="0" Margin="12,10,12,6" Padding="8,6" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,10,0">
                        <!-- Main Logo Line: AXON POS -->
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="AXON" FontSize="22" FontWeight="Black" Foreground="#D90429"/>
                            <TextBlock Text=" POS" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- Subtitle Line: لوحة التحكم الإدارية -->
                        <TextBlock Text="لوحة التحكم الإدارية" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Links -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="4,4,4,4">
                        <!-- Dashboard Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Dashboard">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Dashboard">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Dashboard}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- POS Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="PosTerminal">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPosVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="PosTerminal">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="PosTerminal">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource PosTerminal}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Inventory Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Inventory">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInventoryVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Inventory">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Inventory">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Inventory}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Products Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Products">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Products">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Tags" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Products">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Products}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Barcodes Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Barcodes">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBarcodeVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Barcodes">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Barcode" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Barcodes">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Barcodes}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Expenses Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Expenses">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpensesVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Expenses">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashMinus" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Expenses">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource ExternalExpenses}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Reports Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Reports">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReportsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Reports">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Reports">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Reports}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings Link -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextPrimaryBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveViewName}" Value="Settings">
                                            <Setter Property="Background" Value="#D90429"/>
                                            <Setter Property="BorderBrush" Value="#B90323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveViewName}" Value="Settings">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{DynamicResource Settings}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Logout Action -->
                <StackPanel Grid.Row="2" Margin="10,0,10,14">
                    <Separator Background="{DynamicResource SidebarBorderBrush}" Margin="10,0,10,10"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding LogoutCommand}" 
                            Background="{DynamicResource SidebarLogoutBgBrush}" BorderBrush="{DynamicResource SidebarLogoutBorderBrush}" BorderThickness="1" Padding="14,10" Height="44" Cursor="Hand" ToolTip="تسجيل الخروج من النظام">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,12,0" Foreground="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Logout}" Foreground="#EF4444" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" MouseDown="TopBar_MouseDown">
                <Grid Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Bar -->
                    <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="380" Height="38" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="19" Padding="12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="بحث سريع في فواتير والمنتجات..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,2"/>
                        </Grid>
                    </Border>

                    <!-- Control Action Center (Theme, Admin Profile & Window Controls) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- Theme Toggle Button -->
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Button Click="ThemeToggleButton_Click" Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Foreground="#F59E0B" ToolTip="التبديل بين الوضع الفاتح والداكن (Light/Dark Theme)">
                                <materialDesign:PackIcon Kind="WeatherSunny" Width="20" Height="20" />
                            </Button>
                        </Border>

                        <!-- User Profile Badge Card (Clickable -> Admin Settings) -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,14,0"
                                VerticalAlignment="Center" Height="38" Cursor="Hand"
                                ToolTip="الانتقال إلى إعدادات المسؤول (Admin Settings)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource CardInnerBgBrush}" 
                                            BorderBrush="{DynamicResource CardBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="19" 
                                            Padding="6,4,14,4" 
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#D90429" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="المسؤول" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="المدير العام" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Separator Line -->
                        <Border Width="1" Height="22" Background="{DynamicResource CardBorderBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                        <!-- Window Controls Group (Minimize, Maximize, Close) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <!-- Minimize Button -->
                            <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Margin="0,0,4,0" Foreground="{DynamicResource TopControlIconBrush}" ToolTip="تصغير التطبيق">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                            </Button>

                            <!-- Maximize / Restore Button -->
                            <Button Click="MaximizeButton_Click" Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Margin="0,0,6,0" Foreground="{DynamicResource TopControlIconBrush}" ToolTip="تكبير / استعادة الحجم">
                                <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16"/>
                            </Button>

                            <!-- Close Button (Modern Pill) -->
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource TopCloseBtnBgBrush}" BorderBrush="{DynamicResource TopCloseBtnBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Foreground="{DynamicResource TopCloseBtnTextBrush}" ToolTip="إغلاق التطبيق">
                                    <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                                </Button>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0" Background="{DynamicResource AppBgBrush}" />
        </Grid>
    </Grid>
</Window>


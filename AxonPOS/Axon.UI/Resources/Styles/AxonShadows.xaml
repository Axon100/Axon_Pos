<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 3D Subtle Elevation DropShadows -->
    <DropShadowEffect x:Key="Axon3DCardShadow" 
                      BlurRadius="16" 
                      ShadowDepth="4" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.45" />

    <DropShadowEffect x:Key="Axon3DCardHoverShadow" 
                      BlurRadius="24" 
                      ShadowDepth="8" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.65" />

    <DropShadowEffect x:Key="Axon3DPressedShadow" 
                      BlurRadius="8" 
                      ShadowDepth="2" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.30" />

    <DropShadowEffect x:Key="AxonRedGlowEffect" 
                      BlurRadius="14" 
                      ShadowDepth="0" 
                      Color="#D90429" 
                      Opacity="0.40" />

    <DropShadowEffect x:Key="AxonRedGlowHoverEffect" 
                      BlurRadius="20" 
                      ShadowDepth="0" 
                      Color="#D90429" 
                      Opacity="0.60" />

    <DropShadowEffect x:Key="Axon3DDialogShadow" 
                      BlurRadius="32" 
                      ShadowDepth="12" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.75" />
</ResourceDictionary>

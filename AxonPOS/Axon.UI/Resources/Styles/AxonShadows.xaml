<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 3D Elevation DropShadows (Black Shadow Removed / Opacity 0%) -->
    <DropShadowEffect x:Key="Axon3DCardShadow" 
                      BlurRadius="0" 
                      ShadowDepth="0" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0" />

    <DropShadowEffect x:Key="Axon3DCardHoverShadow" 
                      BlurRadius="0" 
                      ShadowDepth="0" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0" />

    <DropShadowEffect x:Key="Axon3DPressedShadow" 
                      BlurRadius="0" 
                      ShadowDepth="0" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0" />

    <DropShadowEffect x:Key="AxonRedGlowEffect" 
                      BlurRadius="14" 
                      ShadowDepth="0" 
                      Color="#D90429" 
                      Opacity="0.40" />

    <DropShadowEffect x:Key="AxonRedGlowHoverEffect" 
                      BlurRadius="18" 
                      ShadowDepth="0" 
                      Color="#D90429" 
                      Opacity="0.50" />

    <DropShadowEffect x:Key="Axon3DDialogShadow" 
                      BlurRadius="0" 
                      ShadowDepth="0" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0" />
</ResourceDictionary>
